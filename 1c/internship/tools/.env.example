# =============================================================================
# Учебный стенд RIH — шаблон переменных окружения.
# Скопируйте в .env и заполните своими значениями. Файл .env в Git НЕ попадает.
# Задания: task_134 (секреты), task_261 (.env и окружение), task_264 (онбординг).
# =============================================================================

# --- Общие --------------------------------------------------------------------
COMPOSE_PROJECT_NAME=rih
STAND=dev                       # dev | test | integration
TZ=Europe/Minsk
LOG_LEVEL=INFO

# --- Точка входа (nginx) ------------------------------------------------------
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
NGINX_RATE_LIMIT_RPS=20
TLS_CERT_FILE=./nginx/certs/mock.crt
TLS_KEY_FILE=./nginx/certs/mock.key

# --- PostgreSQL (очереди 1С, витрины, pgvector) -------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rih
POSTGRES_USER=rih
POSTGRES_PASSWORD=CHANGE_ME_local_only
PGVECTOR_ENABLED=true

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=rih
RABBITMQ_DEFAULT_PASS=CHANGE_ME_local_only
AMQP_URL=amqp://rih:CHANGE_ME_local_only@rabbitmq:5672/

# --- 1С (публичный HTTP-сервис, вне контейнера) -------------------------------
RIH_IB_URL=http://host.docker.internal:8009/rih_dev
RIH_HTTP_BASE=http://host.docker.internal:8009/hs/rih/v1
RIH_USER=Интеграция
RIH_PASSWORD=CHANGE_ME_local_only

# --- Mock-сервисы -------------------------------------------------------------
MOCK_SHOP_API_KEY=mock-shop-key
MOCK_LOYALTY_API_KEY=mock-loyalty-key
MOCK_TK_API_KEY=mock-tk-key
MOCK_TK_RATE_LIMIT=10
MOCK_BANK_LOGIN=bank_user
MOCK_BANK_PASSWORD=CHANGE_ME_local_only

# --- AI-сервис (task_231, task_250) -------------------------------------------
AI_SERVICE_URL=http://ai_service:8010
AI_SERVICE_API_KEY=CHANGE_ME_local_only
EMBEDDING_PROVIDER=mock          # mock | openai
LLM_PROVIDER=mock                # mock | openai
OPENAI_API_KEY=                  # заполняется только при реальном провайдере
SEARCH_MIN_SCORE=0.35
KNOWLEDGE_BASE_DIR=../docs/knowledge_base

# --- Наблюдаемость (task_271–276) ---------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_local_only
METRICS_EXPORTER_PORT=8025

# --- BI (task_126, task_205–210) ----------------------------------------------
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=CHANGE_ME_local_only

# --- MS SQL (task_181–198) ----------------------------------------------------
# Реальный сервер обычно вне compose; здесь только параметры подключения.
MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_SA_PASSWORD=CHANGE_ME_local_only
