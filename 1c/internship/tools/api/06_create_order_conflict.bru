meta {
  name: same order, other key -> 409
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}

headers {
  X-Api-Key: {{apiKey}}
  Idempotency-Key: demo-key-2
}

body:json {
  {
    "external_id": "demo-order-1",
    "lines": [
      {"sku": "SKU-00001", "quantity": 2, "price": 10.50}
    ]
  }
}

assert {
  res.status: eq 409
}
