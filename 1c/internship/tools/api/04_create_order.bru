meta {
  name: create order (idempotent)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}

headers {
  X-Api-Key: {{apiKey}}
  Idempotency-Key: demo-key-1
}

body:json {
  {
    "external_id": "demo-order-1",
    "lines": [
      {"sku": "SKU-00001", "quantity": 2, "price": 10.50}
    ]
  }
}

assert {
  res.status: eq 201
  res.body.total: eq 21
}
