# Скопируйте в .env и заполните. Файл .env в Git НЕ попадает (см. .gitignore).
# task_134: управление секретами. task_240: лимиты стоимости.

AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8010
AI_LOG_LEVEL=INFO

# Провайдер LLM и ключ (task_241)
LLM_PROVIDER=mock            # mock | openai-compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0

# Эмбеддинги (task_235, task_240)
EMBEDDING_PROVIDER=mock      # mock | http
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=384

# Векторный индекс (task_237)
VECTOR_BACKEND=memory        # memory | faiss | pgvector
PG_DSN=postgresql://rih:rih@localhost:5432/rih_ai
VECTOR_METRIC=cosine

# Поиск (task_238, task_239, task_245)
SEARCH_TOP_K=5
SEARCH_MIN_SCORE=0.35
SEARCH_HYBRID_ENABLED=false
RERANK_ENABLED=false

# Корпус знаний (task_236)
KNOWLEDGE_BASE_DIR=../../docs/knowledge_base
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Лимиты и бюджет (task_240, task_249)
RATE_LIMIT_PER_HOUR=200
MONTHLY_BUDGET_LIMIT_USD=20

# Наблюдаемость (task_234, task_250)
CORRELATION_HEADER=X-Correlation-Id
