# Копировать в .env и заполнить под свой стенд.
# .env не попадает в Git — там только локальные значения.

AMQP_URL=amqp://guest:guest@localhost:5672/
QUEUE_NAME=rih.orders.in
DLQ_NAME=rih.orders.in.dlq

# HTTP-сервис 1С, который обрабатывает входящие сообщения очереди
RIH_HTTP_URL=http://localhost:8009/hs/rih/v1/queue/incoming

MAX_RETRIES=3
PREFETCH=10
REQUEST_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO
