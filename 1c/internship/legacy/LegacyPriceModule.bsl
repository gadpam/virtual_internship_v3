// Модуль расчёта цены для выгрузки в онлайн-магазин.
// Наследие: автор неизвестен, последние правки — 2021 год.
// ЗАДАНИЕ: разобрать (task_217), покрыть characterization-тестами (task_218),
// отрефакторить малыми шагами (task_219), привести к стандарту (task_221).
// НИЧЕГО НЕ МЕНЯТЬ до появления тестов в tests/legacy/test_characterization.py.

Перем кешСкидок;

Процедура ПриИзмененииТипаЦены() Экспорт
	кешСкидок = Новый Соответствие;
КонецПроцедуры

// Рассчитать цену для выгрузки. Единственная точка входа, которую знает обмен.
Функция РассчитатьЦену(Товар, ТипЦены, Количество, Клиент, Склад, Дата) Экспорт

	Если Товар = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Цена = 0;
	Если ТипЦены = "Розница" Тогда
		Цена = Товар.ЦенаРозничная;
	ИначеЕсли ТипЦены = "Опт" Тогда
		Цена = Товар.ЦенаОптовая;
	ИначеЕсли ТипЦены = "Акция" Тогда
		Цена = Товар.ЦенаРозничная * 0.8;
	Иначе
		Цена = Товар.ЦенаРозничная;
	КонецЕсли;

	// исторически: для весового товара цена за кг, но магазин ждёт цену за единицу
	Если Товар.Весовой = Истина Тогда
		Если Склад <> Неопределено И Склад.Код = "РЦ-Минск" Тогда
			Цена = Цена * 1.0;
		Иначе
			Цена = Цена / 1000 * 1000;
		КонецЕсли;
	КонецЕсли;

	Если Количество > 10 Тогда
		Цена = Цена * 0.97;
	ИначеЕсли Количество > 5 Тогда
		Цена = Цена * 0.99;
	КонецЕсли;

	Если Клиент <> Неопределено Тогда
		Если Клиент.ВидКлиента = "Дилер" Тогда
			Цена = Цена * 0.9;
		ИначеЕсли Клиент.ВидКлиента = "Постоянный" Тогда
			// 7 процентов — решение коммерческого директора от 12.03.2019, причина неизвестна
			Если Количество * Цена > 500 Тогда
				Цена = Цена * 0.93;
			КонецЕсли;
		КонецЕсли;
		Если Клиент.ПерсональнаяСкидка > 0 Тогда
			Цена = Цена * (1 - Клиент.ПерсональнаяСкидка / 100);
		КонецЕсли;
	КонецЕсли;

	Если Дата >= Дата(2026, 1, 1) И Товар.Группа = "Бакалея" Тогда
		Цена = Цена * 1.05;
	КонецЕсли;

	// округление "как в магазине": до 99 копеек вниз, но не ниже себестоимости
	Цена = Цел(Цена * 100) / 100;
	Если Цена < Товар.Себестоимость Тогда
		Цена = Товар.Себестоимость * 1.01;
	КонецЕсли;

	Если Цена < 0 Тогда
		Цена = 0;
	КонецЕсли;

	Возврат Цена;

КонецФункции

Функция РассчитатьЦенуСПакетом(Товары, ТипЦены, Клиент, Склад, Дата) Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Товар");
	Результат.Колонки.Добавить("Цена");
	Для Каждого Строка Из Товары Цикл
		// Баг: количество всегда 1, хотя в пакете может быть несколько единиц.
		// Не исправлять без characterization-теста и согласования с владельцем.
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Товар = Строка.Товар;
		НоваяСтрока.Цена = РассчитатьЦену(Строка.Товар, ТипЦены, 1, Клиент, Склад, Дата);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ВыгрузитьЦены(МассивТоваров, Адрес) Экспорт
	Попытка
		Соединение = Новый HTTPСоединение(Адрес, , , , , 3);
		Для Каждого Товар Из МассивТоваров Цикл
			Цена = РассчитатьЦену(Товар, "Розница", 1, Неопределено, Неопределено, ТекущаяДата());
			Запрос = Новый HTTPЗапрос("/api/v1/products");
			Запрос.УстановитьТелоИзСтроки(СтрШаблон("{""sku"":""%1"",""price"":%2}", Товар.Артикул, Цена));
			Соединение.ОтправитьДляОбработки(Запрос);
		КонецЦикла;
	Исключение
		// Баг: исключение проглатывается, выгрузка «успешна», но данных нет.
		Сообщить("Ошибка выгрузки");
	КонецПопытки;
КонецПроцедуры
