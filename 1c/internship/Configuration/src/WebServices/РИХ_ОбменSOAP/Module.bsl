// РИХ_ОбменSOAP (task_85): SOAP-операции для партнёров без REST.
// Ошибка операции возвращается SOAP Fault через ВызватьИсключение
// с кодом RIH-* — платформа сформирует Fault, клиент получит причину,
// а не голый транспортный сбой.

#Область Операции

// Возвращает остатки склада на дату XDTO-объектом.
//
// Параметры:
//   Склад - Строка - наименование склада партнёра;
//   Дата  - Дата - момент среза остатков.
//
// Возвращаемое значение:
//   ОбъектXDTO - ОстаткиОтвета из пакета РИХ_Обмен_1.
//
Функция ПолучитьОстатки(Склад, Дата) Экспорт

	СкладСсылка = Справочники.Склады.НайтиПоНаименованию(Склад);
	Если СкладСсылка.Пустая() Тогда
		// Fault, а не пустой ответ: партнёр обязан узнать, что склада нет
		ВызватьИсключение "RIH-404: склад не найден: " + Склад;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Остатки.Номенклатура.Артикул КАК Артикул,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата, Склад = &Склад) КАК Остатки";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Склад", СкладСсылка);
	Выборка = Запрос.Выполнить().Выбрать();

	Пакет = ФабрикаXDTO.Пакеты.Получить("http://rih.example/xdto/1");
	Ответ = ФабрикаXDTO.Создать(Пакет.Получить("Продукт"));
	Пока Выборка.Следующий() Цикл
		СтрокаОтвета = ФабрикаXDTO.Создать(Пакет.Получить("Продукт"));
		СтрокаОтвета.Артикул = Выборка.Артикул;
		СтрокаОтвета.Цена = Выборка.Количество;
		Ответ.Добавить(СтрокаОтвета);
	КонецЦикла;

	Возврат Ответ;

КонецФункции

#КонецОбласти
