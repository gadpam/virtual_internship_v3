// Модуль объекта документа «Чек ККМ» (task_117).
// Чек уже пробит фискально на кассе: проведение не вправе «не состояться»
// из-за контроля остатков — продажа была, деньги взяты. Поэтому расход
// пишется без запрета ухода в минус, а расхождение количества и кодов
// ловит контроль (task_116) и сверка дня, а не отказ проведения.

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	// Итог чека — серверная сумма строк, кассе в этом месте не верят:
	// приёмочная сверка уже сравнила её с фискальным итогом (РИХ_Чеки),
	// здесь хранится пересчитанное значение.
	СуммаЧека = 0;
	Для Каждого СтрокаТоваров Из Товары Цикл
		СтрокаТоваров.Сумма = Окр(СтрокаТоваров.Количество * СтрокаТоваров.Цена, 2);
		СуммаЧека = СуммаЧека + СтрокаТоваров.Сумма;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Знак = ?(ВидЧека = "Возврат", -1, 1);

	Движения.Продажи.Записывать = Истина;
	Движения.ТоварыНаСкладах.Записывать = Истина;
	Для Каждого СтрокаТоваров Из Товары Цикл
		ДвижениеПродаж = Движения.Продажи.Добавить();
		ДвижениеПродаж.Период = Дата;
		ДвижениеПродаж.Магазин = Магазин;
		ДвижениеПродаж.Номенклатура = СтрокаТоваров.Номенклатура;
		ДвижениеПродаж.Количество = Знак * СтрокаТоваров.Количество;
		ДвижениеПродаж.Сумма = Знак * СтрокаТоваров.Сумма;

		ДвижениеСклада = Движения.ТоварыНаСкладах.Добавить();
		ДвижениеСклада.Период = Дата;
		ДвижениеСклада.ВидДвижения = ?(Знак > 0,
			ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход);
		ДвижениеСклада.Склад = Магазин;
		ДвижениеСклада.Номенклатура = СтрокаТоваров.Номенклатура;
		ДвижениеСклада.Количество = СтрокаТоваров.Количество;
	КонецЦикла;

КонецПроцедуры
