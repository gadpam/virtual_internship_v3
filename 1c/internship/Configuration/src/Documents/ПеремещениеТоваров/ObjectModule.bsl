// Модуль объекта документа «Перемещение товаров» (task_22).
// Два движения на строку — расход с отправителя и приход на получателя —
// пишутся в одной транзакции проведения (ADR-2 из task_19).

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Для Каждого СтрокаТоваров Из Товары Цикл
		Коэффициент = ?(ЗначениеЗаполнено(СтрокаТоваров.Упаковка),
			СтрокаТоваров.Упаковка.Коэффициент, 1);
		СтрокаТоваров.КоличествоБазовое = СтрокаТоваров.Количество * Коэффициент;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Товары.Количество() = 0 Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			"Не заполнена табличная часть «Товары»: перемещать нечего",
			ЭтотОбъект, "Товары");
	КонецЕсли;

	Если СкладОтправитель = СкладПолучатель Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			"Склад-отправитель совпадает со складом-получателем",
			ЭтотОбъект, "СкладПолучатель");
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.ТоварыНаСкладах.Записывать = Истина;

	Для Каждого СтрокаТоваров Из Товары Цикл
		Если СтрокаТоваров.Номенклатура.ЭтоУслуга Тогда
			Продолжить;
		КонецЕсли;
		Расход = Движения.ТоварыНаСкладах.Добавить();
		Расход.ВидДвижения = ВидДвиженияНакопления.Расход;
		Расход.Период = Дата;
		Расход.Склад = СкладОтправитель;
		Расход.Номенклатура = СтрокаТоваров.Номенклатура;
		Расход.Количество = СтрокаТоваров.КоличествоБазовое;

		Приход = Движения.ТоварыНаСкладах.Добавить();
		Приход.ВидДвижения = ВидДвиженияНакопления.Приход;
		Приход.Период = Дата;
		Приход.Склад = СкладПолучатель;
		Приход.Номенклатура = СтрокаТоваров.Номенклатура;
		Приход.Количество = СтрокаТоваров.КоличествоБазовое;
	КонецЦикла;

КонецПроцедуры
