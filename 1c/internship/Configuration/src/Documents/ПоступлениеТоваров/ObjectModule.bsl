// Модуль объекта документа «Поступление товаров» (task_21, пересчёт — task_24).
// Правило клиент-серверной границы: сумма строки на клиенте считается ради
// отзывчивости формы, но истина — сервер: ПередЗаписью пересчитывает суммы,
// проведению клиентские числа не доверяем.

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	// Серверный пересчёт суммы и базового количества каждой строки.
	Для Каждого СтрокаТоваров Из Товары Цикл
		СтрокаТоваров.Сумма = Окр(СтрокаТоваров.Количество * СтрокаТоваров.Цена, 2);
		Коэффициент = ?(ЗначениеЗаполнено(СтрокаТоваров.Упаковка),
			СтрокаТоваров.Упаковка.Коэффициент, 1);
		СтрокаТоваров.КоличествоБазовое = СтрокаТоваров.Количество * Коэффициент;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Сводка ошибок: все нарушения одним списком, сообщения — на поля.
	Для Каждого ОшибкаВалидации Из РИХ_ВалидацииОшибки() Цикл
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			ОшибкаВалидации.Текст, ЭтотОбъект, ОшибкаВалидации.Поле);
	КонецЦикла;

	Если Товары.Количество() = 0 Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			"Не заполнена табличная часть «Товары»: проводить нечего",
			ЭтотОбъект, "Товары");
	КонецЕсли;

КонецПроцедуры

// Тонкая обёртка: модуль валидации не знает про ЭтотОбъект.
Функция РИХ_ВалидацииОшибки()

	ДокументДанные = Новый Структура("Склад,Дата,Товары", Склад, Дата, Товары);
	Возврат РИХ_Валидация.ОшибкиПоступления(ДокументДанные);

КонецФункции

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.ТоварыНаСкладах.Записывать = Истина;

	Для Каждого СтрокаТоваров Из Товары Цикл
		Если СтрокаТоваров.Номенклатура.ЭтоУслуга Тогда
			Продолжить; // у услуг нет остатков (task_20)
		КонецЕсли;
		Движение = Движения.ТоварыНаСкладах.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Склад = Склад;
		Движение.Номенклатура = СтрокаТоваров.Номенклатура;
		// Движения всегда в базовых единицах (task_24).
		Движение.Количество = СтрокаТоваров.КоличествоБазовое;
	КонецЦикла;

КонецПроцедуры
