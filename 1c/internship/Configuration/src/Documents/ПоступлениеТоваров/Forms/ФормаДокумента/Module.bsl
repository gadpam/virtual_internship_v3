// Модуль формы документа «Поступление товаров» (task_21, UX — task_39).
// Клиентский пересчёт — только UX: пользователь сразу видит сумму.
// Истину при записи пересчитает сервер (ПередЗаписью модуля объекта).

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// UX (task_39): склад нового документа подставляется по закреплению
	// пользователя (РС СкладыПользователей, task_9): у кладовщика склад
	// один, и выбирать его руками в каждом документе — лишние действия.
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) И НЕ ЗначениеЗаполнено(Объект.Склад) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	СкладыПользователей.Склад КАК Склад
			|ИЗ
			|	РегистрСведений.СкладыПользователей КАК СкладыПользователей
			|ГДЕ
			|	СкладыПользователей.Пользователь = &Пользователь";
		Запрос.УстановитьПараметр("Пользователь", ИмяПользователя());
		Выборка = Запрос.Выполнить().Выбрать();
		// Подставляем только при ровно одном закреплении: ПЕРВЫЕ 1 без
		// сортировки при нескольких складах молча угадывала склад (task_51).
		Если Выборка.Количество() = 1 Тогда
			Выборка.Следующий();
			Объект.Склад = Выборка.Склад;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Команда «Заполнить тестовыми данными» (task_37): обработчик на клиенте
// только вызывает серверную процедуру — заполнение идёт на сервере
// (данные и запросы на клиенте не живут). Серверный вызов один на команду.

&НаКлиенте
Процедура ЗаполнитьТестовымиДанными(Команда)

	ЗаполнитьТестовымиДаннымиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТестовымиДаннымиНаСервере()

	Объект.Товары.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 5
		|	Номенклатура.Ссылка КАК Товар
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ЭтоУслуга
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура.Артикул";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТоваров = Объект.Товары.Добавить();
		СтрокаТоваров.Номенклатура = Выборка.Товар;
		СтрокаТоваров.Количество = 1;
		СтрокаТоваров.Цена = 100;
		СтрокаТоваров.Сумма = 100;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)

	СтрокаТоваров = Элементы.Товары.ТекущиеДанные;
	СтрокаТоваров.Сумма = Окр(СтрокаТоваров.Количество * СтрокаТоваров.Цена, 2);

КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)

	ТоварыКоличествоПриИзменении(Элемент);

КонецПроцедуры
