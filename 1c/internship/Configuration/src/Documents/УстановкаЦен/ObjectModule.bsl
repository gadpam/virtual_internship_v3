// Модуль объекта документа «Установка цен» (task_23).
// Проведение пишет строки ТЧ в периодический РС ЦеныНоменклатуры:
// дата документа — начало действия цен, автор документа виден в истории.

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Цены.Количество() = 0 Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			"Не заполнена табличная часть «Цены»: устанавливать нечего",
			ЭтотОбъект, "Цены");
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.ЦеныНоменклатуры.Записывать = Истина;

	Для Каждого СтрокаЦен Из Цены Цикл
		Запись = Движения.ЦеныНоменклатуры.Добавить();
		Запись.Период = Дата;
		Запись.Номенклатура = СтрокаЦен.Номенклатура;
		Запись.Склад = СтрокаЦен.Склад;
		Запись.ТипЦены = СтрокаЦен.ТипЦены;
		Запись.Цена = СтрокаЦен.Цена;
	КонецЦикла;

КонецПроцедуры
