// РИХ_Метрики (task_114): отдача снимка метрик экспортёру Prometheus.
// GET /hs/rih-metrics/v1 — JSON формы, которую ждёт metrics_exporter.

#Область Обработчики

// Снимок метрик за последний час в формате экспортёра.
// task_138 (ревью безопасности, SEC-1): метрики — разведывательные
// данные (объёмы, ошибки, состояния контуров), поэтому маршрут
// защищён той же единой точкой, что и остальные. Экспортёр ходит
// с ключом из своего окружения; анонимного снимка больше нет.
Функция СнимокGET(Запрос)

	Если НЕ РИХ_Интеграции.КлючДопустим(Запрос) Тогда
		Возврат РИХ_HTTP1_Ответы.ОтветОбОшибке(401, "RIH-401",
			"Не указан или неверен X-Api-Key");
	КонецЕсли;

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(РИХ_МетрикиИнтеграций.СнимокМетрикJSON());

	Возврат Ответ;

КонецФункции

#КонецОбласти
