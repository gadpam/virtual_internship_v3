// РИХ_Кассы (task_117): транспорт приёма чеков.
// POST /hs/pos/receipts/batch — пакет чеков, ответ по каждому чеку.
// Транспорт отвечает за ключ, размер и упаковку тела; смысл чеков —
// РИХ_Чеки. Лимит проверяется до разбора JSON, а сжатие принимается
// только ZIP: платформа читает его штатно (ЧтениеZipФайла), gzip-поток
// не умеет — RIH-415, а не молча битый JSON в парсере.

#Область Обработчики

// Принимает пакет чеков plain JSON или ZIP с файлом receipts.json.
Функция ЧекиПакетPOST(Запрос) Экспорт

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если НЕ РИХ_Интеграции.КлючДопустим(Запрос) Тогда
		Возврат РИХ_HTTP1_Ответы.ОтветОбОшибке(401, "RIH-401",
			"Не указан или неверен X-Api-Key кассы");
	КонецЕсли;

	Попытка
		ТелоДвоичное = Запрос.ПолучитьТелоКакДвоичныеДанные();
		Если ТелоДвоичное.Размер() > ЛимитТелаБайт() Тогда
			РИХ_Интеграции.ЗаписатьВызов("pos", "POST /receipts/batch", "in", "",
				413, "RIH-413", Длительность(НачалоВызова),
				"тело " + Формат(ТелоДвоичное.Размер(), "ЧГ=0") + " байт");
			Возврат РИХ_HTTP1_Ответы.ОтветОбОшибке(413, "RIH-413",
				"Пакет больше лимита " + Формат(ЛимитТелаБайт(), "ЧГ=0")
				+ " байт: режьте пачку по сменам, а не по суткам");
		КонецЕсли;

		КодировкаПотока = НРег(Запрос.Заголовки.Получить("Content-Encoding"));
		Если КодировкаПотока = "gzip" Тогда
			Возврат РИХ_HTTP1_Ответы.ОтветОбОшибке(415, "RIH-415",
				"gzip платформой не распаковывается: присылайте ZIP или plain JSON");
		КонецЕсли;

		ТипТела = НРег(Запрос.Заголовки.Получить("Content-Type"));
		Если СтрНайти(ТипТела, "zip") > 0 Тогда
			ТекстJSON = РаспаковатьПакетЧеков(ТелоДвоичное);
		Иначе
			ТекстJSON = ПолучитьСтрокуИзДвоичныхДанных(ТелоДвоичное, КодировкаТекста.UTF8);
		КонецЕсли;

		Данные = РИХ_Форматы.JSONВСтруктуру(ТекстJSON);
		Итог = РИХ_Чеки.ПринятьПакетЧеков(Данные);
		РИХ_Интеграции.ЗаписатьВызов("pos", "POST /receipts/batch", "in", "",
			200, "", Длительность(НачалоВызова),
			"принято " + Формат(Итог.accepted, "ЧГ=0")
			+ ", дублей " + Формат(Итог.duplicates, "ЧГ=0")
			+ ", карантин " + Формат(Итог.quarantined, "ЧГ=0"));
		Возврат РИХ_HTTP1_Ответы.ОтветJSON(Итог, 200);
	Исключение
		Возврат РИХ_HTTP1_Ответы.ОтветПоИсключению(
			"pos", "POST /receipts/batch", ОписаниеОшибки());
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Служебные

// Лимит тела пакета: 10 МБ хватает на смену крупной кассы с запасом,
// а «пачка на 200 МБ» отсекается до парсера и очередей разбора.
Функция ЛимитТелаБайт()

	Возврат 10 * 1024 * 1024;

КонецФункции

// Длительность вызова в миллисекундах от его начала.
Функция Длительность(НачалоВызова)

	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;

КонецФункции

// Достаёт receipts.json из ZIP-пакета кассы штатными средствами.
Функция РаспаковатьПакетЧеков(ТелоДвоичное)

	ВременныйАрхив = ПолучитьИмяВременногоФайла("zip");
	ТелоДвоичное.Записать(ВременныйАрхив);
	Архив = Новый ЧтениеZipФайла(ВременныйАрхив);
	Попытка
		Для Каждого ЭлементАрхива Из Архив.Элементы Цикл
			Если НРег(ЭлементАрхива.Имя) = "receipts.json" Тогда
				КаталогРаспаковки = ПолучитьИмяВременногоФайла();
				Архив.Извлечь(ЭлементАрхива, КаталогРаспаковки);
				Чтение = Новый ЧтениеТекста(
					КаталогРаспаковки + "/receipts.json", КодировкаТекста.UTF8);
				ТекстJSON = Чтение.Прочитать();
				Чтение.Закрыть();
				Возврат ТекстJSON;
			КонецЕсли;
		КонецЦикла;
		ВызватьИсключение "RIH-422: в ZIP-пакете нет receipts.json";
	Исключение
		Архив.Закрыть();
		УдалитьФайлы(ВременныйАрхив);
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

#КонецОбласти
