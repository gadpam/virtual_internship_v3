// РИХ_ЭДО (task_90): приёмник документов оператора ЭДО (заглушка).
// Полный контур (проверка УКЭП, статусы ФНС, квитанции) — task_115;
// здесь фиксируем договор приёмника: XML принимается, дубль отсекается,
// каждый документ виден в журнале интеграций со своим ИдДокумента.

#Область Обработчики

// Приём документа: POST /hs/edo/documents.
// Тело — XML документа; заголовок X-Document-Id — ид оператора.
// Повтор того же ИдДокумента получает 200 duplicate, а не второй документ.
Функция ДокументыPOST(Запрос)

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ИдДокумента = Запрос.Заголовки.Получить("X-Document-Id");
	Тело = Запрос.ПолучитьТелоКакСтроку();

	Попытка
		Если НЕ РИХ_Интеграции.КлючДопустим(Запрос) Тогда
			РИХ_Интеграции.ЗаписатьВызов("edo", "DocumentIn", "in", ИдДокумента,
				401, "RIH-401", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова);
			Возврат РИХ_HTTP1_Ответы.ОтветОбОшибке(401, "RIH-401", "Недопустимый ключ оператора ЭДО");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ИдДокумента) Тогда
			Возврат РИХ_HTTP1_Ответы.ОтветОбОшибке(422, "RIH-422", "Нет заголовка X-Document-Id");
		КонецЕсли;
		Если ДокументУжеПринят(ИдДокумента) Тогда
			РИХ_Интеграции.ЗаписатьВызов("edo", "DocumentIn", "in", ИдДокумента,
				200, "", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова, "duplicate");
			Возврат РИХ_HTTP1_Ответы.ОтветJSON(200,
				"{""accepted"":true,""duplicate"":true}");
		КонецЕсли;

		СохранитьДокументЭДО(ИдДокумента, Тело);
		РИХ_Интеграции.ЗаписатьВызов("edo", "DocumentIn", "in", ИдДокумента,
			201, "", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова);
		Возврат РИХ_HTTP1_Ответы.ОтветJSON(201, "{""accepted"":true}");
	Исключение
		Возврат РИХ_HTTP1_Ответы.ОтветПоИсключению(ИнформацияОбОшибке());
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Приёмник

// Разбирает и принимает документ ЭДО (task_115): схема, контрагент,
// номенклатура, документ учёта. Любая проблема сопоставления —
// карантин с причиной, а не частичный документ и не тихий отказ.
Функция ПринятьДокументЭДО(ИдДокумента, ТелоXML) Экспорт

	Попытка
		СтруктураДокумента = РазобратьУПД(ТелоXML);
	Исключение
		ПоместитьВКарантин(ИдДокумента,
			"ошибка схемы: " + ОписаниеОшибки());
		Возврат "карантин: схема";
	КонецПопытки;

	Поставщик = Справочники.Контрагенты.НайтиПоРеквизиту(
		"ИНН", СтруктураДокумента.ИннПоставщика);
	Если Поставщик.Пустая() Тогда
		ПоместитьВКарантин(ИдДокумента,
			"неизвестный контрагент ИНН " + СтруктураДокумента.ИннПоставщика);
		Возврат "карантин: контрагент";
	КонецЕсли;

	Для Каждого СтрокаТовара Из СтруктураДокумента.Товары Цикл
		Если Справочники.Номенклатура.НайтиПоРеквизиту(
			"ШтрихКод", СтрокаТовара.КодТов).Пустая() Тогда
			ПоместитьВКарантин(ИдДокумента,
				"нет сопоставления товара " + СтрокаТовара.КодТов);
			Возврат "карантин: номенклатура";
		КонецЕсли;
	КонецЦикла;

	Возврат "принят";

КонецФункции

// Разбор учебного УПД: шапка, продавец/покупатель, строки, итоги.
// Несоответствие обязательной структуре — исключение схемы.
Функция РазобратьУПД(ТелоXML) Экспорт

	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТелоXML);
	Построитель = Новый ПостроительDOM;
	Дерево = Построитель.Прочитать(Чтение);
	Чтение.Закрыть();
	Если Дерево.КорневойЭлемент = Неопределено
		ИЛИ Дерево.КорневойЭлемент.ИмяУзла <> "Файл" Тогда
		ВызватьИсключение "RIH-422: корневой элемент не «Файл»";
	КонецЕсли;

	Документ = Новый Структура("Номер,Дата,ИннПоставщика,Товары",
		"", Дата(1, 1, 1), "", Новый Массив);
	СобратьПоляУПД(Дерево.КорневойЭлемент, Документ);
	Если НЕ ЗначениеЗаполнено(Документ.Номер)
		ИЛИ НЕ ЗначениеЗаполнено(Документ.ИннПоставщика)
		ИЛИ Документ.Товары.Количество() = 0 Тогда
		ВызватьИсключение "RIH-422: обязательные поля УПД не заполнены";
	КонецЕсли;

	Возврат Документ;

КонецФункции

// Рекурсивно собирает шапку и строки УПД из DOM-дерева.
Процедура СобратьПоляУПД(Узел, Документ)

	Для Каждого Дочерний Из Узел.ДочерниеУзлы Цикл
		Если Дочерний.ТипУзла <> ТипУзлаDOM.Элемент Тогда
			Продолжить;
		КонецЕсли;
		Если Дочерний.ИмяУзла = "СвСчФакт" Тогда
			Документ.Номер = Дочерний.ПолучитьАтрибут("НомерСчФ");
		ИначеЕсли Дочерний.ИмяУзла = "СвПрод" Тогда
			Документ.ИннПоставщика = ИннИзВеткиПродавца(Дочерний);
		ИначеЕсли Дочерний.ИмяУзла = "СведТов" Тогда
			Товар = Новый Структура("КодТов,Наименование,Количество,Цена",
				Дочерний.ПолучитьАтрибут("КодТов"),
				Дочерний.ПолучитьАтрибут("НаимТов"),
				Число(Дочерний.ПолучитьАтрибут("КолТов")),
				Число(Дочерний.ПолучитьАтрибут("ЦенаТов")));
			Документ.Товары.Добавить(Товар);
		КонецЕсли;
		СобратьПоляУПД(Дочерний, Документ);
	КонецЦикла;

КонецПроцедуры

// ИНН продавца из его ветви документа.
Функция ИннИзВеткиПродавца(ВеткаПродавца)

	Для Каждого Дочерний Из ВеткаПродавца.ДочерниеУзлы Цикл
		Если Дочерний.ТипУзла = ТипУзлаDOM.Элемент Тогда
			Если Дочерний.ИмяУзла = "СвЮЛУч" Тогда
				Возврат Дочерний.ПолучитьАтрибут("ИННЮЛ");
			КонецЕсли;
			Инн = ИннИзВеткиПродавца(Дочерний);
			Если ЗначениеЗаполнено(Инн) Тогда
				Возврат Инн;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Помещает документ в карантин с причиной для оператора.
Процедура ПоместитьВКарантин(ИдДокумента, Причина) Экспорт

	Запись = РегистрыСведений.КарантинЭДО.СоздатьМенеджерЗаписи();
	Запись.ИдДокумента = ИдДокумента;
	Запись.Причина = Причина;
	Запись.МоментПомещения = ТекущаяДатаСеанса();
	Запись.СтатусРазбора = "ждёт";
	Запись.Записать();

КонецПроцедуры

#КонецОбласти

#Область Служебные

// Документ оператора уже есть в журнале принятых: повторная доставка
// не должна рождать второй документ учёта.
Функция ДокументУжеПринят(ИдДокумента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Журнал.КлючИдемпотентности КАК Ключ
	|ИЗ РегистрСведений.ЖурналИнтеграций КАК Журнал
	|ГДЕ Журнал.Система = &Система И Журнал.КлючИдемпотентности = &Ключ
	|	И Журнал.СтатусОтвета = 201";
	Запрос.УстановитьПараметр("Система", "edo");
	Запрос.УстановитьПараметр("Ключ", ИдДокумента);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Сохраняет XML документа как есть (payload вне журнала, task_84):
// юридически значимый оригинал не переписывается «удобной» структурой.
// Путь каталога — параметр контура, а не константа в коде.
Процедура СохранитьДокументЭДО(ИдДокумента, ТелоXML)

	КаталогДокументов = Константы.РИХ_КаталогДокументовЭДО.Получить();
	Запись = Новый ЗаписьТекста(КаталогДокументов + ИдДокумента + ".xml",
		КодировкаТекста.UTF8);
	Запись.Записать(ТелоXML);
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти
