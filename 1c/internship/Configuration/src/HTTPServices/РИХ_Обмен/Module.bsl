// РИХ_Обмен — HTTP-сервис интеграций (task_79, 81, 82, 83).
// Каждый обработчик: аутентификация → валидация → работа → единый формат
// ответа. Исключение любого маршрута превращается РИХ_HTTPОтветы в
// {code, message, details, incidentId, timestamp} + журнал (task_82/84).

#Область Обработчики

// GET /api/v1/health — живость, версия конфигурации, время сервера.
Функция ПолучитьЗдоровье(Запрос) Экспорт

	Тело = Новый Структура;
	Тело.Вставить("status", "ok");
	Тело.Вставить("version", "1.0.0");
	Тело.Вставить("serverTime", РИХ_ОбщегоНазначения.СформироватьIso8601(ТекущаяДатаСеанса()));

	Возврат РИХ_HTTP1_Ответы.ОтветJSON(Тело, 200);

КонецФункции

// GET /api/v1/products?group=&changedAfter=&limit=&offset= — каталог
// с пагинацией: страница через ВЫБРАТЬ ПЕРВЫЕ/СМЕЩЕНИЕ не делается
// (стандарт §3), страница режется по выборке с сортировкой по коду.
Функция ПолучитьТовары(Запрос) Экспорт

	Если НЕ РИХ_Интеграции.КлючДопустим(Запрос) Тогда
		Возврат РИХ_HTTP1_Ответы.ОтветОбОшибке(401, "RIH-401", "Не указан или неверен X-Api-Key");
	КонецЕсли;

	Параметры = Запрос.ПараметрыЗапроса;
	Лимит = ЧислоИзПараметра(Параметры, "limit", 50);
	Смещение = ЧислоИзПараметра(Параметры, "offset", 0);
	Если Лимит < 1 ИЛИ Лимит > 500 Тогда
		Возврат РИХ_HTTP1_Ответы.ОтветОбОшибке(422, "RIH-422", "limit вне диапазона 1..500");
	КонецЕсли;

	ЗапросТоваров = Новый Запрос;
	ЗапросТоваров.Текст =
	"ВЫБРАТЬ Товары.Код КАК Код, Товары.Наименование КАК Наименование,
	|	Товары.Артикул КАК Артикул
	|ИЗ Справочник.Номенклатура КАК Товары
	|ГДЕ НЕ Товары.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО Товары.Код";
	Выборка = ЗапросТоваров.Выполнить().Выбрать();

	Товары = Новый Массив;
	Пропущено = 0;
	Пока Выборка.Следующий() Цикл
		Если Пропущено < Смещение Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Если Товары.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Товар = Новый Структура("sku,name,article",
			Выборка.Код, Выборка.Наименование, Выборка.Артикул);
		Товары.Добавить(Товар);
	КонецЦикла;

	Тело = Новый Структура("total,limit,offset,items",
		Выборка.Количество(), Лимит, Смещение, Товары);

	Возврат РИХ_HTTP1_Ответы.ОтветJSON(Тело, 200);

КонецФункции

// POST /api/v1/orders — приём заказа магазина (task_83): валидация,
// идемпотентность по внешнему идентификатору, 201 при создании.
Функция ПринятьЗаказ(Запрос) Экспорт

	Если НЕ РИХ_Интеграции.КлючДопустим(Запрос) Тогда
		Возврат РИХ_HTTP1_Ответы.ОтветОбОшибке(401, "RIH-401", "Не указан или неверен X-Api-Key");
	КонецЕсли;

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Данные = РИХ_Форматы.JSONВСтруктуру(Запрос.ПолучитьТелоКакСтроку());
		Результат = РИХ_Интеграции.ПринятьЗаказМагазина(Данные);
		РИХ_Интеграции.ЗаписатьВызов("shop", "POST /orders", "in",
			Данные.external_id, Результат.КодОтвета, "",
			ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова);
		Возврат РИХ_HTTP1_Ответы.ОтветJSON(Результат.Тело, Результат.КодОтвета);
	Исключение
		Возврат РИХ_HTTP1_Ответы.ОтветПоИсключению("shop", "POST /orders", ОписаниеОшибки());
	КонецПопытки;

КонецФункции

// GET /api/v1/orders?status= — список принятых заказов.
Функция ПолучитьЗаказы(Запрос) Экспорт

	Если НЕ РИХ_Интеграции.КлючДопустим(Запрос) Тогда
		Возврат РИХ_HTTP1_Ответы.ОтветОбОшибке(401, "RIH-401", "Не указан или неверен X-Api-Key");
	КонецЕсли;

	Возврат РИХ_HTTP1_Ответы.ОтветJSON(
		РИХ_Интеграции.СписокЗаказов(Запрос.ПараметрыЗапроса), 200);

КонецФункции

// POST /api/v1/orders/batch — пачка заказов с частичным успехом:
// ответ содержит статус по каждому элементу (task_83).
Функция ПринятьПакетЗаказов(Запрос) Экспорт

	Если НЕ РИХ_Интеграции.КлючДопустим(Запрос) Тогда
		Возврат РИХ_HTTP1_Ответы.ОтветОбОшибке(401, "RIH-401", "Не указан или неверен X-Api-Key");
	КонецЕсли;

	Попытка
		Данные = РИХ_Форматы.JSONВСтруктуру(Запрос.ПолучитьТелоКакСтроку());
		Возврат РИХ_HTTP1_Ответы.ОтветJSON(
			РИХ_Интеграции.ПринятьПакетЗаказов(Данные), 200);
	Исключение
		Возврат РИХ_HTTP1_Ответы.ОтветПоИсключению("shop", "POST /orders/batch", ОписаниеОшибки());
	КонецПопытки;

КонецФункции

// PUT /api/v1/orders/{externalId}?status= — смена статуса заказа.
Функция ИзменитьСтатусЗаказа(Запрос) Экспорт

	Если НЕ РИХ_Интеграции.КлючДопустим(Запрос) Тогда
		Возврат РИХ_HTTP1_Ответы.ОтветОбОшибке(401, "RIH-401", "Не указан или неверен X-Api-Key");
	КонецЕсли;

	ВнешнийИД = Запрос.ПараметрыURL["externalId"];
	Статус = Запрос.ПараметрыЗапроса.Получить("status");
	Результат = РИХ_Интеграции.СменитьСтатусЗаказа(ВнешнийИД, Статус);
	Если Результат = Неопределено Тогда
		Возврат РИХ_HTTP1_Ответы.ОтветОбОшибке(404, "RIH-404", "Заказ не найден: " + ВнешнийИД);
	КонецЕсли;

	Возврат РИХ_HTTP1_Ответы.ОтветJSON(Результат, 200);

КонецФункции

// DELETE /api/v1/orders/{externalId} — отмена заказа (не удаление:
// документ остаётся со статусом «Отменён» ради аудита).
Функция ОтменитьЗаказ(Запрос) Экспорт

	Если НЕ РИХ_Интеграции.КлючДопустим(Запрос) Тогда
		Возврат РИХ_HTTP1_Ответы.ОтветОбОшибке(401, "RIH-401", "Не указан или неверен X-Api-Key");
	КонецЕсли;

	ВнешнийИД = Запрос.ПараметрыURL["externalId"];
	Результат = РИХ_Интеграции.СменитьСтатусЗаказа(ВнешнийИД, "cancelled");
	Если Результат = Неопределено Тогда
		Возврат РИХ_HTTP1_Ответы.ОтветОбОшибке(404, "RIH-404", "Заказ не найден: " + ВнешнийИД);
	КонецЕсли;

	Возврат РИХ_HTTP1_Ответы.ОтветJSON(Результат, 200);

КонецФункции

#КонецОбласти

#Область Служебные

// Число из параметра запроса с значением по умолчанию и защитой от мусора.
Функция ЧислоИзПараметра(Параметры, Имя, ПоУмолчанию)

	Значение = Параметры.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;

КонецФункции

#КонецОбласти
