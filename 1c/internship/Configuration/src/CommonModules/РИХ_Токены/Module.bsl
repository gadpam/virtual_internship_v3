// РИХ_Токены (task_133): токены интеграционных клиентов вместо
// вечных ключей. Поток client_credentials: клиент предъявляет
// идентификатор и секрет — получает короткоживущий токен и ходит
// с ним в Authorization: Bearer. Хранятся только хеши (токена и
// секретов): утечка базы и логов не даёт готовых секретов.
// Проверка — единая точка сервиса: РИХ_Интеграции.КлючДопустим
// спрашивает этот модуль до проверки ключа, поэтому маршруты
// не проверяют токен каждый по-своему и не забываются.

#Область ПрограммныйИнтерфейс

// Срок жизни токена в секундах: окно кражи токена, а не «навсегда».
Функция СрокЖизниТокенаСекунд() Экспорт

	Возврат 3600;

КонецФункции

// Выдаёт токен клиенту по его секрету (client_credentials).
// Секрет принимается текущим либо предыдущим в окне grace ротации.
// Сам токен возвращается один раз и нигде не сохраняется открытым.
Функция ВыдатьТокен(Клиент, Секрет) Экспорт

	// task_136: выдача токена — цель перебора секрета. Частота
	// ограничена по клиенту: 30 попыток в минуту считается по
	// журналу (вызовы token уже пишутся туда каждой попыткой).
	Если ЧастотаВыдачиПревышена(Клиент) Тогда
		РИХ_Интеграции.ЗаписатьВызов(Клиент, "token", "in", "", 429, "RIH-429",
			0, "превышена частота выдачи токенов");
		ВызватьИсключение "RIH-429: слишком частые запросы токена";
	КонецЕсли;

	ЗаписьКлиента = ПрочитатьКлиента(Клиент);
	Если ЗаписьКлиента = Неопределено ИЛИ НЕ ЗаписьКлиента.Активен Тогда
		РИХ_Интеграции.ЗаписатьВызов(Клиент, "token", "in", "", 401, "RIH-401",
			0, "выдача токена: клиент неизвестен или отключён");
		ВызватьИсключение "RIH-401: клиент неизвестен или отключён";
	КонецЕсли;
	Хеш = РИХ_Интеграции.ХешКлюча(Секрет);
	СекретПодходит = Хеш = ЗаписьКлиента.ХешСекрета
		ИЛИ (ЗначениеЗаполнено(ЗаписьКлиента.ХешПредыдущегоСекрета)
			И Хеш = ЗаписьКлиента.ХешПредыдущегоСекрета
			И ТекущаяДатаСеанса() <= ЗаписьКлиента.ПредыдущийСекретДо);
	Если НЕ СекретПодходит Тогда
		РИХ_Интеграции.ЗаписатьВызов(Клиент, "token", "in", "", 401, "RIH-401",
			0, "выдача токена: неверный секрет");
		ВызватьИсключение "RIH-401: неверный секрет клиента";
	КонецЕсли;

	Токен = Строка(Новый УникальныйИдентификатор) + "-"
		+ Строка(Новый УникальныйИдентификатор);
	Запись = РегистрыСведений.ТокеныИнтеграций.СоздатьМенеджерЗаписи();
	Запись.ХешТокена = РИХ_Интеграции.ХешКлюча(Токен);
	Запись.Клиент = Клиент;
	Запись.Роль = ЗаписьКлиента.Роль;
	Запись.Выдан = ТекущаяДатаСеанса();
	Запись.Истекает = ТекущаяДатаСеанса() + СрокЖизниТокенаСекунд();
	Запись.Отозван = Ложь;
	Запись.Записать();
	РИХ_Интеграции.ЗаписатьВызов(Клиент, "token", "in", "", 200, "",
		0, "токен выдан, роль " + ЗаписьКлиента.Роль);

	Возврат Новый Структура("Токен,ИстекаетЧерезСекунд",
		Токен, СрокЖизниТокенаСекунд());

КонецФункции

// Единая проверка Bearer-токена запроса: существует, не отозван,
// не истёк, привязан к клиенту. Каждая попытка — строка журнала:
// по ней же видны перебор и кражи.
Функция ТокенДопустим(Запрос) Экспорт

	Заголовок = Запрос.Заголовки.Получить("Authorization");
	Если НЕ ЗначениеЗаполнено(Заголовок)
			ИЛИ НЕ СтрНачинаетсяС(Заголовок, "Bearer ") Тогда
		Возврат Ложь;
	КонецЕсли;
	Токен = Сред(Заголовок, 8);
	Запись = ПрочитатьТокен(РИХ_Интеграции.ХешКлюча(Токен));
	Если Запись = Неопределено Тогда
		РИХ_Интеграции.ЗаписатьВызов("auth", "token", "in", "", 401, "RIH-401",
			0, "неизвестный токен с " + РИХ_Интеграции.АдресКлиента(Запрос));
		Возврат Ложь;
	КонецЕсли;
	Если Запись.Отозван Тогда
		РИХ_Интеграции.ЗаписатьВызов(Запись.Клиент, "token", "in", "", 401,
			"RIH-TOKEN-REVOKED", 0, "попытка отозванным токеном");
		Возврат Ложь;
	КонецЕсли;
	Если ТекущаяДатаСеанса() > Запись.Истекает Тогда
		РИХ_Интеграции.ЗаписатьВызов(Запись.Клиент, "token", "in", "", 401,
			"RIH-TOKEN-EXPIRED", 0, "попытка просроченным токеном");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Отзывает токен немедленно: утекший токен умирает до конца TTL.
Процедура ОтозватьТокен(Токен) Экспорт

	Запись = РегистрыСведений.ТокеныИнтеграций.СоздатьМенеджерЗаписи();
	Запись.ХешТокена = РИХ_Интеграции.ХешКлюча(Токен);
	Запись.Прочитать();
	Если Запись.Клиент = "" Тогда
		Возврат;
	КонецЕсли;
	Запись.Отозван = Истина;
	Запись.Записать();
	РИХ_Интеграции.ЗаписатьВызов(Запись.Клиент, "token", "in", "", 200,
		"RIH-TOKEN-REVOKE", 0, "токен отозван вручную");

КонецПроцедуры

// Ротация секрета клиента без простоя: новый секрет действует сразу,
// предыдущий — до конца окна grace (24 часа), пока клиент переключится.
// Новый секрет возвращается один раз; в базе остаётся только хеш.
Функция РотироватьСекрет(Клиент, Пользователь = "система") Экспорт

	Запись = РегистрыСведений.КлиентыИнтеграций.СоздатьМенеджерЗаписи();
	Запись.Клиент = Клиент;
	Запись.Прочитать();
	Если Запись.Клиент = "" ИЛИ НЕ Запись.Активен Тогда
		ВызватьИсключение "RIH-404: клиент не найден или отключён";
	КонецЕсли;
	НовыйСекрет = Строка(Новый УникальныйИдентификатор) + "-"
		+ Строка(Новый УникальныйИдентификатор);
	Запись.ХешПредыдущегоСекрета = Запись.ХешСекрета;
	Запись.ПредыдущийСекретДо = ТекущаяДатаСеанса() + 86400;
	Запись.ХешСекрета = РИХ_Интеграции.ХешКлюча(НовыйСекрет);
	Запись.Записать();
	РИХ_Интеграции.ЗаписатьВызов(Клиент, "secret-rotate", "in", "", 200,
		"RIH-SECRET-ROTATE", 0, "секрет ротирован, предыдущий живёт 24 часа");
	// task_137: ротация — событие аудита людей: кто и когда менял
	// секрет, увидит расследование; сам секрет в аудит не попадает.
	РИХ_Аудит.ЗаписатьСобытие(Пользователь, "secret_rotate",
		"клиент " + Клиент, "окно grace 24 часа");

	Возврат НовыйСекрет;

КонецФункции

#КонецОбласти

#Область Служебные

// Истина, если клиент за последнюю минуту просил токен 30+ раз:
// легитимному клиенту токен нужен раз в час (TTL), тридцать
// попыток в минуту — перебор секрета или сломанный ретрай-цикл.
Функция ЧастотаВыдачиПревышена(Клиент)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Попыток
	|ИЗ РегистрСведений.ЖурналИнтеграций КАК Журнал
	|ГДЕ Журнал.Сервис = &Клиент И Журнал.Операция = ""token""
	|\tИ Журнал.Период >= &Порог";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Порог", ТекущаяДатаСеанса() - 60);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Попыток >= 30;

КонецФункции

// Читает запись клиента интеграций (Неопределено — клиента нет).
Функция ПрочитатьКлиента(Клиент)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Клиенты.Роль КАК Роль, Клиенты.Активен КАК Активен,
	|	Клиенты.ХешСекрета КАК ХешСекрета,
	|	Клиенты.ХешПредыдущегоСекрета КАК ХешПредыдущегоСекрета,
	|	Клиенты.ПредыдущийСекретДо КАК ПредыдущийСекретДо
	|ИЗ РегистрСведений.КлиентыИнтеграций КАК Клиенты
	|ГДЕ Клиенты.Клиент = &Клиент";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка, Неопределено);

КонецФункции

// Читает запись токена по его хешу (Неопределено — не выдавался).
Функция ПрочитатьТокен(ХешТокена)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Токены.Клиент КАК Клиент, Токены.Истекает КАК Истекает,
	|	Токены.Отозван КАК Отозван
	|ИЗ РегистрСведений.ТокеныИнтеграций КАК Токены
	|ГДЕ Токены.ХешТокена = &Хеш";
	Запрос.УстановитьПараметр("Хеш", ХешТокена);
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка, Неопределено);

КонецФункции

#КонецОбласти
