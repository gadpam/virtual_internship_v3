// РИХ_Деградация (task_131): заранее спроектированное снижение
// качества ради живучести. Правильный ответ на сбой — не всегда
// «встать»: продаём без бонусов (начислим после), считаем доставку
// по сетке, живём на последних курсах. Деградация без индикации —
// обман пользователя, поэтому каждый режим возвращает баннер.
// Матрица — documentation/operations/degradation_matrix.md.

#Область ПрограммныйИнтерфейс

// Продажа без бонусов: начисление при недоступной лояльности уходит
// в ОчередьОбмена (та же очередь task_110, не второй механизм)
// и выполнится при восстановлении; ключ операции сохраняется,
// поэтому позднее начисление не задвоится.
Функция НачислитьБаллыСДеградацией(ИдОперации, Карта, Баллы, Основание) Экспорт

	Попытка
		РИХ_ЛояльностьКлиент.Начислить(ИдОперации, Карта, Баллы, Основание);
		Возврат Новый Структура("Начислено,Отложено,Баннер",
			Истина, Ложь, "");
	Исключение
		// Откладывается только недоступность контура. Бизнес-отказ
		// партнёра (нет карты, битые данные) — не деградация:
		// отложенная бизнес-ошибка крутилась бы в очереди до мёртвой.
		Если НЕ ЭтоНедоступность(ОписаниеОшибки()) Тогда
			ВызватьИсключение;
		КонецЕсли;
		Тело = Новый Структура("operation_id,card,points,reason",
			ИдОперации, Карта, Баллы, Основание);
		РИХ_ОчередьОбмена.ПоставитьВСочередь("loyalty", "accrue",
			РИХ_Форматы.СтруктуруВJSON(Тело), ИдОперации);
		РИХ_Интеграции.ЗаписатьВызов("loyalty", "accrue", "out", ИдОперации,
			202, "RIH-DEFERRED", 0,
			"деградация: начисление отложено до восстановления контура");
		Возврат Новый Структура("Начислено,Отложено,Баннер",
			Ложь, Истина, БаннерДеградации("loyalty"));
	КонецПопытки;

КонецФункции

// Доставка без ТК: цена по локальной тарифной сетке с честной
// пометкой «оценка»; заявка в ТК создастся при восстановлении,
// а не выдумывается сейчас.
Функция ТарифСДеградацией(Город) Экспорт

	Попытка
		Ответ = РИХ_ТККлиент.РассчитатьСтоимость(Город, 1, 0.01);
		Возврат Новый Структура("Цена,Оценка,Баннер",
			Ответ.price, Ложь, "");
	Исключение
		Если НЕ ЭтоНедоступность(ОписаниеОшибки()) Тогда
			ВызватьИсключение;
		КонецЕсли;
		Возврат Новый Структура("Цена,Оценка,Баннер",
			ТарифПоСетке(Город), Истина, БаннерДеградации("tk"));
	КонецПопытки;

КонецФункции

// Курс с деградацией: банк недоступен — берём последний применённый
// курс и называем его дату. Старше 7 дней — не деградация, а стоп:
// цена по недельному курсу хуже честного отказа.
Функция КурсСДеградацией(Валюта, Дата) Экспорт

	Попытка
		РИХ_КурсыВалют.ЗагрузитьКурсы(Дата);
	Исключение
		// Банк молчит: работаем на последнем известном, открыто —
		// но падение загрузки видно в журнале, а не проглочено.
		РИХ_Интеграции.ЗаписатьВызов("bank", "GetRates", "out", "",
			504, "RIH-504", 0,
			"загрузка курсов упала, деградация на последнем известном: "
			+ ОписаниеОшибки());
	КонецПопытки;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Курсы.Курс / Курсы.Номинал КАК Курс,
	|	Курсы.ДатаКурса КАК ДатаКурса
	|ИЗ РегистрСведений.КурсыВалют КАК Курсы
	|ГДЕ Курсы.Валюта = &Валюта И Курсы.ДатаКурса <= &Дата
	|	И Курсы.СтатусКурса = &Применён
	|УПОРЯДОЧИТЬ ПО Курсы.ДатаКурса УБЫВ";
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Применён", "применён");
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ВызватьИсключение "RIH-422: нет курса " + Валюта + " даже локально";
	КонецЕсли;
	ВозрастДней = (НачалоДня(Дата) - НачалоДня(Выборка.ДатаКурса)) / 86400;
	Если ВозрастДней > 7 Тогда
		ВызватьИсключение "RIH-422: курс " + Валюта + " старше 7 дней ("
			+ Формат(Выборка.ДатаКурса, "ДФ=yyyy-MM-dd")
			+ ") — стоп, а не деградация";
	КонецЕсли;

	Возврат Новый Структура("Курс,ДатаКурса,Устаревший,Баннер",
		Выборка.Курс, Выборка.ДатаКурса, ВозрастДней > 0,
		?(ВозрастДней > 0,
			"Курсы временно недоступны: цены по курсу на "
			+ Формат(Выборка.ДатаКурса, "ДФ=dd.MM.yyyy"), ""));

КонецФункции

// Обработчик восстановления: предохранитель контура закрылся —
// отложенные операции уходят партнёру той же очередью task_110.
Функция ВыполнитьОтложенныеПриВосстановлении(Контур) Экспорт

	Если НЕ РИХ_Предохранители.РазрешитьВызов(Контур) Тогда
		Возврат Новый Структура("Отправлено,Отложено,Ошибок", 0, 0, 0);
	КонецЕсли;

	Возврат РИХ_ОчередьОбмена.ОбработатьОчередь();

КонецФункции

// Честный баннер ограниченного режима: обещание с предметом,
// а не «что-то пошло не так».
Функция БаннерДеградации(Контур) Экспорт

	Если Контур = "loyalty" Тогда
		Возврат "Бонусы временно не начисляются при покупке: "
			+ "начислим автоматически после восстановления сервиса, "
			+ "чек сохраните — баллы не потеряются.";
	ИначеЕсли Контур = "tk" Тогда
		Возврат "Стоимость доставки — предварительная оценка: "
			+ "точную назовём при создании заявки, до оплаты.";
	КонецЕсли;

	Возврат "Часть сервисов временно недоступна: работаем "
		+ "в ограниченном режиме, ключевые операции сохранены.";

КонецФункции

#КонецОбласти

#Область Служебные

// Недоступность контура по тексту ошибки: открытый предохранитель
// или исчерпанные попытки. Всё остальное — бизнес-исход, который
// деградацией не лечится и наружу пробрасывается как есть.
Функция ЭтоНедоступность(ТекстОшибки)

	Возврат СтрНайти(ТекстОшибки, "RIH-BREAKER-OPEN") > 0
		ИЛИ СтрНайти(ТекстОшибки, "RIH-503") > 0;

КонецФункции

// Локальная тарифная сетка деградации: грубая, но честная оценка
// до восстановления ТК. Не тариф партнёра и не выдаётся за него.
Функция ТарифПоСетке(Город)

	Если Город = "Минск" Тогда
		Возврат 7;
	ИначеЕсли Город = "Гродно" ИЛИ Город = "Брест"
			ИЛИ Город = "Витебск" ИЛИ Город = "Могилёв" Тогда
		Возврат 12;
	КонецЕсли;

	Возврат 15;

КонецФункции

#КонецОбласти
