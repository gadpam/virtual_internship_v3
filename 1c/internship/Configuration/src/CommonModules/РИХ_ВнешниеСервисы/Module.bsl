// РИХ_ВнешниеСервисы (task_86): вызовы партнёров с таймаутом и журналом.

#Область ПрограммныйИнтерфейс

// Получает курсы валют из SOAP-сервиса банка на дату.
//
// Параметры:
//   Дата - Дата - дата курсов.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Валюта, Номинал, Курс; при недоступности банка —
//   пустая таблица и инцидент в журнале (вызывающий решает, жить ли
//   на вчерашних курсах: это политика task_94, а не молчаливая подмена).
//
Функция ПолучитьКурсыВалютБанка(Дата) Экспорт

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПопыткаНомер = 0;
	Пока ПопыткаНомер < 2 Цикл
		ПопыткаНомер = ПопыткаНомер + 1;
		Попытка
			Прокси = СоздатьПроксиБанка();
			Ответ = Прокси.GetRates(Дата);
			РИХ_Интеграции.ЗаписатьВызов("bank", "GetRates", "out", "",
				200, "", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова);
			Возврат КурсыИзОтветаБанка(Ответ);
		Исключение
			Информация = ИнформацияОбОшибке();
			Если ЭтоFaultПартнёра(Информация) Тогда
				// Fault — ответ партнёра, повтор не поможет: сразу наружу
				РИХ_Интеграции.ЗаписатьВызов("bank", "GetRates", "out", "",
					500, "RIH-502", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова,
					"Fault банка: " + Информация.ПодробноеПредставлениеОшибки);
				ВызватьИсключение "Банк отклонил запрос (Fault). Обратитесь в поддержку.";
			КонецЕсли;
			// Сетевая ошибка: одна повторная попытка, дальше — инцидент
			Если ПопыткаНомер = 2 Тогда
				РИХ_Интеграции.ЗаписатьВызов("bank", "GetRates", "out", "",
					504, "RIH-504", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова,
					"банк недоступен после 2 попыток");
				Возврат Новый ТаблицаЗначений;
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

	Возврат Новый ТаблицаЗначений;

КонецФункции

#КонецОбласти

#Область Служебные

// Создаёт WS-прокси банка с явным таймаутом 10 секунд: таймаут
// «по умолчанию» платформы для интеграций не существует как политика.
// Логин/пароль ниже — учебные значения mock из его README; в боевом
// контуре пара берётся из безопасного хранилища (task_134), не из кода.
Функция СоздатьПроксиБанка()

	Определение = Новый WSОпределения(
		"http://127.0.0.1:8023/bank?wsdl", "bank_user", "bank_password");
	Параметры = Новый ПараметрыWSПрокси;
	Параметры.Таймаут = 10;

	Возврат Новый WSПрокси(Определение, "http://rih.local/bank",
		"BankService", "BankPort", Параметры);

КонецФункции

// Различает Fault партнёра и сетевую ошибку по представлению ошибки.
Функция ЭтоFaultПартнёра(Информация)

	Возврат СтрНайти(Информация.ПодробноеПредставлениеОшибки, "Fault") > 0;

КонецФункции

// Приводит ответ банка к таблице курсов.
Функция КурсыИзОтветаБанка(Ответ)

	Курсы = Новый ТаблицаЗначений;
	Курсы.Колонки.Добавить("Валюта");
	Курсы.Колонки.Добавить("Номинал");
	Курсы.Колонки.Добавить("Курс");
	Для Каждого Ставка Из Ответ Цикл
		СтрокаКурса = Курсы.Добавить();
		СтрокаКурса.Валюта = Ставка.CharCode;
		СтрокаКурса.Номинал = Ставка.Nominal;
		СтрокаКурса.Курс = Ставка.Value;
	КонецЦикла;

	Возврат Курсы;

КонецФункции

#КонецОбласти
