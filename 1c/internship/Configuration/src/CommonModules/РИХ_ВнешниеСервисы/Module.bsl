// РИХ_ВнешниеСервисы (task_86): вызовы партнёров с таймаутом и журналом.

#Область ПрограммныйИнтерфейс

// Получает курсы валют из SOAP-сервиса банка на дату.
//
// Параметры:
//   Дата - Дата - дата курсов.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Валюта, Номинал, Курс; при недоступности банка —
//   пустая таблица и инцидент в журнале (вызывающий решает, жить ли
//   на вчерашних курсах: это политика task_94, а не молчаливая подмена).
//
Функция ПолучитьКурсыВалютБанка(Дата) Экспорт

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	// Политика повторов — РИХ_ПовторныеПопытки (task_128): раньше здесь
	// жил собственный цикл «ещё раз сразу» без задержки; теперь попытки,
	// экспонента и джиттер берутся из общего модуля, Fault не повторяется.
	Политика = РИХ_ПовторныеПопытки.ПолитикаПоУмолчанию();
	ПопыткаНомер = 0;
	Пока ПопыткаНомер < Политика.МаксПопыток Цикл
		ПопыткаНомер = ПопыткаНомер + 1;
		Попытка
			Прокси = СоздатьПроксиБанка(ТаймаутОперацииБанка("GetRates"));
			Ответ = Прокси.GetRates(Дата);
			РИХ_Интеграции.ЗаписатьВызов("bank", "GetRates", "out", "",
				200, "", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова,
				"попытка " + Формат(ПопыткаНомер, "ЧГ=0"));
			Возврат КурсыИзОтветаБанка(Ответ);
		Исключение
			Информация = ИнформацияОбОшибке();
			Если ЭтоFaultПартнёра(Информация) Тогда
				// Fault — ответ партнёра, повтор не поможет: сразу наружу
				РИХ_Интеграции.ЗаписатьВызов("bank", "GetRates", "out", "",
					500, "RIH-502", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова,
					"Fault банка: " + Информация.ПодробноеПредставлениеОшибки);
				ВызватьИсключение "Банк отклонил запрос (Fault). Обратитесь в поддержку.";
			КонецЕсли;
			Если ПопыткаНомер >= Политика.МаксПопыток Тогда
				РИХ_Интеграции.ЗаписатьВызов("bank", "GetRates", "out", "",
					504, "RIH-504", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова,
					"банк недоступен после " + Формат(ПопыткаНомер, "ЧГ=0") + " попыток");
				Возврат Новый ТаблицаЗначений;
			КонецЕсли;
			РИХ_ПовторныеПопытки.Пауза(
				РИХ_ПовторныеПопытки.ЗадержкаПопытки(Политика, ПопыткаНомер + 1));
		КонецПопытки;
	КонецЦикла;

	Возврат Новый ТаблицаЗначений;

КонецФункции

// Явный таймаут операции банка в секундах (task_127). Одно значение
// «10 на всё» заменено политикой: статус — дешёвый опрос и не держит
// сеанс; отправка платежа длиннее, чтобы реже попадать в
// неопределённость «успел ли банк». Полная таблица —
// documentation/integrations/timeouts.md.
Функция ТаймаутОперацииБанка(Операция) Экспорт

	Если Операция = "GetPaymentStatus" Тогда
		Возврат 5;
	ИначеЕсли Операция = "SendPaymentOrder" Тогда
		Возврат 20;
	КонецЕсли;

	Возврат 10;

КонецФункции

// Отправляет платёжное поручение в шлюз банка (task_118).
// ВнешнийИД — ключ идемпотентности шлюза: повторная отправка того же
// поручения вернёт прежний PaymentId с Дубль=Истина, второй платёж
// банк не создаст; задвоенный платёж — финансовый инцидент.
// Таймаут отправки — неопределённость, а не «не выполнилось»:
// разрешаем её не слепым повтором, а тем же ключом идемпотентности
// (task_127). Вторая неудача — RIH-504 наружу: дальше статус
// выясняет человек/опрос, а не автоматика с новым ключом.
Функция ОтправитьПоручениеВБанк(ВнешнийИД, Номер, Дата, Плательщик,
		Получатель, Сумма, Назначение) Экспорт

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПопыткаНомер = 0;
	Пока ПопыткаНомер < 2 Цикл
		ПопыткаНомер = ПопыткаНомер + 1;
		Попытка
			Прокси = СоздатьПроксиБанка(ТаймаутОперацииБанка("SendPaymentOrder"));
			Ответ = Прокси.SendPaymentOrder(ВнешнийИД, Номер, Дата, Плательщик,
				Получатель, Сумма, "BYN", Назначение);
			РИХ_Интеграции.ЗаписатьВызов("bank", "SendPaymentOrder", "out",
				ВнешнийИД, 200, "", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова,
				?(Ответ.Duplicate = "true",
					"неопределённость разрешена: шлюз узнал ключ, второго платежа нет", ""));
			Возврат Новый Структура("ИдШлюза,Статус,Дубль",
				Ответ.PaymentId, Ответ.Status, Ответ.Duplicate = "true");
		Исключение
			Информация = ИнформацияОбОшибке();
			Если ЭтоFaultПартнёра(Информация) Тогда
				РИХ_Интеграции.ЗаписатьВызов("bank", "SendPaymentOrder", "out",
					ВнешнийИД, 500, "RIH-502",
					ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова,
					"Fault банка: " + Информация.ПодробноеПредставлениеОшибки);
				ВызватьИсключение "Банк отклонил поручение (Fault). Обратитесь в поддержку.";
			КонецЕсли;
			Если ПопыткаНомер = 2 Тогда
				РИХ_Интеграции.ЗаписатьВызов("bank", "SendPaymentOrder", "out",
					ВнешнийИД, 504, "RIH-504",
					ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова,
					"статус платежа неизвестен после 2 попыток; слепой повтор запрещён");
				ВызватьИсключение "RIH-504: статус платежа в банке неизвестен. "
					+ "Не отправляйте поручение новым ключом: выясните статус опросом.";
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

КонецФункции

// Опрашивает статус поручения в шлюзе по его PaymentId (task_118).
Функция СтатусПорученияВБанке(ИдШлюза) Экспорт

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Прокси = СоздатьПроксиБанка(ТаймаутОперацииБанка("GetPaymentStatus"));
		Ответ = Прокси.GetPaymentStatus(ИдШлюза);
		РИХ_Интеграции.ЗаписатьВызов("bank", "GetPaymentStatus", "out",
			ИдШлюза, 200, "", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова);
		Возврат Новый Структура("Статус,Сумма", Ответ.Status, Ответ.Amount);
	Исключение
		РИХ_Интеграции.ЗаписатьВызов("bank", "GetPaymentStatus", "out",
			ИдШлюза, 500, "RIH-502",
			ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова,
			"ошибка шлюза: " + ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Служебные

// Создаёт WS-прокси банка с явным таймаутом операции (task_127):
// таймаут «по умолчанию» платформы для интеграций политикой
// не является. Значения — ТаймаутОперацииБанка и timeouts.md.
// Логин/пароль ниже — учебные значения mock из его README; в боевом
// контуре пара берётся из безопасного хранилища (task_134), не из кода.
Функция СоздатьПроксиБанка(ТаймаутСекунд)

	Определение = Новый WSОпределения(
		"http://127.0.0.1:8023/bank?wsdl", "bank_user", "bank_password");
	Параметры = Новый ПараметрыWSПрокси;
	Параметры.Таймаут = ТаймаутСекунд;

	Возврат Новый WSПрокси(Определение, "http://rih.local/bank",
		"BankService", "BankPort", Параметры);

КонецФункции

// Различает Fault партнёра и сетевую ошибку по представлению ошибки.
Функция ЭтоFaultПартнёра(Информация)

	Возврат СтрНайти(Информация.ПодробноеПредставлениеОшибки, "Fault") > 0;

КонецФункции

// Приводит ответ банка к таблице курсов.
Функция КурсыИзОтветаБанка(Ответ)

	Курсы = Новый ТаблицаЗначений;
	Курсы.Колонки.Добавить("Валюта");
	Курсы.Колонки.Добавить("Номинал");
	Курсы.Колонки.Добавить("Курс");
	Для Каждого Ставка Из Ответ Цикл
		СтрокаКурса = Курсы.Добавить();
		СтрокаКурса.Валюта = Ставка.CharCode;
		СтрокаКурса.Номинал = Ставка.Nominal;
		СтрокаКурса.Курс = Ставка.Value;
	КонецЦикла;

	Возврат Курсы;

КонецФункции

#КонецОбласти
