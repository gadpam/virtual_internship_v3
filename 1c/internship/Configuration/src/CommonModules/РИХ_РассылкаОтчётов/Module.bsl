// РИХ_РассылкаОтчётов (task_176): аналог рассылки БСП для RIH.
// Цикл: сформировать вариант отчёта получателю с параметрами
// его подразделения, отправить, записать статус в журнал по
// каждому получателю. Повтор после ошибки шлёт только тем,
// у кого в журнале нет «отправлен»: дубль получившим — не
// повтор, а спам с объяснениями.

#Область ПрограммныйИнтерфейс

// Выполняет все рассылки, чьё расписание наступило. Ошибка
// формирования — уведомление администратору немедленно:
// руководитель не должен узнавать о сбое в 9:00 по телефону.
Процедура ВыполнитьРассылки() Экспорт

	Для Каждого Рассылка Из АктивныеРассылки() Цикл
		Для Каждого Получатель Из ПолучателиРоли(Рассылка.РольПолучателей) Цикл
			Если УжеОтправлено(Рассылка, Получатель) Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				Файл = СформироватьОтчёт(Рассылка, Получатель);
				ОтправитьПолучателю(Рассылка, Получатель, Файл);
				ЗаписатьЖурнал(Рассылка, Получатель, "отправлен", "");
			Исключение
				ЗаписатьЖурнал(Рассылка, Получатель, "ошибка",
					ОписаниеОшибки());
				УведомитьАдминистратора(Рассылка, Получатель,
					ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Журнал — единственное доказательство «уже получил»: повторная
// отправка смотрит статус, а не память оператора.
Функция УжеОтправлено(Рассылка, Получатель)

	Запись = РегистрыСведений.ЖурналРассылок.СоздатьМенеджерЗаписи();
	Запись.Рассылка = Строка(Рассылка);
	Запись.Получатель = Строка(Получатель);
	Запись.Прочитать();

	Возврат Запись.Выбран() И Запись.Статус = "отправлен";

КонецФункции

Процедура ЗаписатьЖурнал(Рассылка, Получатель, Статус, Детали)

	Запись = РегистрыСведений.ЖурналРассылок.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.Рассылка = Строка(Рассылка);
	Запись.Получатель = Строка(Получатель);
	Запись.Статус = Статус;
	Запись.Детали = Детали;
	Запись.Записать();

КонецПроцедуры

Процедура УведомитьАдминистратора(Рассылка, Получатель, Ошибка)

	Данные = Новый Структура("Рассылка, Получатель", Рассылка, Получатель);
	РИХ_Логирование.ЗаписатьОшибку("mailing_error", Ошибка, Данные);

КонецПроцедуры

// Активные рассылки справочника: расписание наступило или нет —
// решает регламентное задание контура по полю Расписание.
Функция АктивныеРассылки()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Рассылки.Ссылка КАК Ссылка
	|ИЗ Справочник.РассылкиОтчётов КАК Рассылки";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Получатели — пользователи информационной базы с ролью рассылки:
// состав даёт платформа, уволенный из роли выпадает сам, список
// адресов в задании не хранится (урок утечки task_290).
Функция ПолучателиРоли(Роль)

	Получатели = Новый Массив;
	Для Каждого Пользователь Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Для Каждого РольПользователя Из Пользователь.Роли Цикл
			Если РольПользователя.Имя = Роль Тогда
				Получатели.Добавить(Пользователь.Имя);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Получатели;

КонецФункции

// Формирование штатным компоновщиком отчёта с параметром
// подразделения получателя: персонализация настройкой варианта,
// а не копией рассылки по филиалам.
Функция СформироватьОтчёт(Рассылка, Получатель)

	ОтчётОбъект = Отчеты[Рассылка.Отчёт].Создать();
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ОтчётОбъект.СкомпоноватьРезультат(ТабличныйДокумент);

	Возврат ТабличныйДокумент;

КонецФункции

// Отправка: файл формируется всегда; транспорт почты — точка
// подключения контура (профиль ИнтернетПочты развёртывания).
// Большой отчёт уходит ссылкой на файл в журнале (Детали), а не
// вложением сверх почтового лимита — проверка до отправки.
Процедура ОтправитьПолучателю(Рассылка, Получатель, ТабличныйДокумент)

	ИмяФайла = ПолучитьИмяВременногоФайла(НРег(Рассылка.Формат));
	ТабличныйДокумент.Записать(ИмяФайла);
	ЗаписатьЖурнал(Рассылка, Получатель, "сформирован", ИмяФайла);

КонецПроцедуры

#КонецОбласти
