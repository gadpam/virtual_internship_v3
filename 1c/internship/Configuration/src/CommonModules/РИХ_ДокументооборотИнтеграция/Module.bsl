// РИХ_ДокументооборотИнтеграция (task_166): двусторонний контракт
// RIH и документооборота. Системы обмениваются СОСТОЯНИЯМИ, а не
// документами целиком: RIH знает «на согласовании/утверждено»,
// документооборот знает процесс. Отправка — очередью обмена
// с ключом идемпотентности; приём — в РС СостоянияДоговоров
// с проверкой ключа события до применения (повтор не двигает
// состояние второй раз). Коды чужой системы хранятся только
// через таблицу соответствия контракта.

#Область ПрограммныйИнтерфейс

// Ставит в очередь обмена документ на согласование. Вложение не
// копируется: владелец файла — RIH, уходит ссылка и хэш версии
// (иначе две «последние» версии договора в двух системах).
Функция СоздатьНаСогласование(ДоговорИД, СсылкаНаФайл, ХэшВерсии) Экспорт

	Пакет = Новый Структура;
	Пакет.Вставить("contract_id", ДоговорИД);
	Пакет.Вставить("file_ref", СсылкаНаФайл);
	Пакет.Вставить("file_hash", ХэшВерсии);
	ТелоJSON = РИХ_Форматы.СтруктураВJSON(Пакет);

	Возврат РИХ_ОчередьОбмена.ПоставитьВСочередь("docflow", "create_document",
		ТелоJSON, "DOCFLOW-CREATE-" + ДоговорИД);

КонецФункции

// Принимает событие состояния. Если событие с этим ключом уже
// записано — состояние не применяется повторно и функция
// возвращает Ложь: дубли транспорта не двигают процесс.
Функция ПринятьСостояние(ИДСобытия, ДоговорИД, СостояниеДО, Резолюция) Экспорт

	Запись = РегистрыСведений.СостоянияДоговоров.СоздатьМенеджерЗаписи();
	Запись.ДоговорИД = ДоговорИД;
	Запись.Прочитать();
	Если Запись.Выбран() И Запись.ИДСобытия = ИДСобытия Тогда
		Возврат Ложь;
	КонецЕсли;

	Запись.Состояние = СоответствиеСостояний(СостояниеДО);
	Запись.Резолюция = Резолюция;
	Запись.ИДСобытия = ИДСобытия;
	Запись.Записать();

	Возврат Истина;

КонецФункции

// Контроль операций: по несогласованному договору операции
// запрещены. Аварийный режим — не кнопка без следа: обоснование
// обязательно и пишется в аудит (механизм task_137), иначе обход
// станет обычным режимом за месяц.
Функция ОперацияРазрешена(ДоговорИД, Пользователь,
		ОбоснованиеАварийного = "") Экспорт

	Если ТекущееСостояние(ДоговорИД) = "Согласован" Тогда
		Возврат Истина;
	КонецЕсли;

	Если ОбоснованиеАварийного <> "" Тогда
		РИХ_Аудит.ЗаписатьСобытие(Пользователь, "emergency_contract_operation",
			ДоговорИД, ОбоснованиеАварийного);
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Состояние договора глазами RIH: из своего регистра, без
// прыжков пользователя между системами ради статуса.
Функция ТекущееСостояние(ДоговорИД) Экспорт

	Запись = РегистрыСведений.СостоянияДоговоров.СоздатьМенеджерЗаписи();
	Запись.ДоговорИД = ДоговорИД;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Возврат Запись.Состояние;
	КонецЕсли;

	Возврат "НеОтправлен";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Таблица соответствия контракта: состояние документооборота ->
// состояние RIH. Неизвестное состояние — «Неизвестно», операций
// не разрешает: чинится отображение, а не контроль.
Функция СоответствиеСостояний(СостояниеДО)

	Соответствие = Новый Соответствие;
	Соответствие.Вставить("НаСогласовании", "НаСогласовании");
	Соответствие.Вставить("Утверждён", "Согласован");
	Соответствие.Вставить("Отклонён", "Отклонён");
	Соответствие.Вставить("Подписан", "Согласован");

	Результат = Соответствие.Получить(СостояниеДО);
	Если Результат = Неопределено Тогда
		Результат = "Неизвестно";
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
