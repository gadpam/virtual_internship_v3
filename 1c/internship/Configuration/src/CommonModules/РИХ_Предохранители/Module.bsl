// РИХ_Предохранители (task_129): circuit breaker вокруг внешних
// контуров. Порядок слоёв: breaker снаружи, ретраи внутри (task_128).
// Breaker решает «вызывать ли вообще», ретраи работают внутри одной
// разрешённой серии; обратный порядок ломает подсчёт ошибок — breaker
// видел бы уже отретраенные вызовы и открывался от шума.
// Состояние — регистр СостоянияПредохранителей: открытость видна
// всем сеансам и мониторингу, а не одному потоку.

#Область ПрограммныйИнтерфейс

// Параметры автомата: порог — серия ошибок, а не одна («упало раз»
/// не открывает контур), остывание 60 с, проба в Half-Open одна.
Функция ПараметрыПредохранителя() Экспорт

	Возврат Новый Структура("ПорогОшибокПодряд,ОстываниеСекунд", 5, 60);

КонецФункции

// Решает, можно ли вызывать контур сейчас. В Open — мгновенный
// отказ без сети: пользователь получает честную деградацию, а не
// ожидание по таймауту на каждый чих у мёртвого партнёра.
// По истечении остывания переводит в Half-Open и разрешает
// ровно одну пробу: сто проб одновременно вернули бы шторм.
Функция РазрешитьВызов(Контур) Экспорт

	Запись = ПрочитатьСостояние(Контур);
	Если Запись = Неопределено Тогда
		ЗаписатьСостояние(Контур, "Closed", 0, 0, 0, Неопределено, Неопределено);
		Возврат Истина;
	КонецЕсли;
	Параметры = ПараметрыПредохранителя();
	Если Запись.Состояние = "Open" Тогда
		Если ТекущаяДатаСеанса() - Запись.ОткрытВ >= Параметры.ОстываниеСекунд Тогда
			ЗаписатьСостояние(Контур, "HalfOpen", Запись.ОшибокПодряд,
				Запись.ВызововВсего, Запись.ОшибокВсего,
				Запись.ОткрытВ, ТекущаяДатаСеанса());
			ЗаписатьПереход(Контур, "Open -> HalfOpen: проба восстановления");
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	Если Запись.Состояние = "HalfOpen" Тогда
		// Проба уже идёт: параллельные вызовы не пропускаем.
		// Зависшая проба старше остывания считается мёртвой.
		Возврат ТекущаяДатаСеанса() - Запись.МоментПробы
			>= Параметры.ОстываниеСекунд;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Фиксирует успешный вызов контура: проба Half-Open закрывает
// предохранитель, в Closed просто сбрасывает серию ошибок.
Процедура ЗафиксироватьУспех(Контур) Экспорт

	Запись = ПрочитатьСостояние(Контур);
	Если Запись = Неопределено Тогда
		ЗаписатьСостояние(Контур, "Closed", 0, 1, 0, Неопределено, Неопределено);
		Возврат;
	КонецЕсли;
	БылоСостояние = Запись.Состояние;
	ЗаписатьСостояние(Контур, "Closed", 0,
		Запись.ВызововВсего + 1, Запись.ОшибокВсего,
		Запись.ОткрытВ, Запись.МоментПробы);
	Если БылоСостояние <> "Closed" Тогда
		ЗаписатьПереход(Контур, БылоСостояние + " -> Closed: контур восстановлен");
	КонецЕсли;

КонецПроцедуры

// Фиксирует ошибку контура (финальную, после ретраев task_128):
// серия из порога ошибок открывает предохранитель; ошибка пробы
// Half-Open открывает его немедленно снова.
Процедура ЗафиксироватьОшибку(Контур) Экспорт

	Запись = ПрочитатьСостояние(Контур);
	Если Запись = Неопределено Тогда
		ЗаписатьСостояние(Контур, "Closed", 1, 1, 1, Неопределено, Неопределено);
		Возврат;
	КонецЕсли;
	Параметры = ПараметрыПредохранителя();
	ОшибокПодряд = Запись.ОшибокПодряд + 1;
	Состояние = Запись.Состояние;
	ОткрытВ = Запись.ОткрытВ;
	Если Состояние = "HalfOpen" ИЛИ ОшибокПодряд >= Параметры.ПорогОшибокПодряд Тогда
		Состояние = "Open";
		ОткрытВ = ТекущаяДатаСеанса();
	КонецЕсли;
	ЗаписатьСостояние(Контур, Состояние, ОшибокПодряд,
		Запись.ВызововВсего + 1, Запись.ОшибокВсего + 1,
		ОткрытВ, Запись.МоментПробы);
	Если Состояние = "Open" И Запись.Состояние <> "Open" Тогда
		ЗаписатьПереход(Контур, Запись.Состояние + " -> Open: серия ошибок "
			+ Формат(ОшибокПодряд, "ЧГ=0") + ", вызовы запрещены на "
			+ Формат(Параметры.ОстываниеСекунд, "ЧГ=0") + " с");
	КонецЕсли;

КонецПроцедуры

// Человекочитаемая ошибка открытого предохранителя для вызывающих:
// контур назван, причина честная, действие — очередь/деградация.
Функция ТекстОткрытогоПредохранителя(Контур) Экспорт

	Возврат "RIH-BREAKER-OPEN: контур " + Контур
		+ " временно отключён предохранителем: партнёр недоступен, "
		+ "вызовы не выполняются. Операция уходит в очередь/деградацию.";

КонецФункции

#КонецОбласти

#Область Служебные

// Читает запись состояния контура (Неопределено — контура ещё нет).
Функция ПрочитатьСостояние(Контур)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Состояния.Состояние КАК Состояние,
	|	Состояния.ОшибокПодряд КАК ОшибокПодряд,
	|	Состояния.ВызововВсего КАК ВызововВсего,
	|	Состояния.ОшибокВсего КАК ОшибокВсего,
	|	Состояния.ОткрытВ КАК ОткрытВ, Состояния.МоментПробы КАК МоментПробы
	|ИЗ РегистрСведений.СостоянияПредохранителей КАК Состояния
	|ГДЕ Состояния.Контур = &Контур";
	Запрос.УстановитьПараметр("Контур", Контур);
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка, Неопределено);

КонецФункции

// Пишет запись состояния контура одной записью регистра.
Процедура ЗаписатьСостояние(Контур, Состояние, ОшибокПодряд,
		ВызововВсего, ОшибокВсего, ОткрытВ, МоментПробы)

	Запись = РегистрыСведений.СостоянияПредохранителей.СоздатьМенеджерЗаписи();
	Запись.Контур = Контур;
	Запись.Состояние = Состояние;
	Запись.ОшибокПодряд = ОшибокПодряд;
	Запись.ВызововВсего = ВызововВсего;
	Запись.ОшибокВсего = ОшибокВсего;
	Запись.ОткрытВ = ОткрытВ;
	Запись.МоментПробы = МоментПробы;
	Запись.Записать();

КонецПроцедуры

// Переход состояния — строка журнала: «лояльность в Open с 14:02» —
// первая строка разбора инцидента (task_114), а не догадка постфактум.
Процедура ЗаписатьПереход(Контур, ТекстПерехода)

	РИХ_Интеграции.ЗаписатьВызов(Контур, "circuit-breaker", "out", "",
		200, "RIH-BREAKER", 0, ТекстПерехода);

КонецПроцедуры

#КонецОбласти
