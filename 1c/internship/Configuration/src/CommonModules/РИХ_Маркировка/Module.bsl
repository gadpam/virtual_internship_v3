// РИХ_Маркировка (task_116): приёмка, движение и выбытие кодов.
// Единственное место конечного автомата кодов. Если завтра появится
// новый вид документа, он вызовет функции этого модуля и получит те же
// запреты: выбывший код не продаётся второй раз, неотправленное
// перемещение не получается, списанный код не возвращается в продажу.

#Область ПрограммныйИнтерфейс

// Принимает единичные коды товара на склад.
// Повтор известного кода и код, уже принадлежащий другому товару, —
// ошибки RIH-409: приёмка не перезаписывает чужую биографию.
Функция ПринятьКоды(Номенклатура, Склад, Коды, ДокументИсточник) Экспорт

	ПроверитьВходнойСписокКодов(Коды);
	Для Каждого Код Из Коды Цикл
		ЗаписатьНовыйКод(Код, Номенклатура, Склад, "", "Единица", ДокументИсточник);
	КонецЦикла;

	Возврат Коды.Количество();

КонецФункции

// Принимает упаковку и все её единицы одной операцией.
// Родитель хранится как агрегат и в количество единиц не входит.
Функция ПринятьАгрегат(КодАгрегата, Номенклатура, Склад, КодыЕдиниц, ДокументИсточник) Экспорт

	ПроверитьВходнойСписокКодов(КодыЕдиниц);
	Если НЕ ЗначениеЗаполнено(СокрЛП(КодАгрегата)) Тогда
		ВызватьИсключение "RIH-422: не заполнен код агрегата";
	КонецЕсли;
	ЗаписатьНовыйКод(КодАгрегата, Номенклатура, Склад, "", "Агрегат", ДокументИсточник);
	Для Каждого КодЕдиницы Из КодыЕдиниц Цикл
		ЗаписатьНовыйКод(КодЕдиницы, Номенклатура, Склад,
			КодАгрегата, "Единица", ДокументИсточник);
	КонецЦикла;

	Возврат КодыЕдиниц.Количество();

КонецФункции

// Переводит принятые или возвращённые коды в доступное наличие.
Функция РазместитьКоды(Коды, ДокументИсточник) Экспорт

	Возврат ИзменитьСтатусыКодов(Коды, "ВНаличии", ДокументИсточник);

КонецФункции

// Отправляет коды перемещением. Агрегат уходит вместе с содержимым.
Функция ОтправитьПеремещение(Коды, ДокументИсточник) Экспорт

	Возврат ИзменитьСтатусыКодов(Коды, "Перемещён", ДокументИсточник);

КонецФункции

// Получает отправленное перемещение на склад-получатель.
Функция ПолучитьПеремещение(Коды, СкладПолучатель, ДокументИсточник) Экспорт

	Возврат ИзменитьСтатусыКодов(Коды, "ВНаличии", ДокументИсточник, "", СкладПолучатель);

КонецФункции

// Выводит коды продажей или списанием. Причина обязательна: от неё
// зависит, разрешён ли будущий возврат.
Функция ВывестиКоды(Коды, ПричинаВыбытия, ДокументИсточник) Экспорт

	Если ПричинаВыбытия <> "Продажа" И ПричинаВыбытия <> "Списание" Тогда
		ВызватьИсключение "RIH-422: неизвестная причина выбытия кода: " + ПричинаВыбытия;
	КонецЕсли;

	Возврат ИзменитьСтатусыКодов(Коды, "Выбыл", ДокументИсточник, ПричинаВыбытия);

КонецФункции

// Возвращает проданный код. Списанный код этой функцией не оживляется.
Функция ВернутьКоды(Коды, ДокументИсточник) Экспорт

	Возврат ИзменитьСтатусыКодов(Коды, "Возвращён", ДокументИсточник);

КонецФункции

// Текущий статус одного кода или пустая строка для неизвестного кода.
Функция ТекущийСтатусКода(Код) Экспорт

	Состояние = ТекущееСостояниеКода(Код);
	Если Состояние = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Состояние.Статус;

КонецФункции

// История переходов кодов за период для отчёта «Движение кодов».
Функция ДвиженияКодовЗаПериод(ПериодС, ПериодПо) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Коды.Период КАК Период, Коды.Код КАК Код,
	|	Коды.Номенклатура КАК Номенклатура, Коды.ТекущийСклад КАК Склад,
	|	Коды.Статус КАК Статус, Коды.ДокументИсточник КАК ДокументИсточник,
	|	Коды.ПричинаВыбытия КАК ПричинаВыбытия
	|ИЗ РегистрСведений.КодыМаркировки КАК Коды
	|ГДЕ Коды.Период МЕЖДУ &ПериодС И &ПериодПо
	|УПОРЯДОЧИТЬ ПО Коды.Период, Коды.Код";
	Запрос.УстановитьПараметр("ПериодС", ПериодС);
	Запрос.УстановитьПараметр("ПериодПо", ПериодПо);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Сверяет количественные остатки и единичные коды по товару и складу.
// Агрегаты не считаются единицами; коды в пути и ожидающие размещения
// возвраты в физический остаток не входят.
Функция РасхожденияКоличестваИКодов() Экспорт

	ЗапросОстатков = Новый Запрос;
	ЗапросОстатков.Текст =
	"ВЫБРАТЬ Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Склад КАК Склад, Остатки.КоличествоОстаток КАК Количество
	|ИЗ РегистрНакопления.ТоварыНаСкладах.Остатки() КАК Остатки";
	КоличественныеОстатки = ЗапросОстатков.Выполнить().Выгрузить();

	ЗапросКодов = Новый Запрос;
	ЗапросКодов.Текст =
	"ВЫБРАТЬ Коды.Номенклатура КАК Номенклатура,
	|	Коды.ТекущийСклад КАК Склад, КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Коды.Код) КАК Кодов
	|ИЗ РегистрСведений.КодыМаркировки.СрезПоследних() КАК Коды
	|ГДЕ Коды.ТипКода = &Единица И Коды.Статус В (&СтатусыНаСкладе)
	|СГРУППИРОВАТЬ ПО Коды.Номенклатура, Коды.ТекущийСклад";
	ЗапросКодов.УстановитьПараметр("Единица", "Единица");
	ЗапросКодов.УстановитьПараметр("СтатусыНаСкладе", СтатусыФизическогоНаличия());
	КодыПоСкладам = ЗапросКодов.Выполнить().Выгрузить();

	Расхождения = НоваяТаблицаРасхождений();
	Для Каждого СтрокаКодов Из КодыПоСкладам Цикл
		СтрокиКоличества = КоличественныеОстатки.НайтиСтроки(
			Новый Структура("Номенклатура,Склад", СтрокаКодов.Номенклатура, СтрокаКодов.Склад));
		Количество = ?(СтрокиКоличества.Количество() = 0, 0, СтрокиКоличества[0].Количество);
		Если Количество <> СтрокаКодов.Кодов Тогда
			ДобавитьРасхождение(Расхождения, СтрокаКодов.Номенклатура,
				СтрокаКодов.Склад, Количество, СтрокаКодов.Кодов);
		КонецЕсли;
		Если СтрокиКоличества.Количество() > 0 Тогда
			КоличественныеОстатки.Удалить(СтрокиКоличества[0]);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаКоличества Из КоличественныеОстатки Цикл
		Если СтрокаКоличества.Количество <> 0 Тогда
			ДобавитьРасхождение(Расхождения, СтрокаКоличества.Номенклатура,
				СтрокаКоличества.Склад, СтрокаКоличества.Количество, 0);
		КонецЕсли;
	КонецЦикла;

	Возврат Расхождения;

КонецФункции

#КонецОбласти

#Область Служебные

// Записывает впервые увиденный код в статусе «Принят».
Процедура ЗаписатьНовыйКод(Код, Номенклатура, Склад, РодительскийКод, ТипКода, ДокументИсточник)

	Если НЕ ЗначениеЗаполнено(СокрЛП(Код)) Тогда
		ВызватьИсключение "RIH-422: пустой код маркировки";
	КонецЕсли;
	Состояние = ТекущееСостояниеКода(Код);
	Если Состояние <> Неопределено Тогда
		Если Состояние.Номенклатура <> Номенклатура Тогда
			ВызватьИсключение "RIH-409: код " + Код
				+ " уже принадлежит другой номенклатуре";
		КонецЕсли;
		ВызватьИсключение "RIH-409: код маркировки уже принят: " + Код;
	КонецЕсли;

	ЗаписатьСостояниеКода(Код, Номенклатура, Склад, "Принят",
		ДокументИсточник, РодительскийКод, ТипКода, "");

КонецПроцедуры

// Изменяет статус списка, раскрывая агрегаты в их единицы.
// Возвращает количество изменённых записей, включая родителей.
Функция ИзменитьСтатусыКодов(Коды, НовыйСтатус, ДокументИсточник,
		ПричинаВыбытия = "", НовыйСклад = Неопределено)

	ПроверитьВходнойСписокКодов(Коды);
	ПолныйСписок = КодыСОхватомАгрегатов(Коды);
	Изменено = 0;
	Для Каждого Код Из ПолныйСписок Цикл
		Состояние = ТекущееСостояниеКода(Код);
		Если Состояние = Неопределено Тогда
			ВызватьИсключение "RIH-422: неизвестный код маркировки: " + Код;
		КонецЕсли;
		Если НЕ РазрешёнПереход(Состояние, НовыйСтатус) Тогда
			ВызватьИсключение "RIH-409: запрещён переход кода " + Код
				+ " из «" + Состояние.Статус + "» в «" + НовыйСтатус + "»";
		КонецЕсли;
		Склад = ?(НовыйСклад = Неопределено, Состояние.ТекущийСклад, НовыйСклад);
		Причина = ПричинаДляЗаписи(Состояние, НовыйСтатус, ПричинаВыбытия);
		ЗаписатьСостояниеКода(Код, Состояние.Номенклатура, Склад, НовыйСтатус,
			ДокументИсточник, Состояние.РодительскийКод, Состояние.ТипКода, Причина);
		Изменено = Изменено + 1;
	КонецЦикла;

	Возврат Изменено;

КонецФункции

// Разрешённые переходы конечного автомата — единственная таблица правил.
Функция РазрешёнПереход(Состояние, НовыйСтатус)

	ТекущийСтатус = Состояние.Статус;
	Если ТекущийСтатус = "Принят" Тогда
		Возврат НовыйСтатус = "ВНаличии" ИЛИ НовыйСтатус = "Перемещён"
			ИЛИ НовыйСтатус = "Выбыл";
	ИначеЕсли ТекущийСтатус = "ВНаличии" Тогда
		Возврат НовыйСтатус = "Перемещён" ИЛИ НовыйСтатус = "Выбыл";
	ИначеЕсли ТекущийСтатус = "Перемещён" Тогда
		Возврат НовыйСтатус = "ВНаличии";
	ИначеЕсли ТекущийСтатус = "Выбыл" Тогда
		Возврат НовыйСтатус = "Возвращён" И Состояние.ПричинаВыбытия = "Продажа";
	ИначеЕсли ТекущийСтатус = "Возвращён" Тогда
		Возврат НовыйСтатус = "ВНаличии" ИЛИ НовыйСтатус = "Выбыл";
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Причина, сохраняемая в новой записи состояния.
Функция ПричинаДляЗаписи(Состояние, НовыйСтатус, ПричинаВыбытия)

	Если НовыйСтатус = "Выбыл" Тогда
		Возврат ПричинаВыбытия;
	ИначеЕсли НовыйСтатус = "Возвращён" Тогда
		Возврат Состояние.ПричинаВыбытия;
	КонецЕсли;

	Возврат "";

КонецФункции

// Расширяет список кодами единиц всех встреченных агрегатов без дублей.
Функция КодыСОхватомАгрегатов(Коды)

	Результат = Новый Массив;
	Добавленные = Новый Соответствие;
	Для Каждого Код Из Коды Цикл
		Если Добавленные.Получить(Код) = Неопределено Тогда
			Результат.Добавить(Код);
			Добавленные.Вставить(Код, Истина);
		КонецЕсли;
		Состояние = ТекущееСостояниеКода(Код);
		Если Состояние <> Неопределено И Состояние.ТипКода = "Агрегат" Тогда
			Для Каждого КодЕдиницы Из ДочерниеКоды(Код) Цикл
				Если Добавленные.Получить(КодЕдиницы) = Неопределено Тогда
					Результат.Добавить(КодЕдиницы);
					Добавленные.Вставить(КодЕдиницы, Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Текущие коды единиц одного агрегата.
Функция ДочерниеКоды(КодАгрегата)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Коды.Код КАК Код
	|ИЗ РегистрСведений.КодыМаркировки.СрезПоследних() КАК Коды
	|ГДЕ Коды.РодительскийКод = &КодАгрегата И Коды.ТипКода = &Единица";
	Запрос.УстановитьПараметр("КодАгрегата", КодАгрегата);
	Запрос.УстановитьПараметр("Единица", "Единица");

	Возврат Запрос.Выполнить().ВыгрузитьКолонку("Код");

КонецФункции

// Текущее состояние кода срезом последней записи или Неопределено.
Функция ТекущееСостояниеКода(Код)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Коды.Номенклатура КАК Номенклатура,
	|	Коды.Статус КАК Статус, Коды.ТекущийСклад КАК ТекущийСклад,
	|	Коды.РодительскийКод КАК РодительскийКод, Коды.ТипКода КАК ТипКода,
	|	Коды.ПричинаВыбытия КАК ПричинаВыбытия
	|ИЗ РегистрСведений.КодыМаркировки.СрезПоследних(, Код = &Код) КАК Коды";
	Запрос.УстановитьПараметр("Код", Код);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура(
		"Номенклатура,Статус,ТекущийСклад,РодительскийКод,ТипКода,ПричинаВыбытия",
		Выборка.Номенклатура, Выборка.Статус, Выборка.ТекущийСклад,
		Выборка.РодительскийКод, Выборка.ТипКода, Выборка.ПричинаВыбытия);

КонецФункции

// Одна запись истории состояния кода.
Процедура ЗаписатьСостояниеКода(Код, Номенклатура, Склад, Статус,
		ДокументИсточник, РодительскийКод, ТипКода, ПричинаВыбытия)

	Запись = РегистрыСведений.КодыМаркировки.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.Код = Код;
	Запись.Номенклатура = Номенклатура;
	Запись.Статус = Статус;
	Запись.ДокументИсточник = ДокументИсточник;
	Запись.ТекущийСклад = Склад;
	Запись.РодительскийКод = РодительскийКод;
	Запись.ТипКода = ТипКода;
	Запись.ПричинаВыбытия = ПричинаВыбытия;
	Запись.Записать();

КонецПроцедуры

// Отбрасывает пустые и повторяющиеся коды внутри одного вызова.
Процедура ПроверитьВходнойСписокКодов(Коды)

	Виденные = Новый Соответствие;
	Для Каждого Код Из Коды Цикл
		Если НЕ ЗначениеЗаполнено(СокрЛП(Код)) Тогда
			ВызватьИсключение "RIH-422: пустой код маркировки";
		КонецЕсли;
		Если Виденные.Получить(Код) <> Неопределено Тогда
			ВызватьИсключение "RIH-422: код повторяется во входном списке: " + Код;
		КонецЕсли;
		Виденные.Вставить(Код, Истина);
	КонецЦикла;

КонецПроцедуры

// Статусы кодов, физически находящихся на складе.
Функция СтатусыФизическогоНаличия()

	Статусы = Новый Массив;
	Статусы.Добавить("Принят");
	Статусы.Добавить("ВНаличии");
	Возврат Статусы;

КонецФункции

// Пустая таблица результата контрольной сверки.
Функция НоваяТаблицаРасхождений()

	Расхождения = Новый ТаблицаЗначений;
	Расхождения.Колонки.Добавить("Номенклатура");
	Расхождения.Колонки.Добавить("Склад");
	Расхождения.Колонки.Добавить("КоличествоПоУчёту");
	Расхождения.Колонки.Добавить("ЕдиничныхКодов");
	Расхождения.Колонки.Добавить("Разница");
	Возврат Расхождения;

КонецФункции

// Добавляет одну строку расхождения с подписанной разницей.
Процедура ДобавитьРасхождение(Расхождения, Номенклатура, Склад, Количество, Кодов)

	СтрокаРасхождения = Расхождения.Добавить();
	СтрокаРасхождения.Номенклатура = Номенклатура;
	СтрокаРасхождения.Склад = Склад;
	СтрокаРасхождения.КоличествоПоУчёту = Количество;
	СтрокаРасхождения.ЕдиничныхКодов = Кодов;
	СтрокаРасхождения.Разница = Количество - Кодов;

