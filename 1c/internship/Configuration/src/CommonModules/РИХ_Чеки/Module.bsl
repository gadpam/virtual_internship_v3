// РИХ_Чеки (task_117): пакетный приём чеков касс.
// Касса повторяет отправку пачки после обрыва связи по дизайну, поэтому
// повтор — не ошибка и не второй чек: идемпотентность по (ФН, номер).
// Один плохой чек не валит пакет: хорошие принимаются, плохой уходит
// в карантин с причиной, ответ честно показывает все три исхода.

#Область ПрограммныйИнтерфейс

// Принимает пакет чеков {receipts: [...]}; каждый чек независим.
// Возвращает {total, accepted, duplicates, quarantined, results[]}:
// статус по чеку — принят, дубль или карантин с причиной.
Функция ПринятьПакетЧеков(Данные) Экспорт

	Результаты = Новый Массив;
	Принято = 0;
	Дублей = 0;
	ВКарантине = 0;
	Для Каждого Чек Из Данные.receipts Цикл
		Результат = ПринятьЧек(Чек);
		Если Результат.Статус = "принят" Тогда
			Принято = Принято + 1;
		ИначеЕсли Результат.Статус = "дубль" Тогда
			Дублей = Дублей + 1;
		Иначе
			ВКарантине = ВКарантине + 1;
		КонецЕсли;
		Результаты.Добавить(Результат);
	КонецЦикла;

	Возврат Новый Структура("total,accepted,duplicates,quarantined,results",
		Данные.receipts.Количество(), Принято, Дублей, ВКарантине, Результаты);

КонецФункции

// Принимает один чек: валидация, идемпотентность, документ и проведение.
// Ошибка валидации — не исключение наружу, а карантин: пакет важнее чека.
Функция ПринятьЧек(Чек) Экспорт

	Ключ = КлючЧека(Чек);
	Причина = ПричинаОтклоненияЧека(Чек);
	Если ЗначениеЗаполнено(Причина) Тогда
		ПоместитьЧекВКарантин(Ключ, Причина, Чек);
		Возврат РезультатЧека(Ключ, "карантин", Причина);
	КонецЕсли;

	Существующий = НайтиЧек(Чек.fn, Чек.number);
	Если Существующий <> Неопределено Тогда
		Если СодержимоеСовпадает(Существующий, Чек) Тогда
			Возврат РезультатЧека(Ключ, "дубль", "");
		КонецЕсли;
		Причина = "повтор с другим содержимым: сумма или строки не совпадают с принятым чеком";
		ПоместитьЧекВКарантин(Ключ, Причина, Чек);
		Возврат РезультатЧека(Ключ, "карантин", Причина);
	КонецЕсли;

	СоздатьДокументЧека(Чек);
	Возврат РезультатЧека(Ключ, "принят", "");

КонецФункции

#КонецОбласти

#Область Служебные

// Ключ идемпотентности и карантина: ФН и номер чека одной строкой.
Функция КлючЧека(Чек)

	Возврат СокрЛП(Чек.fn) + ":" + Формат(Чек.number, "ЧГ=0");

КонецФункции

// Первая причина отклонения чека или пустая строка, если чек чистый.
// Порядок важен оператору: сначала форма, затем деньги, затем связи.
Функция ПричинаОтклоненияЧека(Чек)

	Если НЕ ЗначениеЗаполнено(СокрЛП(Чек.fn)) ИЛИ Чек.number <= 0 Тогда
		Возврат "не заполнен ФН или номер чека";
	КонецЕсли;
	Если Чек.lines.Количество() = 0 Тогда
		Возврат "в чеке нет строк товаров";
	КонецЕсли;
	СуммаСтрок = 0;
	Для Каждого СтрокаЧека Из Чек.lines Цикл
		Если НайтиТоварПоАртиклу(СтрокаЧека.sku) = Неопределено Тогда
			Возврат "нет сопоставления товара " + СтрокаЧека.sku;
		КонецЕсли;
		Если СтрокаЧека.quantity <= 0 ИЛИ СтрокаЧека.price < 0 Тогда
			Возврат "некорректные количество или цена товара " + СтрокаЧека.sku;
		КонецЕсли;
		СуммаСтроки = Окр(СтрокаЧека.quantity * СтрокаЧека.price, 2);
		Если Окр(СтрокаЧека.sum, 2) <> СуммаСтроки Тогда
			Возврат "сумма строки " + СтрокаЧека.sku + " не равна количество × цена";
		КонецЕсли;
		СуммаСтрок = СуммаСтрок + СуммаСтроки;
	КонецЦикла;
	Если Окр(Чек.total, 2) <> Окр(СуммаСтрок, 2) Тогда
		Возврат "сумма чека " + Формат(Чек.total, "ЧДЦ=2; ЧГ=0")
			+ " не сходится с суммой строк " + Формат(СуммаСтрок, "ЧДЦ=2; ЧГ=0");
	КонецЕсли;
	Если Чек.kind = "return" Тогда
		Возврат ПричинаОтклоненияВозврата(Чек);
	ИначеЕсли Чек.kind <> "sale" Тогда
		Возврат "неизвестный вид чека: " + Чек.kind;
	КонецЕсли;

	Возврат "";

КонецФункции

// Возврат обязан ссылаться на принятый чек продажи той же кассы
// и не превышать ещё не возвращённую сумму исходного чека.
Функция ПричинаОтклоненияВозврата(Чек)

	Оригинал = НайтиЧек(Чек.ref_fn, Чек.ref_number);
	Если Оригинал = Неопределено ИЛИ Оригинал.ВидЧека <> "Продажа" Тогда
		Возврат "исходный чек возврата не найден: "
			+ СокрЛП(Чек.ref_fn) + ":" + Формат(Чек.ref_number, "ЧГ=0");
	КонецЕсли;
	Если Оригинал.ФН <> Чек.fn Тогда
		Возврат "возврат пробит на другой кассе, чем исходный чек";
	КонецЕсли;
	Если Окр(Чек.total, 2) > Окр(ДоступноКВозврату(Оригинал), 2) Тогда
		Возврат "сумма возврата превышает остаток по исходному чеку";
	КонецЕсли;

	Возврат "";

КонецФункции

// Сумма исходного чека минус уже принятые возвраты по нему.
Функция ДоступноКВозврату(Оригинал)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ЕСТЬNULL(СУММА(Возвраты.СуммаЧека), 0) КАК Возвращено
	|ИЗ Документ.Чек КАК Возвраты
	|ГДЕ Возвраты.ИсходныйЧек = &Оригинал И Возвраты.Проведен";
	Запрос.УстановитьПараметр("Оригинал", Оригинал);
	Выборка = Запрос.Выполнить().Выбрать();
	Возвращено = ?(Выборка.Следующий(), Выборка.Возвращено, 0);

	Возврат Оригинал.СуммаЧека - Возвращено;

КонецФункции

// Создаёт и проводит документ чека по принятым данным.
Процедура СоздатьДокументЧека(Чек)

	Документ = Документы.Чек.СоздатьДокумент();
	Документ.Дата = ДатаЧека(Чек);
	Документ.Магазин = НайтиМагазин(Чек.shop);
	Документ.Касса = Чек.cashier;
	Документ.ФН = Чек.fn;
	Документ.НомерЧека = Чек.number;
	Документ.ВидЧека = ?(Чек.kind = "return", "Возврат", "Продажа");
	Если Чек.kind = "return" Тогда
		Документ.ИсходныйЧек = НайтиЧек(Чек.ref_fn, Чек.ref_number);
	КонецЕсли;
	Для Каждого СтрокаЧека Из Чек.lines Цикл
		СтрокаДокумента = Документ.Товары.Добавить();
		СтрокаДокумента.Номенклатура = НайтиТоварПоАртиклу(СтрокаЧека.sku);
		СтрокаДокумента.Количество = СтрокаЧека.quantity;
		СтрокаДокумента.Цена = СтрокаЧека.price;
		СтрокаДокумента.Сумма = Окр(СтрокаЧека.quantity * СтрокаЧека.price, 2);
	КонецЦикла;
	Документ.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

// Найденный принятый чек по ключу идемпотентности или Неопределено.
Функция НайтиЧек(ФН, НомерЧека)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Чеки.Ссылка КАК Ссылка
	|ИЗ Документ.Чек КАК Чеки
	|ГДЕ Чеки.ФН = &ФН И Чеки.НомерЧека = &НомерЧека
	|УПОРЯДОЧИТЬ ПО Чеки.Дата";
	Запрос.УстановитьПараметр("ФН", СокрЛП(ФН));
	Запрос.УстановитьПараметр("НомерЧека", НомерЧека);
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

// Повтор — тот же чек, а не просто тот же ключ: итог и вид совпадают.
Функция СодержимоеСовпадает(Существующий, Чек)

	ВидСовпадает = (Существующий.ВидЧека = "Возврат") = (Чек.kind = "return");
	Возврат ВидСовпадает И Окр(Существующий.СуммаЧека, 2) = Окр(Чек.total, 2);

КонецФункции

// Кладёт отклонённый чек в карантин с причиной и исходным JSON.
Процедура ПоместитьЧекВКарантин(Ключ, Причина, Чек)

	Запись = РегистрыСведений.КарантинЧеков.СоздатьМенеджерЗаписи();
	Запись.КлючЧека = Ключ;
	Запись.Причина = Причина;
	Запись.ТелоЧека = РИХ_Форматы.СтруктураВJSON(Чек);
	Запись.МоментПомещения = ТекущаяДатаСеанса();
	Запись.СтатусРазбора = "ждёт";
	Запись.Записать();

КонецПроцедуры

// Магазин пакета по коду справочника складов.
Функция НайтиМагазин(КодМагазина)

	Магазин = Справочники.Склады.НайтиПоКоду(КодМагазина);
	Если НЕ ЗначениеЗаполнено(Магазин) Тогда
		ВызватьИсключение "RIH-422: магазин не найден по коду: " + КодМагазина;
	КонецЕсли;

	Возврат Магазин;

КонецФункции

// Товар строки по артикулу или Неопределено (решение — за валидацией).
Функция НайтиТоварПоАртиклу(Артикул)

	Товар = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Артикул);
	Возврат ?(ЗначениеЗаполнено(Товар), Товар, Неопределено);

КонецФункции

// Дата чека из ISO-строки пакета; без неё — момент приёма.
Функция ДатаЧека(Чек)

	Попытка
		Возврат РИХ_ОбщегоНазначения.РазобратьIso8601(Чек.datetime);
	Исключение
		Возврат ТекущаяДатаСеанса();
	КонецПопытки;

КонецФункции

// Элемент ответа пакета по одному чеку.
Функция РезультатЧека(Ключ, Статус, Причина)

	Результат = Новый Структура("key,status,reason", Ключ, Статус, Причина);
	Возврат Результат;

КонецФункции

#КонецОбласти
