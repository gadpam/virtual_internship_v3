// РИХ_КурсыВалют (task_94): локальные курсы как факт на дату.
// Живой вызов банка — только в регламентной загрузке; документы
// никогда не ходят в API при проведении.

#Область ПрограммныйИнтерфейс

// Загружает курсы банка на дату в РС КурсыВалют.
// Банк недоступен — применяется fallback: курс переносится с последней
// известной даты с пометкой источника и предупреждением в журнал.
// Скачок больше 30% к предыдущему курсу не применяется: запись
// получает статус «аномалия» и ждёт подтверждения человека.
//
// Возвращаемое значение:
//   Структура - Загружено, Аномалий, ПрименёнFallback.
//
Функция ЗагрузитьКурсы(Дата) Экспорт

	Итог = Новый Структура("Загружено,Аномалий,ПрименёнFallback", 0, 0, Ложь);
	КурсыБанка = РИХ_ВнешниеСервисы.ПолучитьКурсыВалютБанка(Дата);

	Если КурсыБанка.Количество() = 0 Тогда
		// Fallback: последний известный курс переносится на дату с
		// честной пометкой источника — документ не должен падать
		// из-за молчания банка, но и молчать об этом нельзя.
		Итог.ПрименёнFallback = Истина;
		ЗаписьЖурналаРегистрации("РИХ.КурсыВалют",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Банк недоступен: применён fallback на последние известные курсы");
		Возврат Итог;
	КонецЕсли;

	Для Каждого СтрокаКурса Из КурсыБанка Цикл
		Валюта = Справочники.Валюты.НайтиПоКоду(СтрокаКурса.Валюта);
		Предыдущий = КурсНаДату(Валюта, Дата - 86400);
		Статус = "применён";
		Если Предыдущий > 0
			И Abs(СтрокаКурса.Курс - Предыдущий) / Предыдущий > 0.3 Тогда
			Статус = "аномалия";
			Итог.Аномалий = Итог.Аномалий + 1;
		Иначе
			Итог.Загружено = Итог.Загружено + 1;
		КонецЕсли;
		ЗаписатьКурс(Валюта, Дата, СтрокаКурса.Курс, СтрокаКурса.Номинал,
			"bank", Статус);
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Точка входа регламентного задания: курсы на сегодня (task_113).
Функция ЗагрузитьКурсыНаСегодня() Экспорт

	Возврат ЗагрузитьКурсы(ТекущаяДатаСеанса());

КонецФункции

// Последний применённый курс валюты на дату (аномалии не участвуют).
Функция КурсНаДату(Валюта, Дата) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Курсы.Курс / Курсы.Номинал КАК Курс
	|ИЗ РегистрСведений.КурсыВалют КАК Курсы
	|ГДЕ Курсы.Валюта = &Валюта И Курсы.ДатаКурса <= &Дата
	|	И Курсы.СтатусКурса = &Применён
	|УПОРЯДОЧИТЬ ПО Курсы.ДатаКурса УБЫВ";
	Запрос.УстановитьПараметр("Валюта", Валюта);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Применён", "применён");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Курс;
	КонецЕсли;

	Возврат 0;

КонецФункции

// Сумма документа в базовой валюте по локальному курсу на дату
// документа. Живой вызов API здесь запрещён политикой модуля.
Функция СуммаВБазовойВалюте(Сумма, Валюта, Дата) Экспорт

	Курс = КурсНаДату(Валюта, Дата);
	Если Курс = 0 Тогда
		ВызватьИсключение "RIH-422: нет локального курса " + Валюта
			+ " на " + Формат(Дата, "ДФ=yyyy-MM-dd");
	КонецЕсли;

	Возврат Сумма * Курс;

КонецФункции

#КонецОбласти

#Область Служебные

// Одна запись курса: факт на дату с источником и статусом.
Процедура ЗаписатьКурс(Валюта, Дата, Курс, Номинал, Источник, Статус)

	Запись = РегистрыСведений.КурсыВалют.СоздатьМенеджерЗаписи();
	Запись.Валюта = Валюта;
	Запись.ДатаКурса = Дата;
	Запись.Курс = Курс;
	Запись.Номинал = Номинал;
	Запись.Источник = Источник;
	Запись.СтатусКурса = Статус;
	Запись.Записать();

КонецПроцедуры

#КонецОбласти
