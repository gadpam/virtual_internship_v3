// РИХ_Интеграции (task_81/83/84): ядро HTTP-сервиса РИХ_Обмен.
// Маршруты тонкие: вся логика здесь, поэтому тестируется без веб-сервера.

#Область Аутентификация

// Проверяет X-Api-Key запроса: ключ сравнивается по SHA-256 хешу
// с РС КлючиДоступаИнтеграций (сами ключи в базе не хранятся).
// После 5 неудач за 10 минут пара (сервис, адрес) блокируется на 15 минут.
//
// Параметры:
//   Запрос - HTTPСервисЗапрос.
//
// Возвращаемое значение:
//   Булево - ключ допустим.
//
Функция КлючДопустим(Запрос) Экспорт

	// Единая точка входа сервиса (task_133): сначала Bearer-токен
	// (РИХ_Токены), затем API-ключ переходного периода. Маршруты
	// не проверяют доступ каждый по-своему: забытый маршрут
	// невозможен, пока проверка живёт здесь, а не в обработчиках.
	Если РИХ_Токены.ТокенДопустим(Запрос) Тогда
		Возврат Истина;
	КонецЕсли;

	Ключ = Запрос.Заголовки.Получить("X-Api-Key");
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если БлокировкаАктивна("shop", АдресКлиента(Запрос)) Тогда
		ЗаписатьВызов("shop", "auth", "in", "", 429, "RIH-429",
			0, "блокировка перебора");
		Возврат Ложь;
	КонецЕсли;

	Хеш = ХешКлюча(Ключ);
	ЗапросКлючей = Новый Запрос;
	ЗапросКлючей.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Ключи.Активен КАК Активен
	|ИЗ РегистрСведений.КлючиДоступаИнтеграций КАК Ключи
	|ГДЕ Ключи.Сервис = &Сервис И Ключи.ХешКлюча = &Хеш";
	ЗапросКлючей.УстановитьПараметр("Сервис", "shop");
	ЗапросКлючей.УстановитьПараметр("Хеш", Хеш);
	Выборка = ЗапросКлючей.Выполнить().Выбрать();

	Допустим = Выборка.Следующий() И Выборка.Активен;
	Если НЕ Допустим Тогда
		// Неудача пишется в журнал: по нему работает блокировка перебора
		ЗаписатьВызов("shop", "auth", "in", "", 401, "RIH-401",
			0, "неверный ключ с " + АдресКлиента(Запрос));
	КонецЕсли;

	Возврат Допустим;

КонецФункции

// SHA-256 хеш строки ключа в Base64: в базе и логах живут только хеши.
Функция ХешКлюча(Ключ) Экспорт

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Ключ);

	Возврат ПолучитьBase64СтрокуИзДвоичныхДанных(Хеширование.ХешСумма);

КонецФункции

// Истина, если за последние 10 минут с адреса было 5+ неудачных ключей
// и с последней неудачи прошло меньше 15 минут.
Функция БлокировкаАктивна(Сервис, Адрес)

	ЗапросЖурнала = Новый Запрос;
	ЗапросЖурнала.Текст =
	"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Неудач, МАКСИМУМ(Журнал.Дата) КАК Последняя
	|ИЗ РегистрСведений.ЖурналИнтеграций КАК Журнал
	|ГДЕ Журнал.Сервис = &Сервис И Журнал.Статус = 401
	|	И Журнал.Дата >= &Порог И Журнал.Контекст ПОДОБНО &АдресШаблон";
	ЗапросЖурнала.УстановитьПараметр("Сервис", Сервис);
	ЗапросЖурнала.УстановитьПараметр("Порог", ТекущаяДатаСеанса() - 600);
	ЗапросЖурнала.УстановитьПараметр("АдресШаблон", "%" + Адрес + "%");
	Выборка = ЗапросЖурнала.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Неудач >= 5
		И ТекущаяДатаСеанса() - Выборка.Последняя < 900;

КонецФункции

// Адрес клиента из запроса (за nginx стенда — первый X-Forwarded-For).
Функция АдресКлиента(Запрос)

	Переданный = Запрос.Заголовки.Получить("X-Forwarded-For");
	Если ЗначениеЗаполнено(Переданный) Тогда
		Возврат СокрЛП(СтрРазделить(Переданный, ",")[0]);
	КонецЕсли;

	Возврат "unknown";

КонецФункции

// Очистка журнала интеграций старше 90 дней (task_84): журнал —
// оперативный инструмент разбора, а не вечный архив; старые payload
// к этому моменту уже не нужны ни поддержке, ни аудиту интеграций.
Процедура ОчиститьЖурналИнтеграций() Экспорт

	Порог = ТекущаяДатаСеанса() - 90 * 86400;
	Набор = РегистрыСведений.ЖурналИнтеграций.СоздатьНаборЗаписей();
	Набор.Отбор.Период.Установить(Новый Граница(Порог, ВидГраницы.Исключая), Истина);
	Набор.Очистить();
	Набор.Записать();

КонецПроцедуры

#КонецОбласти

#Область Заказы

// Принимает заказ магазина идемпотентно: повтор того же внешнего
// идентификатора возвращает существующий заказ, а не второй документ.
//
// Параметры:
//   Данные - Структура - разобранный JSON {external_id, lines[]}.
//
// Возвращаемое значение:
//   Структура - КодОтвета (201/200/422), Тело ответа.
//
Функция ПринятьЗаказМагазина(Данные) Экспорт

	Ошибки = ОшибкиЗаказа(Данные);
	Если Ошибки.Количество() > 0 Тогда
		ТелоОшибки = Новый Структура("code,message,details",
			"RIH-422", "Заказ не проходит валидацию", Ошибки);
		Возврат Новый Структура("КодОтвета,Тело", 422, ТелоОшибки);
	КонецЕсли;

	Существующий = НайтиЗаказПоВнешнемуИД(Данные.external_id);
	Если Существующий <> Неопределено Тогда
		ТелоОтвета = ТелоЗаказа(Существующий);
		ТелоОтвета.Вставить("duplicate", Истина);
		Возврат Новый Структура("КодОтвета,Тело", 200, ТелоОтвета);
	КонецЕсли;

	Документ = Документы.ЗаказКлиента.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.ВнешнийИдентификатор = Данные.external_id;
	Документ.Статус = Перечисления.СтатусыЗаказаКлиента.Новый;
	Для Каждого СтрокаЗаказа Из Данные.lines Цикл
		СтрокаДокумента = Документ.Товары.Добавить();
		СтрокаДокумента.Номенклатура = НайтиТоварПоАртиклу(СтрокаЗаказа.sku);
		СтрокаДокумента.Количество = СтрокаЗаказа.quantity;
		СтрокаДокумента.Цена = СтрокаЗаказа.price;
		СтрокаДокумента.Сумма = СтрокаЗаказа.quantity * СтрокаЗаказа.price;
	КонецЦикла;
	Документ.Записать();

	ТелоОтвета = ТелоЗаказа(Документ.Ссылка);
	ТелоОтвета.Вставить("duplicate", Ложь);

	Возврат Новый Структура("КодОтвета,Тело", 201, ТелоОтвета);

КонецФункции

// Принимает пачку заказов: каждый элемент независим, частичный успех —
// норма; ответ содержит статус по каждому заказу.
//
// Параметры:
//   Данные - Структура - {orders: [заказ, ...]}.
//
// Возвращаемое значение:
//   Структура - {total, accepted, results[]}.
//
Функция ПринятьПакетЗаказов(Данные) Экспорт

	Результаты = Новый Массив;
	Принято = 0;
	Для Каждого Заказ Из Данные.orders Цикл
		Результат = ПринятьЗаказМагазина(Заказ);
		Если Результат.КодОтвета < 300 Тогда
			Принято = Принято + 1;
		КонецЕсли;
		Элемент = Новый Структура("externalId,httpStatus",
			Заказ.external_id, Результат.КодОтвета);
		Результаты.Добавить(Элемент);
	КонецЦикла;

	Возврат Новый Структура("total,accepted,results",
		Данные.orders.Количество(), Принято, Результаты);

КонецФункции

// Смена статуса заказа по внешнему идентификатору.
//
// Параметры:
//   ВнешнийИД - Строка;
//   Статус    - Строка - new|reserved|shipped|delivered|cancelled.
//
// Возвращаемое значение:
//   Структура, Неопределено - тело заказа или Неопределено, если нет заказа.
//
Функция СменитьСтатусЗаказа(ВнешнийИД, Статус) Экспорт

	Ссылка = НайтиЗаказПоВнешнемуИД(ВнешнийИД);
	Если Ссылка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Соответствие = Новый Соответствие;
	Соответствие.Вставить("new", Перечисления.СтатусыЗаказаКлиента.Новый);
	Соответствие.Вставить("reserved", Перечисления.СтатусыЗаказаКлиента.Зарезервирован);
	Соответствие.Вставить("shipped", Перечисления.СтатусыЗаказаКлиента.Отгружен);
	Соответствие.Вставить("delivered", Перечисления.СтатусыЗаказаКлиента.Доставлен);
	Соответствие.Вставить("cancelled", Перечисления.СтатусыЗаказаКлиента.Отменён);
	НовоеЗначение = Соответствие.Получить(НизРег(Статус));
	Если НовоеЗначение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Объект = Ссылка.ПолучитьОбъект();
	Объект.Статус = НовоеЗначение;
	Объект.Записать();

	Возврат ТелоЗаказа(Ссылка);

КонецФункции

// Список заказов для GET /orders, при заданном статусе — с отбором.
Функция СписокЗаказов(ПараметрыURL) Экспорт

	ЗапросЗаказов = Новый Запрос;
	ЗапросЗаказов.Текст =
	"ВЫБРАТЬ Заказы.ВнешнийИдентификатор КАК ВнешнийИД, Заказы.Статус КАК Статус,
	|	Заказы.Дата КАК Дата
	|ИЗ Документ.ЗаказКлиента КАК Заказы
	|УПОРЯДОЧИТЬ ПО Заказы.Дата";
	Выборка = ЗапросЗаказов.Выполнить().Выбрать();

	Элементы = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Элементы.Добавить(Новый Структура("externalId,status",
			Выборка.ВнешнийИД, Строка(Выборка.Статус)));
	КонецЦикла;

	Возврат Новый Структура("total,items", Элементы.Количество(), Элементы);

КонецФункции

// Валидация входящего заказа до создания документа: внешний ид,
// хотя бы одна строка, товар существует, количество и цена sane.
Функция ОшибкиЗаказа(Данные)

	Ошибки = Новый Массив;
	Если НЕ Данные.Свойство("external_id") ИЛИ НЕ ЗначениеЗаполнено(Данные.external_id) Тогда
		Ошибки.Добавить("не задан external_id");
		Возврат Ошибки;
	КонецЕсли;
	Если НЕ Данные.Свойство("lines") ИЛИ Данные.lines.Количество() = 0 Тогда
		Ошибки.Добавить("заказ без строк");
		Возврат Ошибки;
	КонецЕсли;
	Для Каждого СтрокаЗаказа Из Данные.lines Цикл
		Если НайтиТоварПоАртиклу(СтрокаЗаказа.sku) = Неопределено Тогда
			Ошибки.Добавить("товар не найден: " + СтрокаЗаказа.sku);
		КонецЕсли;
		Если СтрокаЗаказа.quantity <= 0 Тогда
			Ошибки.Добавить("количество должно быть больше 0: " + СтрокаЗаказа.sku);
		КонецЕсли;
		Если СтрокаЗаказа.price < 0 Тогда
			Ошибки.Добавить("цена не может быть отрицательной: " + СтрокаЗаказа.sku);
		КонецЕсли;
	КонецЦикла;

	Возврат Ошибки;

КонецФункции

// Ищет заказ по внешнему идентификатору магазина.
Функция НайтиЗаказПоВнешнемуИД(ВнешнийИД)

	ЗапросПоиска = Новый Запрос;
	ЗапросПоиска.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Заказы.Ссылка КАК Ссылка
	|ИЗ Документ.ЗаказКлиента КАК Заказы
	|ГДЕ Заказы.ВнешнийИдентификатор = &ВнешнийИД";
	ЗапросПоиска.УстановитьПараметр("ВнешнийИД", ВнешнийИД);
	Выборка = ЗапросПоиска.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Ищет товар по артиклу (артикул — стабильный ключ обмена, задача 17).
Функция НайтиТоварПоАртиклу(Артикул)

	ЗапросПоиска = Новый Запрос;
	ЗапросПоиска.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Товары.Ссылка КАК Ссылка
	|ИЗ Справочник.Номенклатура КАК Товары
	|ГДЕ Товары.Артикул = &Артикул И НЕ Товары.ПометкаУдаления";
	ЗапросПоиска.УстановитьПараметр("Артикул", Артикул);
	Выборка = ЗапросПоиска.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Тело ответа по заказу в терминах контракта (camelCase наружу).
Функция ТелоЗаказа(ЗаказСсылка)

	ЗапросИтога = Новый Запрос;
	ЗапросИтога.Текст =
	"ВЫБРАТЬ СУММА(Товары.Сумма) КАК Итого
	|ИЗ Документ.ЗаказКлиента.Товары КАК Товары
	|ГДЕ Товары.Ссылка = &Ссылка";
	ЗапросИтога.УстановитьПараметр("Ссылка", ЗаказСсылка);
	Выборка = ЗапросИтога.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Новый Структура("externalId,status,total",
		ЗаказСсылка.ВнешнийИдентификатор,
		НизРег(Строка(ЗаказСсылка.Статус)),
		?(Выборка.Итого = Null, 0, Выборка.Итого));

КонецФункции

#КонецОбласти

#Область Журнал

// Единая точка записи журнала интеграций: маршруты не пишут журнал
// сами, поэтому забыть запись нельзя. Большой payload (>4 КБ) уходит
// во внешнее хранилище, в базе остаётся ссылка на него (task_84).
//
// Параметры:
//   Сервис     - Строка - shop|loyalty|tk|bank;
//   Операция   - Строка - например "POST /orders";
//   Направление - Строка - in|out;
//   ВнешнийИД  - Строка - идентификатор партнёра, если есть;
//   Статус     - Число - HTTP-статус исхода;
//   КодОшибки  - Строка - код справочника ошибок RIH, пусто при успехе;
//   ДлительностьМС - Число;
//   Контекст   - Строка - короткий контекст без секретов и ПДн.
//
Процедура ЗаписатьВызов(Сервис, Операция, Направление, ВнешнийИД,
		Статус, КодОшибки, ДлительностьМС, Контекст = "") Экспорт

	Запись = РегистрыСведений.ЖурналИнтеграций.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.ИдентификаторВызова = Новый УникальныйИдентификатор;
	Запись.Сервис = Сервис;
	Запись.Операция = Операция;
	Запись.Направление = Направление;
	Запись.ВнешнийИдентификатор = ВнешнийИД;
	Запись.Статус = Статус;
	Запись.КодОшибки = КодОшибки;
	Запись.ДлительностьМС = ДлительностьМС;
	Запись.Контекст = Контекст;
	Запись.Записать();

КонецПроцедуры

#КонецОбласти
