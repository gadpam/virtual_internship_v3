// РИХ_ПерсональныеДанные (task_135): единственное место работы
// с персональными данными «на показ» в проекте. Правило простое:
// журнал, отчёт и экран не маскируют «где вспомнили» — они зовут
// этот модуль. Кто зовёт сам, тот завтра забудет, и лог снова
// уедет с открытым телефоном. Реестр категорий ПДн, оснований
// и сроков — documentation/security/pdn_registry.md.
//
// Интерфейс делится по правам: лог маскирует всегда; интерфейс —
// через ПоказатьПолностью с отдельной ролью, потому что оператору
// иногда нужен полный номер. Каждое полное показание — событие
// аудита (task_137), не тихая привилегия.

#Область ПрограммныйИнтерфейс

// Маска телефона: первая и последние две цифры, середина скрыта.
// Формат — вида «8-***-**-12»: по маске клиента узнают, номер — нет.
Функция МаскироватьТелефон(Телефон) Экспорт

	Цифры = ТолькоЦифры(Телефон);
	Если СтрДлина(Цифры) < 4 Тогда
		Возврат "***";
	КонецЕсли;
	Возврат Лев(Цифры, 1) + "-***-**-" + Прав(Цифры, 2);

КонецФункции

// Маска карты: видны только последние четыре цифры — по ним
// поддержка находит карту, по полной карте находит мошенник.
Функция МаскироватьКарту(НомерКарты) Экспорт

	Цифры = ТолькоЦифры(НомерКарты);
	Если СтрДлина(Цифры) < 4 Тогда
		Возврат "****";
	КонецЕсли;
	Возврат "**** **** **** " + Прав(Цифры, 4);

КонецФункции

// Маскирование для интерфейса с учётом прав: полный номер —
// только роли полного доступа к ПДн, остальным — маска.
// Конструкция «проверил роль в форме» запрещена: форма убежит,
// а следующий отчёт роль не проверит.
Функция ТелефонДляПоказа(Телефон, ПолныйДоступ) Экспорт

	Если ПолныйДоступ Тогда
		Возврат Телефон;
	КонецЕсли;
	Возврат МаскироватьТелефон(Телефон);

КонецФункции

// Санитизация свободного текста перед записью в журнал: находит
// телефоны и номера карт по формату и заменяет масками. Это
// последний рубеж журнала (РИХ_Интеграции.ЗаписатьВызов зовёт
// санитайзер сам): даже если вызывающий по ошибке положил в
// контекст payload, в регистр уедет маска, а не данные.
Функция ОчиститьТекстЖурнала(Текст) Экспорт

	Результат = Строка(Текст);
	Для Каждого Фрагмент Из ШаблоныПДнВТексте(Результат) Цикл
		Результат = СтрЗаменить(Результат, Фрагмент.Открытое,
			Фрагмент.Маска);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Хеш для поиска без хранения: чувствительный реквизит (номер
// карты) хранится хешем SHA-256 — поиск по полному номеру идёт
// сравнением хешей, а открытое значение не лежит в базе и не
// светится в журнале. Утечка базы даёт хеши, а не карты.
Функция ХешРеквизита(Значение) Экспорт

	Возврат РИХ_Интеграции.ХешКлюча(Строка(Значение));

КонецФункции

// Обезличивание по запросу субъекта (процесс — pdn_registry.md):
// персональные поля заменяются необратимыми заглушками, учётные
// факты (чеки, баллы, суммы) сохраняются — их требует архивный
// закон, и они перестают быть персональными без связки с лицом.
// Удаление «в ноль» ломает бухгалтерию; обезличивание — рабочий
// компромисс, и оно необратимо по построению.
Функция ОбезличитьКлиентаЛояльности(Клиент, Пользователь = "система") Экспорт

	Клиент.Телефон = "";
	Клиент.ХешНомераКарты = ХешРеквизита("обезличено-" + Строка(Клиент.Код));
	Клиент.АдресДоставки = "";
	Клиент.Комментарий = "обезличено по запросу субъекта, "
		+ Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd");
	Клиент.Записать();
	РИХ_Интеграции.ЗаписатьВызов("loyalty", "pdn-erasure", "in",
		Строка(Клиент.Код), 200, "", 0,
		"обезличивание выполнено; учётные факты сохранены");
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТолькоЦифры(Значение)

	Результат = "";
	Для Позиция = 1 По СтрДлина(Строка(Значение)) Цикл
		Символ = Сред(Строка(Значение), Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Шаблоны поиска ПДн в свободном тексте. На зеркале формата
// (checks_pdn.py) те же шаблоны гоняются по реальным журналам.
// Платформенная реализация перебора цифр короче и предсказуемее
// регулярных выражений, которых в языке нет.
Функция ШаблоныПДнВТексте(Текст)

	Найденные = Новый Массив;
	ЦифрыТекста = "";
	НачалоФрагмента = 0;
	Для Позиция = 1 По СтрДлина(Текст) + 1 Цикл
		Символ = ?(Позиция <= СтрДлина(Текст),
			Сред(Текст, Позиция, 1), " ");
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Если НачалоФрагмента = 0 Тогда
				НачалоФрагмента = Позиция;
			КонецЕсли;
			ЦифрыТекста = ЦифрыТекста + Символ;
		ИначеЕсли СтрНайти("+-() ", Символ) = 0 ИЛИ Позиция > СтрДлина(Текст) Тогда
			Если СтрДлина(ЦифрыТекста) >= 10 Тогда
				Открытое = Сред(Текст, НачалоФрагмента,
					Позиция - НачалоФрагмента);
				Маска = ?(СтрДлина(ЦифрыТекста) >= 13,
					МаскироватьКарту(ЦифрыТекста),
					МаскироватьТелефон(ЦифрыТекста));
				Найденные.Добавить(Новый Структура("Открытое,Маска",
					СокрЛП(Открытое), Маска));
			КонецЕсли;
			ЦифрыТекста = "";
			НачалоФрагмента = 0;
		КонецЕсли;
	КонецЦикла;
	Возврат Найденные;

КонецФункции

#КонецОбласти
