#Область СлужебныеПроцедурыИФункции

// Возвращает версию стартовой заготовки конфигурации и состав окружения.
// Используется в HTTP-сервисе /health (задание task_79).
//
// Возвращаемое значение:
//   Структура - Ключи: ВерсияКонфигурации, ВерсияПлатформы, ДатаСервера, РежимОтладки
//
Функция СведенияОбОкружении() Экспорт

	Сведения = Новый Структура;
	Сведения.Вставить("ВерсияКонфигурации", Метаданные.Версия);
	Сведения.Вставить("ВерсияПлатформы", СистемнаяИнформация.ВерсияПриложения);
	Сведения.Вставить("ДатаСервера", ТекущаяДатаСеанса());
	Сведения.Вставить("РежимОтладки", РежимОтладки());

	Возврат Сведения;

КонецФункции

// Первая учебная функция (задание task_2).
// Модуль серверный, поэтому Сообщить() здесь не вызываем (правило R002
// линтера): функция возвращает текст отчёта, а пользователю его показывает
// вызывающий код на клиенте (внешняя обработка, форма):
//   Сообщить(РИХ_ОбщегоНазначения.ПроверитьОкружение());
//
// Возвращаемое значение:
//   Строка - однострочный отчёт об окружении: версии, строка соединения
//            информационной базы и имя текущего пользователя.
//
Функция ПроверитьОкружение() Экспорт

	Сведения = СведенияОбОкружении();
	Возврат СтрШаблон("RIH: версия %1, платформа %2; база: %3; пользователь: %4",
		Сведения.ВерсияКонфигурации,
		Сведения.ВерсияПлатформы,
		СтрокаСоединенияИнформационнойБазы(),
		ИмяПользователя());

КонецФункции

// КонецОбласти

// Группирует строки таблицы значений по значению указанной колонки.
// Один проход по таблице: ключ Соответствия — значение колонки, значение —
// массив строк этой группы в исходном порядке. Ключом нельзя брать
// наименование строкой, если есть ссылка: переименовали объект —
// и «словарь» рассыпался на две группы.
//
// Параметры:
//   Таблица   - ТаблицаЗначений - строки для группировки;
//   ИмяКолонки - Строка - имя колонки, по которой группируем.
//
// Возвращаемое значение:
//   Соответствие - ключ: значение колонки; значение: Массив строк таблицы.
//
Функция СгруппироватьПоСвойству(Таблица, ИмяКолонки) Экспорт

	Группы = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Ключ = СтрокаТаблицы[ИмяКолонки];
		СтрокиГруппы = Группы.Получить(Ключ);
		Если СтрокиГруппы = Неопределено Тогда
			СтрокиГруппы = Новый Массив;
			Группы.Вставить(Ключ, СтрокиГруппы);
		КонецЕсли;
		СтрокиГруппы.Добавить(СтрокаТаблицы);
	КонецЦикла;

	Возврат Группы;

КонецФункции

// Возвращает значения, встречающиеся в массиве больше одного раза.
// Один проход через Соответствие «видели ключ или нет»: сложность O(n)
// в среднем против O(n^2) у наивного сравнения каждого с каждым
// (на 100 000 элементов это разница между секундами и минутами).
//
// Параметры:
//   Элементы - Массив - значения любого типа, сравнимые как ключи
//              Соответствия (число, строка, ссылка).
//
// Возвращаемое значение:
//   Массив - каждое дублирующееся значение один раз, в порядке
//            первого повторного появления.
//
Функция НайтиДубликаты(Элементы) Экспорт

	Виденные = Новый Соответствие;
	УжеВДублях = Новый Соответствие;
	Дубликаты = Новый Массив;

	Для Каждого Элемент Из Элементы Цикл
		Если Виденные.Получить(Элемент) = Неопределено Тогда
			Виденные.Вставить(Элемент, Истина);
		ИначеЕсли УжеВДублях.Получить(Элемент) = Неопределено Тогда
			УжеВДублях.Вставить(Элемент, Истина);
			Дубликаты.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	Возврат Дубликаты;

КонецФункции

#Область ЗаготовкиПодЗадания

// Распределяет сумму пропорционально весам так, чтобы сумма частей
// равнялась исходной сумме ровно. Наивное округление каждой части теряет
// копейку (100 на троих = 33.33*3 = 99.99); здесь все части, кроме части
// с наибольшим весом, округляются обычно, а она получает остаток:
// ИсходнаяСумма - СуммаОстальных. Сходимость гарантирована конструкцией.
//
// Параметры:
//   Сумма    - Число - распределяемая сумма (деньги — с точностью 2);
//   Веса     - Массив - неотрицательные веса частей (количества, суммы строк);
//   Точность - Число - знаков после запятой у частей (деньги — 2, количество — 3).
//
// Возвращаемое значение:
//   Массив - части по порядку весов; сумма частей равна Сумма ровно.
//
// Исключения:
//   Если сумма весов нулевая, а сумма ненулевая — распределение невозможно.
//
Функция РаспределитьСумму(Сумма, Веса, Точность) Экспорт

	Части = Новый Массив;
	СуммаВесов = 0;
	ИндексНаибольшего = 0;
	Для Индекс = 0 По Веса.ВГраница() Цикл
		СуммаВесов = СуммаВесов + Веса[Индекс];
		Если Веса[Индекс] > Веса[ИндексНаибольшего] Тогда
			ИндексНаибольшего = Индекс;
		КонецЕсли;
		Части.Добавить(0);
	КонецЦикла;

	Если СуммаВесов = 0 Тогда
		Если Сумма = 0 Тогда
			Возврат Части;
		КонецЕсли;
		ВызватьИсключение "РаспределитьСумму: сумма весов равна нулю при ненулевой сумме";
	КонецЕсли;

	Распределено = 0;
	Для Индекс = 0 По Веса.ВГраница() Цикл
		Если Индекс = ИндексНаибольшего Тогда
			Продолжить;
		КонецЕсли;
		Части[Индекс] = Окр(Сумма * Веса[Индекс] / СуммаВесов, Точность);
		Распределено = Распределено + Части[Индекс];
	КонецЦикла;
	Части[ИндексНаибольшего] = Сумма - Распределено;

	Возврат Части;

КонецФункции

// Возвращает сумму с НДС по сумме без налога: Сумма * (100 + Ставка) / 100.
// Округляется результат операции (до копеек), а не только итог документа:
// бухгалтерия сверяет документы построчно.
//
// Параметры:
//   СуммаБезНДС - Число - сумма без налога;
//   СтавкаНДС   - Число - ставка в процентах (20 — это 20%, не 0.2).
//
// Возвращаемое значение:
//   Число - сумма с НДС, округлённая до 2 знаков.
//
Функция СуммаВД(СуммаБезНДС, СтавкаНДС) Экспорт

	Возврат Окр(СуммаБезНДС * (100 + СтавкаНДС) / 100, 2);

КонецФункции

// Возвращает сумму без НДС, выделяя налог из суммы с налогом:
// СуммаСНДС * 100 / (100 + Ставка) — зеркальная формула (для 20% это
// знаменитое «умножить на 20/120» для самого налога).
//
// Параметры:
//   СуммаСНДС - Число - сумма с налогом;
//   СтавкаНДС - Число - ставка в процентах.
//
// Возвращаемое значение:
//   Число - сумма без НДС, округлённая до 2 знаков.
//
Функция СуммаБезНДС(СуммаСНДС, СтавкаНДС) Экспорт

	Возврат Окр(СуммаСНДС * 100 / (100 + СтавкаНДС), 2);

КонецФункции

// Форматирует дату (в UTC) в строку ISO 8601 вида 2026-01-31T21:00:00Z.
// Локальную дату сеанса сначала переводят в UTC (РИХ_Дата.ВУниверсальную):
// суффикс Z честен только для универсального времени.
//
// Параметры:
//   Дата - Дата - мгновение в UTC.
//
// Возвращаемое значение:
//   Строка - ISO 8601 с суффиксом Z.
//
Функция СформироватьIso8601(Дата) Экспорт

	Возврат Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z";

КонецФункции

// Разбирает строку ISO 8601 в дату UTC. Понимает суффикс Z, смещение
// ±ЧЧ:ММ и необязательные миллисекунды. Локальное время из результата
// получают через РИХ_Дата.ИзУниверсальной.
//
// Параметры:
//   Строка - Строка - дата ISO 8601, например "2026-01-31T21:00:00.500Z".
//
// Возвращаемое значение:
//   Дата - мгновение в UTC.
//
// Исключения:
//   Некорректный формат — исключение с текстом исходной строки.
//
Функция РазобратьIso8601(Строка) Экспорт

	Текст = СокрЛП(Строка);
	Попытка
		Год = Число(Сред(Текст, 1, 4));
		Месяц = Число(Сред(Текст, 6, 2));
		День = Число(Сред(Текст, 9, 2));
		Часы = Число(Сред(Текст, 12, 2));
		Минуты = Число(Сред(Текст, 15, 2));
		Секунды = Число(Сред(Текст, 18, 2));
	Исключение
		ВызватьИсключение СтрШаблон("Некорректная дата ISO 8601: %1", Строка);
	КонецПопытки;

	Результат = Дата(Год, Месяц, День, Часы, Минуты, Секунды);

	Остаток = Сред(Текст, 20);
	Если Остаток = "Z" ИЛИ Остаток = "" Тогда
		Возврат Результат;
	КонецЕсли;

	// Смещение вида +03:00 / -05:00 (миллисекунды перед ним уже отброшены
	// позициями выше: дробная часть не влияет на секунды результата платформы).
	Знак = Лев(Остаток, 1);
	Если Знак <> "+" И Знак <> "-" Тогда
		ВызватьИсключение СтрШаблон("Некорректное смещение ISO 8601: %1", Строка);
	КонецЕсли;
	СдвигСекунд = Число(Сред(Остаток, 2, 2)) * 3600 + Число(Сред(Остаток, 5, 2)) * 60;
	Если Знак = "+" Тогда
		Результат = Результат - СдвигСекунд;
	Иначе
		Результат = Результат + СдвигСекунд;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает новый GUID строкой (36 символов с дефисами). В интеграциях
// GUID — внешний идентификатор записи (externalId), не зависящий
// от кодов двух систем.
//
// Возвращаемое значение:
//   Строка - например "6f9619ff-8b86-d011-b42d-00c04fc964ff".
//
Функция НовыйGuid() Экспорт

	Возврат Строка(Новый УникальныйИдентификатор());

КонецФункции

// Проверяет, что строка является корректным GUID. Конструктор
// УникальныйИдентификатор падает на мусоре, поэтому проверка честно
// обёрнута в Попытку: невалидная строка — это Ложь, а не исключение.
// Сравнивать GUID как строки в разных регистрах нельзя: "AB..." и "ab..."
// — один идентификатор.
//
// Параметры:
//   Строка - Строка - проверяемое значение.
//
// Возвращаемое значение:
//   Булево - Истина, если строка разбирается как УникальныйИдентификатор.
//
Функция ЭтоВалидныйGuid(Строка) Экспорт

	Попытка
		Идентификатор = Новый УникальныйИдентификатор(СокрЛП(Строка));
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Разбирает CSV-текст в массив строк (каждая строка — массив полей).
// Конечный автомат по RFC 4180: значение в двойных кавычках может содержать
// разделитель, перевод строки и удвоенную кавычку ("") как саму кавычку.
// Наивный СтрРазделить на такой строке возвращает лишние поля
// (см. проверки task_17: строка с запятой внутри кавычек).
//
// Параметры:
//   Текст       - Строка - весь CSV-текст;
//   Разделитель - Строка - один символ (";" для наших файлов).
//
// Возвращаемое значение:
//   Массив - строки; каждая строка — Массив полей (Строка).
//
Функция РазобратьCsv(Текст, Разделитель) Экспорт

	Строки = Новый Массив;
	ТекущаяСтрока = Новый Массив;
	Поле = "";
	ВКавычках = Ложь;
	Позиция = 1;
	Длина = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ВКавычках Тогда
			Если Символ = """" Тогда
				Если Сред(Текст, Позиция + 1, 1) = """" Тогда
					Поле = Поле + """";
					Позиция = Позиция + 1;
				Иначе
					ВКавычках = Ложь;
				КонецЕсли;
			Иначе
				Поле = Поле + Символ;
			КонецЕсли;
		ИначеЕсли Символ = """" И Поле = "" Тогда
			ВКавычках = Истина;
		ИначеЕсли Символ = Разделитель Тогда
			ТекущаяСтрока.Добавить(Поле);
			Поле = "";
		ИначеЕсли Символ = Символы.ПС Тогда
			ТекущаяСтрока.Добавить(Поле);
			Поле = "";
			Строки.Добавить(ТекущаяСтрока);
			ТекущаяСтрока = Новый Массив;
		ИначеЕсли Символ <> Символы.ВК Тогда
			Поле = Поле + Символ;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Если Поле <> "" ИЛИ ТекущаяСтрока.Количество() > 0 Тогда
		ТекущаяСтрока.Добавить(Поле);
		Строки.Добавить(ТекущаяСтрока);
	КонецЕсли;

	Возврат Строки;

КонецФункции

// Возвращает склады указанного типа. Учебный запрос task_18: текст запроса —
// неизменный шаблон, значение приходит параметром &ТипСклада через
// УстановитьПараметр. Собранный конкатенацией текст ("...ГДЕ ТипСклада = '"
// + ПолеВвода + "'") запрещён стандартом: ввод пользователя не становится
// частью текста запроса (инъекция), а каждый уникальный текст платформа
// компилирует заново.
//
// Параметры:
//   ТипСклада - ПеречислениеСсылка.ТипыСкладов - с task_24 тип склада
//              перечисление, а не строка: опечатка в строке делала склад
//              невидимым для запросов, перечисление ловит её при записи.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки Наименование, ТипСклада.
//
Функция СкладыПоТипу(ТипСклада) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Склады.Наименование КАК Наименование,
		|	Склады.ТипСклада КАК ТипСклада
		|ИЗ
		|	Справочник.Склады КАК Склады
		|ГДЕ
		|	Склады.ТипСклада = &ТипСклада
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	Запрос.УстановитьПараметр("ТипСклада", ТипСклада);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

