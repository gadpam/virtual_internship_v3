#Область СлужебныеПроцедурыИФункции

// Возвращает версию стартовой заготовки конфигурации и состав окружения.
// Используется в HTTP-сервисе /health (задание task_79).
//
// Возвращаемое значение:
//   Структура - Ключи: ВерсияКонфигурации, ВерсияПлатформы, ДатаСервера, РежимОтладки
//
Функция СведенияОбОкружении() Экспорт

	Сведения = Новый Структура;
	Сведения.Вставить("ВерсияКонфигурации", Метаданные.Версия);
	Сведения.Вставить("ВерсияПлатформы", СистемнаяИнформация.ВерсияПриложения);
	Сведения.Вставить("ДатаСервера", ТекущаяДатаСеанса());
	Сведения.Вставить("РежимОтладки", РежимОтладки());

	Возврат Сведения;

КонецФункции

// Первая учебная функция (задание task_2).
// Модуль серверный, поэтому Сообщить() здесь не вызываем (правило R002
// линтера): функция возвращает текст отчёта, а пользователю его показывает
// вызывающий код на клиенте (внешняя обработка, форма):
//   Сообщить(РИХ_ОбщегоНазначения.ПроверитьОкружение());
//
// Возвращаемое значение:
//   Строка - однострочный отчёт об окружении: версии, строка соединения
//            информационной базы и имя текущего пользователя.
//
Функция ПроверитьОкружение() Экспорт

	Сведения = СведенияОбОкружении();
	Возврат СтрШаблон("RIH: версия %1, платформа %2; база: %3; пользователь: %4",
		Сведения.ВерсияКонфигурации,
		Сведения.ВерсияПлатформы,
		СтрокаСоединенияИнформационнойБазы(),
		ИмяПользователя());

КонецФункции

// КонецОбласти

// Группирует строки таблицы значений по значению указанной колонки.
// Один проход по таблице: ключ Соответствия — значение колонки, значение —
// массив строк этой группы в исходном порядке. Ключом нельзя брать
// наименование строкой, если есть ссылка: переименовали объект —
// и «словарь» рассыпался на две группы.
//
// Параметры:
//   Таблица   - ТаблицаЗначений - строки для группировки;
//   ИмяКолонки - Строка - имя колонки, по которой группируем.
//
// Возвращаемое значение:
//   Соответствие - ключ: значение колонки; значение: Массив строк таблицы.
//
Функция СгруппироватьПоСвойству(Таблица, ИмяКолонки) Экспорт

	Группы = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Ключ = СтрокаТаблицы[ИмяКолонки];
		СтрокиГруппы = Группы.Получить(Ключ);
		Если СтрокиГруппы = Неопределено Тогда
			СтрокиГруппы = Новый Массив;
			Группы.Вставить(Ключ, СтрокиГруппы);
		КонецЕсли;
		СтрокиГруппы.Добавить(СтрокаТаблицы);
	КонецЦикла;

	Возврат Группы;

КонецФункции

// Возвращает значения, встречающиеся в массиве больше одного раза.
// Один проход через Соответствие «видели ключ или нет»: сложность O(n)
// в среднем против O(n^2) у наивного сравнения каждого с каждым
// (на 100 000 элементов это разница между секундами и минутами).
//
// Параметры:
//   Элементы - Массив - значения любого типа, сравнимые как ключи
//              Соответствия (число, строка, ссылка).
//
// Возвращаемое значение:
//   Массив - каждое дублирующееся значение один раз, в порядке
//            первого повторного появления.
//
Функция НайтиДубликаты(Элементы) Экспорт

	Виденные = Новый Соответствие;
	УжеВДублях = Новый Соответствие;
	Дубликаты = Новый Массив;

	Для Каждого Элемент Из Элементы Цикл
		Если Виденные.Получить(Элемент) = Неопределено Тогда
			Виденные.Вставить(Элемент, Истина);
		ИначеЕсли УжеВДублях.Получить(Элемент) = Неопределено Тогда
			УжеВДублях.Вставить(Элемент, Истина);
			Дубликаты.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	Возврат Дубликаты;

КонецФункции

