// РИХ_ФайловыйОбмен (task_88): приём файлов поставщика из каталога.
// Контроль целостности — marker-файл: контрольная сумма ловит порчу
// готового файла, но не отличает «ещё пишется» от «уже готов»; маркер
// отличает, поэтому готовность определяет он, сумма — второй контур.

#Область ПрограммныйИнтерфейс

// Один проход по каталогу incoming: обрабатывает только готовые файлы
// (есть &lt;имя&gt;.ok), успешные уходят в archive/, битые — в errors/.
// Файл без маркера не трогается: он ещё пишется поставщиком.
//
// Параметры:
//   КаталогОбмена - Строка - каталог с подкаталогами archive и errors.
//
// Возвращаемое значение:
//   Структура - Обработано, Ошибок, ПропущеноБезМаркера.
//
Функция ОбработатьКаталогПрайсов(КаталогОбмена) Экспорт

	Итог = Новый Структура("Обработано,Ошибок,ПропущеноБезМаркера", 0, 0, 0);
	Файлы = НайтиФайлы(КаталогОбмена, "*.csv");
	ДобавитьФайлыПоМаске(Файлы, КаталогОбмена, "*.xlsx");

	Для Каждого Файл Из Файлы Цикл
		Маркер = Новый Файл(Файл.ПолноеИмя + ".ok");
		Если НЕ Маркер.Существует() Тогда
			Итог.ПропущеноБезМаркера = Итог.ПропущеноБезМаркера + 1;
			Продолжить;
		КонецЕсли;

		Попытка
			Строки = ПрочитатьФайлПрайса(Файл);
			РИХ_ОбщегоНазначения.ОбработатьФайлПрайса(Файл.Имя, Строки);
			ПереместитьФайл(Файл.ПолноеИмя, КаталогОбмена + "archive/" + Файл.Имя);
			Итог.Обработано = Итог.Обработано + 1;
		Исключение
			ПереместитьФайл(Файл.ПолноеИмя, КаталогОбмена + "errors/" + Файл.Имя);
			Итог.Ошибок = Итог.Ошибок + 1;
			ЗаписьЖурналаРегистрации("РИХ.ФайловыйОбмен",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Битый файл " + Файл.Имя + " ушёл в errors: " + ОписаниеОшибки());
		КонецПопытки;
		УдалитьФайлы(Маркер.ПолноеИмя);
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Читает файл прайса в массив строк: CSV — текстом, XLSX — табличным
// документом. Формат определяется расширением, обработчик один.
//
// Параметры:
//   Файл - Файл - готовый файл прайса.
//
// Возвращаемое значение:
//   Массив - строки прайса без заголовка.
//
Функция ПрочитатьФайлПрайса(Файл) Экспорт

	Строки = Новый Массив;
	Если НРег(Файл.Расширение) = ".xlsx" Тогда
		ТабличныйДокумент = Новый ТабличныйДокумент;
		ТабличныйДокумент.Прочитать(Файл.ПолноеИмя);
		Для НомерСтроки = 2 По ТабличныйДокумент.ВысотаТаблицы Цикл
			Строки.Добавить(СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 1).Текст));
		КонецЦикла;
	Иначе
		Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
		Для Каждого СтрокаТекста Из СтрРазделить(Текст, Символы.ПС) Цикл
			Если ЗначениеЗаполнено(СокрЛП(СтрокаТекста)) Тогда
				Строки.Добавить(СтрокаТекста);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Строки;

КонецФункции

#КонецОбласти

#Область Служебные

// Добавляет в массив файлы каталога по второй маске (xlsx к csv).
Процедура ДобавитьФайлыПоМаске(Файлы, Каталог, Маска)

	Для Каждого Файл Из НайтиФайлы(Каталог, Маска) Цикл
		Файлы.Добавить(Файл);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
