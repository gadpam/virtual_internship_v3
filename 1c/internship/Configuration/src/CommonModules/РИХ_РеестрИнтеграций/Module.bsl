// РИХ_РеестрИнтеграций (task_120): каталог как инструмент управления.
// Реестр, который заполнили один раз, врёт через месяц, поэтому здесь
// живут отчёт угроз, история изменений и проверка релизного правила.

#Область ПрограммныйИнтерфейс

// Действующие потоки без владельца, документации или мониторинга
// и замороженные без даты решения: каждая строка — задача с владельцем.
Функция ИнтеграцииПодУгрозой() Экспорт

	Угрозы = НоваяТаблицаУгроз();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Потоки.Ссылка КАК Ссылка, Потоки.Код КАК Код,
	|	Потоки.Владелец КАК Владелец, Потоки.Документация КАК Документация,
	|	Потоки.Мониторинг КАК Мониторинг, Потоки.Критичность КАК Критичность,
	|	Потоки.СтатусЖизненногоЦикла КАК Статус, Потоки.ДатаВывода КАК ДатаВывода
	|ИЗ Справочник.Интеграции КАК Потоки
	|ГДЕ НЕ Потоки.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО Потоки.Код";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Причины = Новый Массив;
		Если Выборка.Статус <> "выведена из эксплуатации" Тогда
			Если НЕ ЗначениеЗаполнено(СокрЛП(Выборка.Владелец)) Тогда
				Причины.Добавить("нет владельца");
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СокрЛП(Выборка.Документация)) Тогда
				Причины.Добавить("нет документации");
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(СокрЛП(Выборка.Мониторинг)) Тогда
				Причины.Добавить("нет мониторинга");
			КонецЕсли;
		КонецЕсли;
		Если Выборка.Статус = "заморожена"
				И НЕ ЗначениеЗаполнено(Выборка.ДатаВывода) Тогда
			Причины.Добавить("заморожена без даты решения");
		КонецЕсли;
		Если Причины.Количество() > 0 Тогда
			СтрокаУгрозы = Угрозы.Добавить();
			СтрокаУгрозы.Интеграция = Выборка.Ссылка;
			СтрокаУгрозы.Код = Выборка.Код;
			СтрокаУгрозы.Причины = СтрСоединить(Причины, "; ");
			СтрокаУгрозы.Критичность = Выборка.Критичность;
		КонецЕсли;
	КонецЦикла;

	Возврат Угрозы;

КонецФункции

// Фиксирует изменение поля записи реестра в истории.
Процедура ЗаписатьИзменениеРеестра(Интеграция, Поле, СтароеЗначение,
		НовоеЗначение, Автор) Экспорт

	Запись = РегистрыСведений.ИсторияРеестраИнтеграций.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.Интеграция = Интеграция;
	Запись.Поле = Поле;
	Запись.СтароеЗначение = СтароеЗначение;
	Запись.НовоеЗначение = НовоеЗначение;
	Запись.Автор = Автор;
	Запись.Записать();

КонецПроцедуры

// Проверка релизного правила по коду потока: запись есть, владелец
// и документация заполнены. Ложь — интеграция к релизу не готова.
Функция ГотоваКРелизу(КодПотока) Экспорт

	Запись = Справочники.Интеграции.НайтиПоКоду(КодПотока);
	Если НЕ ЗначениеЗаполнено(Запись) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЗначениеЗаполнено(СокрЛП(Запись.Владелец))
		И ЗначениеЗаполнено(СокрЛП(Запись.Документация))
		И Запись.СтатусЖизненногоЦикла = "действует";

КонецФункции

// Сводка каталога для обзора: всего, по статусам, под угрозой.
Функция СводкаРеестра() Экспорт

	Угрозы = ИнтеграцииПодУгрозой();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Потоки.СтатусЖизненногоЦикла КАК Статус,
	|	КОЛИЧЕСТВО(Потоки.Ссылка) КАК Количество
	|ИЗ Справочник.Интеграции КАК Потоки
	|ГДЕ НЕ Потоки.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО Потоки.СтатусЖизненногоЦикла";
	Выборка = Запрос.Выполнить().Выбрать();
	Всего = 0;
	ПоСтатусам = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		ПоСтатусам.Вставить(Выборка.Статус, Выборка.Количество);
		Всего = Всего + Выборка.Количество;
	КонецЦикла;

	Возврат Новый Структура("Всего,ПоСтатусам,ПодУгрозой",
		Всего, ПоСтатусам, Угрозы.Количество());

КонецФункции

#КонецОбласти

#Область Служебные

// Пустая таблица результата отчёта угроз.
Функция НоваяТаблицаУгроз()

	Угрозы = Новый ТаблицаЗначений;
	Угрозы.Колонки.Добавить("Интеграция");
	Угрозы.Колонки.Добавить("Код");
	Угрозы.Колонки.Добавить("Причины");
	Угрозы.Колонки.Добавить("Критичность");
	Возврат Угрозы;

КонецФункции

#КонецОбласти
