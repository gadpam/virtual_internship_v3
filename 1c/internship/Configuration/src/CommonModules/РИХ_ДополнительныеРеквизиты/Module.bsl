// РИХ_ДополнительныеРеквизиты (task_179): свой механизм допреквизитов
// (БСП в RIH нет). Виды — ПВХ ДополнительныеРеквизиты, значения —
// РС по владельцу-объекту. Один вход для форм, отчётов, подборов
// и обменов: значение, которое не доезжает до отчёта или обмена,
// означает «механизм создан, но не подключён».

#Область ПрограммныйИнтерфейс

// Записывает значение допреквизита объекта. Вид проверяется по
// ПВХ: значение без владельца-объекта регистр не принимает.
Процедура УстановитьЗначение(Объект, ИмяРеквизита, Значение) Экспорт

	Запись = РегистрыСведений.ЗначенияДополнительныхРеквизитов.СоздатьМенеджерЗаписи();
	Запись.Объект = Объект;
	Запись.Реквизит = ИмяРеквизита;
	Запись.Значение = Значение;
	Запись.Записать();

КонецПроцедуры

// Читает значение для формы, отчёта или обмена — потребитель
// не ходит в регистр своим запросом.
Функция ПолучитьЗначение(Объект, ИмяРеквизита) Экспорт

	Запись = РегистрыСведений.ЗначенияДополнительныхРеквизитов.СоздатьМенеджерЗаписи();
	Запись.Объект = Объект;
	Запись.Реквизит = ИмяРеквизита;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Возврат Запись.Значение;
	КонецЕсли;

	Возврат "";

КонецФункции

// Значения объекта таблицей для подборов и обменов: обмен в
// магазин увозит допреквизиты тем же пакетом, что объект.
Функция ВсеЗначенияОбъекта(Объект) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Значения.Реквизит КАК Реквизит, Значения.Значение КАК Значение
	|ИЗ РегистрСведений.ЗначенияДополнительныхРеквизитов КАК Значения
	|ГДЕ Значения.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Объект);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти
