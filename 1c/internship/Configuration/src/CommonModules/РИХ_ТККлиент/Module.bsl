// РИХ_ТККлиент (task_93): доставка через mock_tk_api с уважением к лимиту.
// Политика: не более 4 одновременных соединений со стороны контура
// (для регламентных заданий — одно, параллелизм контролирует планировщик),
// 429 отрабатывает вызывающий через «Отложено», а не засыпанием сервера.

#Область ПрограммныйИнтерфейс

// Расчёт стоимости доставки. При 429 возвращает структуру с признаком
// Отложено и ПовторитьЧерезСекунд из Retry-After партнёра.
Функция РассчитатьСтоимость(Город, ВесКг, ОбъёмМ3) Экспорт

	Тело = Новый Структура("city_to,weight_kg,volume_m3",
		Город, ВесКг, ОбъёмМ3);
	Возврат ВызватьТК("POST", "/api/v1/calculate", Тело, "calculate");

КонецФункции

// Создание заявки; идемпотентность — по external_id заказа магазина.
Функция СоздатьЗаявку(ИдЗаказа, Город, ВесКг) Экспорт

	Тело = Новый Структура("external_id,city_to,weight_kg",
		ИдЗаказа, Город, ВесКг);
	Возврат ВызватьТК("POST", "/api/v1/shipments", Тело, "shipment-create");

КонецФункции

// Статус заявки. Опрос статусов — регламентный и редкий: лимит
// партнёра не расходуется пользовательскими перезагрузками формы.
Функция СтатусЗаявки(ИдЗаявки) Экспорт

	Возврат ВызватьТК("GET", "/api/v1/shipments/" + ИдЗаявки,
		Неопределено, "shipment-status");

КонецФункции

#КонецОбласти

#Область Служебные

// Вызов ТК по политике РИХ_ПовторныеПопытки (task_128): 5xx и сеть
// повторяются с экспонентой и джиттером; 429 — не повтор внутри
// вызова, а исход «Отложено» с Retry-After партнёра (task_93):
// крутить повторы вопреки его паузе — добивать больного своими же.
Функция ВызватьТК(Метод, Путь, Тело, Операция)

	// Предохранитель снаружи ретраев (task_129), как у лояльности.
	Если НЕ РИХ_Предохранители.РазрешитьВызов("tk") Тогда
		РИХ_Интеграции.ЗаписатьВызов("tk", Операция, "out", "",
			503, "RIH-BREAKER-OPEN", 0, "вызов отклонён предохранителем без сети");
		ВызватьИсключение РИХ_Предохранители.ТекстОткрытогоПредохранителя("tk");
	КонецЕсли;
	Политика = РИХ_ПовторныеПопытки.ПолитикаПоУмолчанию();
	ПопыткаНомер = 0;
	Пока ПопыткаНомер < Политика.МаксПопыток Цикл
		ПопыткаНомер = ПопыткаНомер + 1;
		Ответ = ОднаПопыткаТК(Метод, Путь, Тело, Операция, ПопыткаНомер);
		Если Ответ = "ПОВТОРИТЬ" Тогда
			Если ПопыткаНомер >= Политика.МаксПопыток Тогда
				РИХ_Предохранители.ЗафиксироватьОшибку("tk");
				ВызватьИсключение "RIH-503: ТК недоступна после "
					+ Формат(ПопыткаНомер, "ЧГ=0") + " попыток";
			КонецЕсли;
			РИХ_ПовторныеПопытки.Пауза(
				РИХ_ПовторныеПопытки.ЗадержкаПопытки(Политика, ПопыткаНомер + 1));
			Продолжить;
		КонецЕсли;
		// 429 «Отложено» — не успех и не смерть партнёра: он жив и
		// сам назвал паузу, поэтому предохранителю исход нейтрален.
		Если ТипЗнч(Ответ) <> Тип("Структура")
				ИЛИ НЕ Ответ.Свойство("Отложено") Тогда
			РИХ_Предохранители.ЗафиксироватьУспех("tk");
		КонецЕсли;
		Возврат Ответ;
	КонецЦикла;

КонецФункции

// Одна попытка вызова ТК: возвращает данные, структуру «Отложено»
// на 429 или отметку ПОВТОРИТЬ на повторяемой ошибке (task_128).
Функция ОднаПопыткаТК(Метод, Путь, Тело, Операция, ПопыткаНомер)

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	// Таймаут 10 с (task_127): регламент INT-04 обещает расчёт ≤ 10 с;
	// дольше — «заявка без тарифа» и очередь, а не висящий сеанс.
	Соединение = Новый HTTPСоединение("127.0.0.1", 8022, , , , 10);
	Запрос = Новый HTTPЗапрос(Путь);
	Запрос.Заголовки.Вставить("X-Api-Key", КлючТКИзКонтура());
	Если Тело <> Неопределено Тогда
		Запрос.Заголовки.Вставить("Content-Type", "application/json");
		Запрос.УстановитьТелоИзСтроки(РИХ_Форматы.СтруктуруВJSON(Тело));
	КонецЕсли;
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Исключение
		РИХ_Интеграции.ЗаписатьВызов("tk", Операция, "out", "",
			0, "RIH-503", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова,
			"попытка " + Формат(ПопыткаНомер, "ЧГ=0") + ": сеть недоступна");
		Возврат "ПОВТОРИТЬ";
	КонецПопытки;
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова;

	Если Ответ.КодСостояния = 429 Тогда
		СекундПаузы = Число(Ответ.Заголовки.Получить("Retry-After"));
		РИХ_Интеграции.ЗаписатьВызов("tk", Операция, "out", "",
			429, "", Длительность, "Retry-After " + СекундПаузы + " с");
		Результат = Новый Структура("Отложено,ПовторитьЧерезСекунд",
			Истина, СекундПаузы);
		Возврат Результат;
	КонецЕсли;

	Если РИХ_ПовторныеПопытки.ЭтоПовторяемаяОшибка(Ответ.КодСостояния) Тогда
		РИХ_Интеграции.ЗаписатьВызов("tk", Операция, "out", "",
			Ответ.КодСостояния, "", Длительность,
			"попытка " + Формат(ПопыткаНомер, "ЧГ=0") + ": повторяемая ошибка");
		Возврат "ПОВТОРИТЬ";
	КонецЕсли;

	РИХ_Интеграции.ЗаписатьВызов("tk", Операция, "out", "",
		Ответ.КодСостояния, "", Длительность);
	Возврат РИХ_Форматы.JSONВСтруктуру(Ответ.ПолучитьТелоКакСтроку());

КонецФункции

// Ключ ТК — настройка контура (task_134), у каждого партнёра своя.
Функция КлючТКИзКонтура()

	Возврат Константы.РИХ_КлючТК.Получить();

КонецФункции

#КонецОбласти
