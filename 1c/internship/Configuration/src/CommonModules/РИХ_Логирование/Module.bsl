// РИХ_Логирование — единый формат событий (task_50).
// Все ключевые события RIH пишутся сюда, а не «кто как умеет»:
// проведение, загрузки, ошибки обменов. Формат данных — JSON-строка
// в комментарии журнала регистрации: машина читает поля, человек — текст.

#Область ПрограммныйИнтерфейс

// Записывает событие в журнал регистрации с JSON-данными.
//
// Параметры:
//   Событие - Строка - вид события, например "Проведение.Поступление";
//   Данные  - Соответствие - поля события (ключи — латиницей для JSON).
//
// Возвращаемое значение:
//   Строка - идентификатор инцидента (GUID) для ошибок; для событий —
//            пустая строка. ID показывают пользователю (task_51): по нему
//            поддержка находит полную запись, не читая пользователю стек.
//
Функция ЗаписатьСобытие(Событие, Данные) Экспорт

	ЗаписьЖурналаРегистрации("РИХ." + Событие,
		УровеньЖурналаРегистрации.Информация, , ,
		СформироватьJSON(Событие, Данные, ""));

	Возврат "";

КонецФункции

// Записывает ошибку: уровень Ошибка, в JSON попадают текст и ID инцидента.
//
// Параметры:
//   Событие - Строка - вид события;
//   ОшибкаТекст - Строка - полное описание (стек хранить здесь, не у пользователя);
//   Данные  - Соответствие - контекст события.
//
// Возвращаемое значение:
//   Строка - идентификатор инцидента (GUID).
//
Функция ЗаписатьОшибку(Событие, ОшибкаТекст, Данные) Экспорт

	ИдентификаторИнцидента = Строка(Новый УникальныйИдентификатор());
	ДанныеПолные = Новый Соответствие;
	Для Каждого Пара Из Данные Цикл
		ДанныеПолные.Вставить(Пара.Ключ, Пара.Значение);
	КонецЦикла;
	ДанныеПолные.Вставить("error", ОшибкаТекст);
	ДанныеПолные.Вставить("incident", ИдентификаторИнцидента);

	ЗаписьЖурналаРегистрации("РИХ." + Событие,
		УровеньЖурналаРегистрации.Ошибка, , ,
		СформироватьJSON(Событие, ДанныеПолные, ИдентификаторИнцидента));

	Возврат ИдентификаторИнцидента;

КонецФункции

// Собирает JSON события. Значения полей, чьи ключи похожи на секреты
// или ПДн (password, token, пароль, телефон, паспорт), маскируются:
// политика «не логируем» исполняется кодом, а не надеждой (стандарт §7).
//
// Параметры:
//   Событие - Строка;
//   Данные  - Соответствие;
//   ИдентификаторИнцидента - Строка - может быть пустой.
//
// Возвращаемое значение:
//   Строка - JSON одной строкой.
//
Функция СформироватьJSON(Событие, Данные, ИдентификаторИнцидента) Экспорт

	Части = Новый Массив;
	Части.Добавить("""event"":""" + Событие + """");
	Для Каждого Пара Из Данные Цикл
		Значение = Пара.Значение;
		Если ЭтоСекретныйКлюч(Пара.Ключ) Тогда
			Значение = "***";
		КонецЕсли;
		Части.Добавить("""" + Пара.Ключ + """:""" + Экранировать(Строка(Значение)) + """");
	КонецЦикла;

	Возврат "{" + СтрСоединить(Части, ",") + "}";

КонецФункции

#КонецОбласти

#Область Служебные

Функция ЭтоСекретныйКлюч(Ключ)

	Низ = НРег(Ключ);
	Возврат СтрНайти(Низ, "password") > 0
		ИЛИ СтрНайти(Низ, "token") > 0
		ИЛИ СтрНайти(Низ, "парол") > 0
		ИЛИ СтрНайти(Низ, "телефон") > 0
		ИЛИ СтрНайти(Низ, "паспорт") > 0;

КонецФункции

Функция Экранировать(Текст)

	Результат = СтрЗаменить(Текст, "\", "\\");
	Результат = СтрЗаменить(Результат, """", "\""");
	Результат = СтрЗаменить(Результат, Символы.ПС, " ");

	Возврат Результат;

КонецФункции

#КонецОбласти
