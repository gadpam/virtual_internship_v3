// РИХ_Аудит (task_137): аудит людей, а не обменов. ЖурналИнтеграций
// отвечает «что случилось с данными», этот модуль — «кто это сделал
// и кто смотрел». Регистр АудитДоступа append-only: прикладным
// ролям удаление и правка запрещены правами, выгрузка в архив —
// единственная легальная чистка, и только после выгрузки.
//
// Аудитируются чувствительные события, а не всё подряд: аудит
// всего хоронит себя объёмом, и нужное событие ищут часами —
// то есть аудита фактически нет.

#Область ПрограммныйИнтерфейс

// Единственная точка записи события аудита. Детали не содержат
// ПДн и секретов (task_135): объект — идентификатор, основание —
// номер задачи или причина человеческими словами.
Процедура ЗаписатьСобытие(Пользователь, Событие, Объект, Детали = "",
		Было = "", Стало = "") Экспорт

	Запись = РегистрыСведений.АудитДоступа.СоздатьМенеджерЗаписи();
	Запись.Период = ТекущаяДатаСеанса();
	Запись.Пользователь = Пользователь;
	Запись.Событие = Событие;
	Запись.Объект = Объект;
	Запись.Детали = Детали;
	Запись.Было = Было;
	Запись.Стало = Стало;
	Запись.Записать();

КонецПроцедуры

// Полный показ ПДн (интерфейс по роли, task_135): кто, кого, когда.
Процедура ЗаписатьДоступКПДн(Пользователь, Объект, Детали = "") Экспорт

	ЗаписатьСобытие(Пользователь, "pdn_view", Объект, Детали);

КонецПроцедуры

// Изменение настройки интеграции с версией «было → стало»:
// последовательность записей по одной настройке и есть её
// история версий; откат — штатное действие по этой истории.
Процедура ЗаписатьИзменениеНастройки(Пользователь, Настройка,
		Было, Стало, Основание) Экспорт

	ЗаписатьСобытие(Пользователь, "settings_change", Настройка,
		Основание, Было, Стало);

КонецПроцедуры

// Остановка и запуск обмена — событие с основанием: «обмен с ТК
// остановлен» без «кем и почему» превращается в перебор чатов.
Процедура ЗаписатьОстановкуОбмена(Пользователь, Обмен, Основание) Экспорт

	ЗаписатьСобытие(Пользователь, "exchange_stop", Обмен, Основание);

КонецПроцедуры

// Запуск обмена после остановки: пара событий закрывает вопрос
// «как долго обмен лежал и по чьей задаче встал обратно».
Процедура ЗаписатьЗапускОбмена(Пользователь, Обмен, Основание = "") Экспорт

	ЗаписатьСобытие(Пользователь, "exchange_start", Обмен, Основание);

КонецПроцедуры

// Отчёт «Действия пользователя за период»: все события одного
// человека в хронологии — ответ расследованию за пять минут.
Функция ДействияПользователя(Пользователь, Начало, Конец) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Журнал.Период КАК Период, Журнал.Событие КАК Событие,
	|\tЖурнал.Объект КАК Объект, Журнал.Детали КАК Детали,
	|\tЖурнал.Было КАК Было, Журнал.Стало КАК Стало
	|ИЗ РегистрСведений.АудитДоступа КАК Журнал
	|ГДЕ Журнал.Пользователь = &Пользователь
	|\tИ Журнал.Период МЕЖДУ &Начало И &Конец
	|УПОРЯДОЧИТЬ ПО Журнал.Период";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Отчёт «Доступы к чувствительным данным»: все полные показы ПДн
// и обезличивания за период, по людям и объектам.
Функция ДоступыКЧувствительнымДанным(Начало, Конец) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Журнал.Период КАК Период, Журнал.Пользователь КАК Пользователь,
	|\tЖурнал.Событие КАК Событие, Журнал.Объект КАК Объект,
	|\tЖурнал.Детали КАК Детали
	|ИЗ РегистрСведений.АудитДоступа КАК Журнал
	|ГДЕ Журнал.Событие В (""pdn_view"", ""pdn_erasure"")
	|\tИ Журнал.Период МЕЖДУ &Начало И &Конец
	|УПОРЯДОЧИТЬ ПО Журнал.Период";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Срок хранения оперативного аудита — 1 год, дальше архив.
// Выгрузка возвращает текст архива (JSON Lines) и только после
// успешной выгрузки удаляет записи: порядок «сначала архив,
// потом чистка» задан кодом, а не инструкцией.
Функция ВыгрузитьВАрхивИОчистить(Граница) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Журнал.Период КАК Период, Журнал.Пользователь КАК Пользователь,
	|\tЖурнал.Событие КАК Событие, Журнал.Объект КАК Объект,
	|\tЖурнал.Детали КАК Детали
	|ИЗ РегистрСведений.АудитДоступа КАК Журнал
	|ГДЕ Журнал.Период < &Граница";
	Запрос.УстановитьПараметр("Граница", Граница);
	Таблица = Запрос.Выполнить().Выгрузить();

	Строки = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Строки.Добавить(РИХ_HTTP1_Ответы.ТекстJSON(Новый Структура(
			"period,user,event,object,details",
			РИХ_ОбщегоНазначения.СформироватьIso8601(Строка.Период),
			Строка.Пользователь, Строка.Событие, Строка.Объект, Строка.Детали)));
	КонецЦикла;
	Архив = СтрСоединить(Строки, Символы.ПС);

	Если Таблица.Количество() > 0 Тогда
		Набор = РегистрыСведений.АудитДоступа.СоздатьНаборЗаписей();
		Набор.Отбор.Период.Установить(
			Новый Граница(Граница, ВидГраницы.Исключая), Истина);
		Набор.Очистить();
		Набор.Записать();
	КонецЕсли;

	Возврат Новый Структура("Архив,Записей", Архив, Таблица.Количество());

КонецФункции

#КонецОбласти
