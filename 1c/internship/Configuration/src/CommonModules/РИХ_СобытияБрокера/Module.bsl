// РИХ_СобытияБрокера (task_111): события «документ проведён» в брокер.
// Версия события — часть payload (task_112): потребитель старше
// события обязан отказаться, а не применить вслепую.

#Область ПрограммныйИнтерфейс

// Строит событие проведения документа: тип, версия, момент, ключевые поля.
Функция СобытиеПроведенияДокумента(Документ) Экспорт

	Событие = Новый Структура;
	Событие.Вставить("event", "document.posted");
	Событие.Вставить("version", 1);
	Событие.Вставить("occurredAt",
		РИХ_ОбщегоНазначения.ВIso8601(ТекущаяДатаСеанса()));
	Событие.Вставить("documentId", Строка(Документ.УникальныйИдентификатор()));
	Событие.Вставить("documentType", Документ.Метаданные().Имя);

	Возврат Событие;

КонецФункции

// Публикует событие через HTTP-шлюз брокера. Вызывается из отправки
// очереди: событие сначала записано в ОчередьОбмена (тип события),
// поэтому падение шлюза не теряет проведение — очередь повторит.
Функция ОпубликоватьСобытие(Событие) Экспорт

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Соединение = Новый HTTPСоединение("127.0.0.1", 8027, , , , 10);
	Запрос = Новый HTTPЗапрос("/publish");
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.УстановитьТелоИзСтроки(РИХ_Форматы.СтруктуруВJSON(Событие));
	Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
	РИХ_Интеграции.ЗаписатьВызов("broker", Событие.event, "out",
		Событие.documentId, Ответ.КодСостояния, "",
		ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова);

	Возврат Ответ.КодСостояния = 202;

КонецФункции

#КонецОбласти
