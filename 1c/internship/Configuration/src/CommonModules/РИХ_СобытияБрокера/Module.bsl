// РИХ_СобытияБрокера (task_111): события «документ проведён» в брокер.
// Версия события — часть payload (task_112): потребитель старше
// события обязан отказаться, а не применить вслепую.

#Область ПрограммныйИнтерфейс

// Строит событие проведения документа: тип, версия, момент, ключевые поля.
Функция СобытиеПроведенияДокумента(Документ) Экспорт

	Событие = Новый Структура;
	Событие.Вставить("event", "document.posted");
	Событие.Вставить("version", 1);
	Событие.Вставить("occurredAt",
		РИХ_ОбщегоНазначения.ВIso8601(ТекущаяДатаСеанса()));
	Событие.Вставить("documentId", Строка(Документ.УникальныйИдентификатор()));
	Событие.Вставить("documentType", Документ.Метаданные().Имя);

	Возврат Событие;

КонецФункции

// Публикует событие через HTTP-шлюз брокера. Вызывается из отправки
// очереди: событие сначала записано в ОчередьОбмена (тип события),
// поэтому падение шлюза не теряет проведение — очередь повторит.
Функция ОпубликоватьСобытие(Событие) Экспорт

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Соединение = Новый HTTPСоединение("127.0.0.1", 8027, , , , 10);
	Запрос = Новый HTTPЗапрос("/publish");
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.УстановитьТелоИзСтроки(РИХ_Форматы.СтруктуруВJSON(Событие));
	Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
	РИХ_Интеграции.ЗаписатьВызов("broker", Событие.event, "out",
		Событие.documentId, Ответ.КодСостояния, "",
		ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова);

	Возврат Ответ.КодСостояния = 202;

КонецФункции

// Применяет событие изменения остатка с защитой от порядка (task_112).
// Событие старше уже применённого состояния отклоняется: остатки —
// строгая область, «воскрешение» старого количества хуже пропуска.
// Дубли по идентификатору события поглощаются журналом принятых.
Функция ПрименитьСобытиеОстатка(ИдСобытия, Артикул, Количество, ВерсияСобытия, МоментСобытия) Экспорт

	Если СобытиеУжеПрименено(ИдСобытия) Тогда
		Возврат "дубль";
	КонецЕсли;
	Если ВерсияСобытия <> 1 Тогда
		ВызватьИсключение "RIH-422: версия события " + ВерсияСобытия
			+ " не поддерживается (понимаем 1)";
	КонецЕсли;

	ТекущаяВерсия = ВерсияСостоянияОстатка(Артикул);
	Если МоментСобытия <= ТекущаяВерсия Тогда
		ЗаписьЖурналаРегистрации("РИХ.События.Порядок",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Устаревшее событие остатка отклонено: " + Артикул);
		Возврат "устарело";
	КонецЕсли;

	ПрименитьОстатокИзСобытия(Артикул, Количество, МоментСобытия);
	ОтметитьСобытиеПрименённым(ИдСобытия);

	Возврат "применено";

КонецФункции

#КонецОбласти

#Область Служебные

// Событие с этим идентификатором уже применено ранее.
Функция СобытиеУжеПрименено(ИдСобытия)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Сообщения.ИдСообщения КАК Ид
	|ИЗ РегистрСведений.ПринятыеСообщения КАК Сообщения
	|ГДЕ Сообщения.ИдСообщения = &Ид И Сообщения.СтатусОбработки = &Готово";
	Запрос.УстановитьПараметр("Ид", ИдСобытия);
	Запрос.УстановитьПараметр("Готово", "готово");

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

// Момент последнего применённого состояния остатка артикула.
Функция ВерсияСостоянияОстатка(Артикул)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Состояние.МоментСостояния КАК Момент
	|ИЗ РегистрСведений.СостояниеОстатковСобытий КАК Состояние
	|ГДЕ Состояние.Артикул = &Артикул";
	Запрос.УстановитьПараметр("Артикул", Артикул);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Момент;
	КонецЕсли;

	Возврат Дата(1, 1, 1);

КонецФункции

// Пишет остаток из события и момент его состояния одной записью.
Процедура ПрименитьОстатокИзСобытия(Артикул, Количество, МоментСобытия)

	Запись = РегистрыСведений.СостояниеОстатковСобытий.СоздатьМенеджерЗаписи();
	Запись.Артикул = Артикул;
	Запись.Количество = Количество;
	Запись.МоментСостояния = МоментСобытия;
	Запись.Записать();

КонецПроцедуры

// Отмечает событие применённым в журнале принятых сообщений.
Процедура ОтметитьСобытиеПрименённым(ИдСобытия)

	Запись = РегистрыСведений.ПринятыеСообщения.СоздатьМенеджерЗаписи();
	Запись.ИдСообщения = ИдСобытия;
	Запись.СтатусОбработки = "готово";
	Запись.ДатаПриёма = ТекущаяДатаСеанса();
	Запись.Записать();

КонецПроцедуры

#КонецОбласти
