// РИХ_Саги (task_130): распределённая операция «заказ» без общей
// транзакции: резерв в магазине → оплата баллами → заявка в ТК.
// У каждого шага компенсация, спроектированная вместе с шагом:
// отмена заказа, сторно списания, отмена заявки. Сбой шага N
// запускает компенсации шагов N−1..1 в ОБРАТНОМ порядке.
// Компенсация — не удаление следов: сторно остаётся в аудите,
// а двойная компенсация безопасна по ключам операций (task_92).

#Область ПрограммныйИнтерфейс

// Выполняет сагу заказа и возвращает её итог: Выполнена,
// ОтмененаКомпенсациями (какой шаг упал) или КомпенсацияНеУдалась
// (пара в очереди ручного разбора и алерт оператору записан).
Функция ВыполнитьСагуЗаказа(ИдСаги, ИдЗаказаМагазина, Карта, Баллы) Экспорт

	ВыполненныеШаги = Новый Массив;
	Попытка
		РИХ_МагазинКлиент.УстановитьСтатусЗаказа(ИдЗаказаМагазина, "reserved");
		ВыполненныеШаги.Добавить("reserve");
	Исключение
		Возврат ИтогСаги(ИдСаги, "ОтмененаКомпенсациями", "reserve", ВыполненныеШаги);
	КонецПопытки;

	Попытка
		РИХ_ЛояльностьКлиент.Списать(ИдСаги + "-pay", Карта, Баллы,
			"оплата заказа " + ИдЗаказаМагазина);
		ВыполненныеШаги.Добавить("payment");
	Исключение
		Если КомпенсироватьШаги(ИдСаги, ВыполненныеШаги, ИдЗаказаМагазина, Карта) Тогда
			Возврат ИтогСаги(ИдСаги, "ОтмененаКомпенсациями", "payment", ВыполненныеШаги);
		КонецЕсли;
		Возврат ИтогСаги(ИдСаги, "КомпенсацияНеУдалась", "payment", ВыполненныеШаги);
	КонецПопытки;

	Попытка
		РИХ_ТККлиент.СоздатьЗаявку(ИдСаги + "-ship", "Минск", 1);
		ВыполненныеШаги.Добавить("delivery");
	Исключение
		Если КомпенсироватьШаги(ИдСаги, ВыполненныеШаги, ИдЗаказаМагазина, Карта) Тогда
			Возврат ИтогСаги(ИдСаги, "ОтмененаКомпенсациями", "delivery", ВыполненныеШаги);
		КонецЕсли;
		Возврат ИтогСаги(ИдСаги, "КомпенсацияНеУдалась", "delivery", ВыполненныеШаги);
	КонецПопытки;

	РИХ_Интеграции.ЗаписатьВызов("saga", ИдСаги, "out", ИдЗаказаМагазина,
		200, "", 0, "сага выполнена: резерв, оплата, доставка");
	Возврат Новый Структура("Статус,УпавшийШаг", "Выполнена", "");

КонецФункции

#КонецОбласти

#Область Служебные

// Компенсирует выполненные шаги в обратном порядке. Неудавшаяся
// компенсация не глотается: пара «сага/шаг» падает в очередь
// ручного разбора и алерт оператору — сразу, а не ночью.
Функция КомпенсироватьШаги(ИдСаги, ВыполненныеШаги, ИдЗаказаМагазина, Карта)

	ВсеУдалось = Истина;
	Индекс = ВыполненныеШаги.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Шаг = ВыполненныеШаги[Индекс];
		Попытка
			Если Шаг = "payment" Тогда
				РИХ_ЛояльностьКлиент.ОтменитьОперацию(ИдСаги + "-pay");
			ИначеЕсли Шаг = "reserve" Тогда
				РИХ_МагазинКлиент.УстановитьСтатусЗаказа(ИдЗаказаМагазина, "cancelled");
			ИначеЕсли Шаг = "delivery" Тогда
				РИХ_ТККлиент.ОтменитьЗаявку(ИдСаги + "-ship");
			КонецЕсли;
			РИХ_Интеграции.ЗаписатьВызов("saga", ИдСаги, "out", "",
				200, "RIH-COMP", 0, "компенсация шага " + Шаг + " выполнена");
		Исключение
			ВсеУдалось = Ложь;
			Запись = РегистрыСведений.ОчередьКомпенсаций.СоздатьМенеджерЗаписи();
			Запись.ИдСаги = ИдСаги;
			Запись.Шаг = Шаг;
			Запись.Причина = ОписаниеОшибки();
			Запись.Момент = ТекущаяДатаСеанса();
			Запись.Разобрано = Ложь;
			Запись.Записать();
			РИХ_Интеграции.ЗаписатьВызов("saga", ИдСаги, "out", "",
				500, "RIH-COMP-FAILED", 0,
				"АЛЕРТ оператору: компенсация шага " + Шаг
				+ " не удалась, данные разошлись; разбор вручную в тот же день");
		КонецПопытки;
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат ВсеУдалось;

КонецФункции

// Итог саги одной структурой для вызывающего и журнала.
Функция ИтогСаги(ИдСаги, Статус, УпавшийШаг, ВыполненныеШаги)

	РИХ_Интеграции.ЗаписатьВызов("saga", ИдСаги, "out", "",
		?(Статус = "КомпенсацияНеУдалась", 500, 200),
		?(Статус = "КомпенсацияНеУдалась", "RIH-COMP-FAILED", "RIH-COMP"), 0,
		"сага " + Статус + ", упал шаг " + УпавшийШаг
		+ ", компенсировано шагов: " + Формат(ВыполненныеШаги.Количество(), "ЧГ=0"));

	Возврат Новый Структура("Статус,УпавшийШаг", Статус, УпавшийШаг);

КонецФункции

#КонецОбласти
