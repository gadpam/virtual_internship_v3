///////////////////////////////////////////////////////////////////////////////////////////////////////
// РИХ_Версионирование
//
// Учебный аналог версионирования объектов БСП (в RIH библиотеки БСП нет, task_8):
// подписка «ПриЗаписи» справочника Номенклатура пишет в регистр
// РИХ_ИсторияИзменений новую версию — порядковый номер внутри объекта, дата,
// автор и снимок реквизитов в XML. Снимок после записи не изменяется:
// история — это журнал фактов, а не «текущее значение плюс дата».
//
// Правила: Docs/CodingStandard.md · префикс РИХ_ обязателен · модуль серверный.
//
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Обработчик подписки РИХ_ИсторияИзмененийПриЗаписи (событие ПриЗаписи
// справочника Номенклатура). Создаёт следующую версию объекта.
// Загрузка данными из обменов версии не создаёт: это не изменение
// пользователем, а репликация (иначе история зашумляется обменами).
//
// Параметры:
//   Источник - СправочникОбъект.Номенклатура - записываемый элемент;
//   Отказ    - Булево - признак отказа записи (подписка запись не отменяет).
//
Процедура ЗафиксироватьВерсиюНоменклатуры(Источник, Отказ) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	НомерВерсии = СледующийНомерВерсии(Источник.Ссылка);

	НаборЗаписей = РегистрыСведений.РИХ_ИсторияИзменений.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(Источник.Ссылка);
	НаборЗаписей.Отбор.НомерВерсии.Установить(НомерВерсии);

	Запись = НаборЗаписей.Добавить();
	Запись.Объект = Источник.Ссылка;
	Запись.НомерВерсии = НомерВерсии;
	Запись.ДатаИзменения = ТекущаяДатаСеанса();
	Запись.Автор = ИмяПользователя();
	Запись.СнимокXML = СнимокРеквизитовXML(Источник);

	НаборЗаписей.Записать(Ложь);

КонецПроцедуры

// Возвращает историю версий объекта одной строкой на версию: номер, дата,
// автор и снимок. Используется формой элемента справочника (клиент
// показывает возвращённый текст; серверный модуль Сообщить() не вызывает).
//
// Параметры:
//   Объект - СправочникСсылка.Номенклатура - объект, чья история нужна.
//
// Возвращаемое значение:
//   Строка - версии по возрастанию номера; пустая строка, если версий нет.
//
Функция ИсторияИзмененийСтрокой(Объект) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	История.НомерВерсии КАК НомерВерсии,
		|	История.ДатаИзменения КАК ДатаИзменения,
		|	История.Автор КАК Автор,
		|	История.СнимокXML КАК СнимокXML
		|ИЗ
		|	РегистрСведений.РИХ_ИсторияИзменений КАК История
		|ГДЕ
		|	История.Объект = &Объект
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерВерсии";
	Запрос.УстановитьПараметр("Объект", Объект);

	СтрокиИстории = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокиИстории.Добавить(СтрШаблон("Версия %1 от %2, автор %3: %4",
			Выборка.НомерВерсии,
			Выборка.ДатаИзменения,
			Выборка.Автор,
			Выборка.СнимокXML));
	КонецЦикла;

	Возврат СтрСоединить(СтрокиИстории, Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Следующий порядковый номер версии объекта: максимум существующих + 1.
// Номер версии считается внутри одного объекта, а не глобальным
// счётчиком по всем объектам — иначе номера ничего не говорят об истории
// конкретного элемента.
//
// Параметры:
//   Объект - СправочникСсылка.Номенклатура - версионируемый объект.
//
// Возвращаемое значение:
//   Число - номер новой версии (для первой версии — 1).
//
Функция СледующийНомерВерсии(Объект)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(МАКСИМУМ(История.НомерВерсии), 0) КАК МаксимальныйНомер
		|ИЗ
		|	РегистрСведений.РИХ_ИсторияИзменений КАК История
		|ГДЕ
		|	История.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", Объект);

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.МаксимальныйНомер + 1;

КонецФункции

// Обработчик обновления ИБ (task_65): заполнение ЕдиницаИзмерения
// для номенклатуры, созданной до появления реквизита (task_24).
// Идемпотентно: трогает только пустые значения, повторный запуск — не
// ошибка, а ноль обработанных. Работает пакетами (task_57): сбой пакета
// не откатывает уже обновлённые. Вызывается обработчиком обновления
// конфигурации при переходе на версию с реквизитом.
//
// Параметры:
//   Параметры - Структура - параметры обработчика обновления (платформа).
//
Процедура ОбработчикОбновления_ЕдиницыНоменклатуры(Параметры) Экспорт

	БазоваяЕдиница = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию("шт");
	Если БазоваяЕдиница.Пустая() Тогда
		ВызватьИсключение "Не найдена базовая единица измерения «шт»";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Товары.Ссылка КАК Ссылка
	|ИЗ Справочник.Номенклатура КАК Товары
	|ГДЕ Товары.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.ПустаяСсылка)";
	Выборка = Запрос.Выполнить().Выбрать();

	Обработано = 0;
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.ЕдиницаИзмерения = БазоваяЕдиница;
		// ОбменДанными.Загрузка: обновление не должно плодить версии
		// истории и подписки (правило модуля версионирования выше)
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать();
		Обработано = Обработано + 1;
	КонецЦикла;

	ЗаписьЖурналаРегистрации("РИХ.Обновление",
		УровеньЖурналаРегистрации.Информация, , ,
		"Единицы номенклатуры заполнены: " + Обработано);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыОбновления

// Сериализует реквизиты элемента в XML-снимок версии. Снимок хранится
// строкой в регистре и не разбирается обратно в объект: для учебной
// истории достаточно сравнения «было/стало» глазами из формы элемента.
//
// Параметры:
//   Источник - СправочникОбъект.Номенклатура - записываемый элемент.
//
// Возвращаемое значение:
//   Строка - XML вида <Элемент Код="..." Наименование="..."/>.
//
Функция СнимокРеквизитовXML(Источник)

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	ЗаписьXML.ЗаписатьНачалоЭлемента("Элемент");
	ЗаписьXML.ЗаписатьАтрибут("Код", СокрЛП(Источник.Код));
	ЗаписьXML.ЗаписатьАтрибут("Наименование", Источник.Наименование);
	ЗаписьXML.ЗаписатьКонецЭлемента();

	Возврат ЗаписьXML.Закрыть();

КонецФункции

#КонецОбласти
