// РИХ_УчётТоваровДвижения — проведение складских документов (task_43).
// Модули объектов документов только вызывают эти процедуры: бизнес-логика
// одна на форму, обмен и регламентную загрузку.

#Область ПрограммныйИнтерфейс

// Формирует движения поступления одним массивом (пакетная запись набором —
// стандарт §6), услуги пропускаются, количества — базовые (task_24).
//
// Параметры:
//   Склад - СправочникСсылка.Склады - склад поступления;
//   Дата  - Дата - период движений;
//   Товары - ТабличнаяЧасть - строки документа.
//
// Возвращаемое значение:
//   Массив - структуры движений (ВидДвижения, Склад, Номенклатура, Количество).
//
Функция ДвиженияПоступления(Склад, Дата, Товары) Экспорт

	Движения = Новый Массив;
	Для Каждого СтрокаТоваров Из Товары Цикл
		Если СтрокаТоваров.Номенклатура.ЭтоУслуга Тогда
			Продолжить;
		КонецЕсли;
		Движения.Добавить(НовоеДвижение("Приход", Склад,
			СтрокаТоваров.Номенклатура, СтрокаТоваров.КоличествоБазовое, Дата));
	КонецЦикла;

	Возврат Движения;

КонецФункции

// Формирует движения перемещения (расход+приход парами) и проверяет
// контроль остатков: перемещение больше остатка на складе-источнике
// запрещено. Проверка и проведение — в одной транзакции проведения
// документа и под блокировкой (task_45): проверить отдельно, провести
// потом — гонка.
//
// Параметры:
//   СкладОтправитель - СправочникСсылка.Склады;
//   СкладПолучатель  - СправочникСсылка.Склады;
//   Дата             - Дата - период движений и остатков;
//   Товары           - ТабличнаяЧасть - строки документа.
//
// Возвращаемое значение:
//   Массив - структуры движений.
//
// Исключения:
//   Ошибка контроля остатков — исключение с понятным пользователю текстом.
//
Функция ДвиженияПеремещения(СкладОтправитель, СкладПолучатель, Дата, Товары) Экспорт

	// Управляемая блокировка остатков до чтения (task_45): два сеанса
	// не должны одновременно увидеть один остаток и провести расход.
	// Порядок захвата единый (стандарт §4): склад, затем товары —
	// одинаковый порядок у всех сеансов исключает deadlock по построению.
	Блокировка = Новый БлокировкаДанных;
	Для Каждого СтрокаТоваров Из Товары Цикл
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ТоварыНаСкладах");
		ЭлементБлокировки.УстановитьЗначение("Склад", СкладОтправитель);
		ЭлементБлокировки.УстановитьЗначение("Номенклатура", СтрокаТоваров.Номенклатура);
	КонецЦикла;
	Попытка
		Блокировка.Заблокировать();
	Исключение
		ВызватьИсключение "Склад сейчас занят другим проведением. Повторите через несколько секунд.";
	КонецПопытки;

	Движения = Новый Массив;
	Остатки = ОстаткиНаСкладе(СкладОтправитель, Дата);

	Для Каждого СтрокаТоваров Из Товары Цикл
		Если СтрокаТоваров.Номенклатура.ЭтоУслуга Тогда
			Продолжить;
		КонецЕсли;
		Доступно = Остатки.Получить(СтрокаТоваров.Номенклатура);
		Если Доступно = Неопределено Тогда
			Доступно = 0;
		КонецЕсли;
		Если СтрокаТоваров.КоличествоБазовое > Доступно Тогда
			ВызватьИсключение СтрШаблон(
				"Недостаточно товара %1 на складе %2: доступно %3, требуется %4",
				СтрокаТоваров.Номенклатура, СкладОтправитель,
				Доступно, СтрокаТоваров.КоличествоБазовое);
		КонецЕсли;
		Движения.Добавить(НовоеДвижение("Расход", СкладОтправитель,
			СтрокаТоваров.Номенклатура, СтрокаТоваров.КоличествоБазовое, Дата));
		Движения.Добавить(НовоеДвижение("Приход", СкладПолучатель,
			СтрокаТоваров.Номенклатура, СтрокаТоваров.КоличествоБазовое, Дата));
		// Остаток уменьшаем внутри расчёта: две строки одного товара
		// в документе не должны пройти контроль по очереди.
		Остатки.Вставить(СтрокаТоваров.Номенклатура, Доступно - СтрокаТоваров.КоличествоБазовое);
	КонецЦикла;

	Возврат Движения;

КонецФункции

// Записывает массив движений в регистр одним набором записей документа
// и фиксирует факт проведения в журнале регистрации.
//
// Параметры:
//   НаборДвижений - РегистрНакопленияНаборЗаписей.ТоварыНаСкладах - набор документа;
//   Движения      - Массив - результат ДвиженияПоступления/ДвиженияПеремещения;
//   Документ      - ДокументОбъект - регистратор (для журнала).
//
Процедура ЗаписатьДвижения(НаборДвижений, Движения, Документ) Экспорт

	Для Каждого Движение Из Движения Цикл
		Запись = НаборДвижений.Добавить();
		Запись.ВидДвижения = ?(Движение.ВидДвижения = "Приход",
			ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
		Запись.Период = Движение.Период;
		Запись.Склад = Движение.Склад;
		Запись.Номенклатура = Движение.Номенклатура;
		Запись.Количество = Движение.Количество;
	КонецЦикла;
	НаборДвижений.Записать();

	ЗаписьЖурналаРегистрации("РИХ.Проведение",
		УровеньЖурналаРегистрации.Информация, , Документ.Ссылка,
		СтрШаблон("Проведено движений: %1", Движения.Количество()));

КонецПроцедуры

// Двигает границу последовательности УчётТоваров (task_46): граница —
// последний момент, до которого документы проведены непрерывно (без
// «дырок» непроведённых/задним числом). Дальше границы не прыгаем:
// остатки до границы неизменны, после — предварительны.
// Вызывается регламентным заданием ДвижениеГраницыУчётаТоваров (ежечасно).
//
Процедура СдвинутьГраницуПоследовательности() Экспорт

	Граница = Последовательности.УчётТоваров.ПолучитьГраницу();
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	МАКСИМУМ(Документы.Дата) КАК ПоследняяДата
		|ИЗ
		|	Документ.ПоступлениеТоваров КАК Документы
		|ГДЕ
		|	Документы.Проведен
		|	И Документы.Дата > &Граница";
	Запрос.УстановитьПараметр("Граница", Граница);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ПоследняяДата) Тогда
		// Упрощение учебного контура: непрерывность обеспечивает само
		// регламентное движение + перепроведения задним числом видны
		// восстановлением последовательности при импорте в ИБ.
		Последовательности.УчётТоваров.УстановитьГраницу(Выборка.ПоследняяДата);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция НовоеДвижение(ВидДвижения, Склад, Номенклатура, Количество, Период)

	Возврат Новый Структура("ВидДвижения,Склад,Номенклатура,Количество,Период",
		ВидДвижения, Склад, Номенклатура, Количество, Период);

КонецФункции

// Остатки склада на дату одним запросом (вирт. таблица с параметрами,
// а не цикл по товарам — урок task_13/26).
Функция ОстаткиНаСкладе(Склад, Дата)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	Остатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(&Момент, Склад = &Склад) КАК Остатки";
	Запрос.УстановитьПараметр("Момент", Дата);
	Запрос.УстановитьПараметр("Склад", Склад);

	Остатки = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Остатки.Вставить(Выборка.Номенклатура, Выборка.Количество);
	КонецЦикла;

	Возврат Остатки;

КонецФункции

#КонецОбласти
