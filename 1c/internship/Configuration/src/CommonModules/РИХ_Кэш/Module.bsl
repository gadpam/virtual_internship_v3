// РИХ_Кэш (task_60): повторное использование значений на время сеанса.
// Кэшируем только справочные данные: читаются в каждом отчёте, меняются
// редко и вручную. Транзакционные данные (остатки, цены) не кэшируем:
// читающий обязан видеть зафиксированное состояние базы.

#Область ПрограммныйИнтерфейс

// Таблица минимальных остатков из кэша сеанса: первый вызов читает
// регистр, остальные в этом сеансе получают готовую таблицу.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Склад, Номенклатура, Количество.
//
Функция ТаблицаМинимальныхОстатков() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Минимумы.Склад КАК Склад,
	|	Минимумы.Номенклатура КАК Номенклатура,
	|	Минимумы.Количество КАК Количество
	|ИЗ РегистрСведений.МинимальныеОстатки КАК Минимумы";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Минимальный остаток пары из кэшированной таблицы (0 — порог не задан).
//
// Параметры:
//   Склад        - СправочникСсылка.Склады;
//   Номенклатура - СправочникСсылка.Номенклатура.
//
// Возвращаемое значение:
//   Число - минимальный остаток.
//
Функция МинимальныйОстаток(Склад, Номенклатура) Экспорт

	Отбор = Новый Структура("Склад,Номенклатура", Склад, Номенклатура);
	Строки = ТаблицаМинимальныхОстатков().НайтиСтроки(Отбор);
	Если Строки.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Строки[0].Количество;

КонецФункции

// Сбрасывает все повторно используемые значения сеанса. Вызывается из
// мест записи минимальных остатков и настроек: писатель обязан
// инвалидировать то, что изменил, — читатель об изменении не узнает.
Процедура СброситьКэш() Экспорт

	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры

#КонецОбласти
