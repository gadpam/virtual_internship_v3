// РИХ_БухгалтерскиеДвижения (task_153): трансляция «документ →
// проводки» правилами из справочника ПравилаТрансляции. Документ
// не знает счетов, бухгалтерия не знает документов: бухгалтер
// меняет счёт в правиле и перепроводит документ — проводка
// перестраивается без релиза. Отсутствие правила — ошибка
// RIH-ACC-001 вслух: проведённый документ без учёта хуже
// непроведённого, о нём узнает бухгалтер в закрытии периода.

#Область ПрограммныйИнтерфейс

// Строит движения регистра РИХ_Учёт по документу. Вызывается
// из проведения после основных движений; основная логика
// документов не меняется — трансляция живёт отдельным слоем.
// Повторный вызов заменяет движения документа (идемпотентность
// перепроведения): набор записей документа очищается до записи.
Процедура Транслировать(Документ, ВидДокумента, Сумма,
		Субконто = Неопределено) Экспорт

	Правила = ПравилаДля(ВидДокумента);
	Если Правила.Количество() = 0 Тогда
		ВызватьИсключение "RIH-ACC-001: нет активного правила трансляции для "
			+ ВидДокумента + " — документ проведён не будет";
	КонецЕсли;

	Набор = РегистрыБухгалтерии.РИХ_Учёт.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Документ);
	Набор.Очистить();

	Для Каждого Правило Из Правила Цикл
		Запись = Набор.Добавить();
		Запись.Период = Документ.Дата;
		Запись.Организация = Документ.Организация;
		Запись.СчетДт = РИХ_Бухгалтерия.СчётПоКоду(Правило.СчётДт);
		Запись.СчетКт = РИХ_Бухгалтерия.СчётПоКоду(Правило.СчётКт);
		Запись.Сумма = Сумма;
		Запись.СубконтоДт1 = Субконто;
		Запись.СубконтоКт1 = Субконто;
		Запись.Документ = Строка(Документ);
		Запись.Содержание = "Трансляция: " + ВидДокумента;
	КонецЦикла;

	Набор.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Активные правила вида документа из справочника: правила —
// данные, поэтому бухгалтерия правит их без разработчика.
Функция ПравилаДля(ВидДокумента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Правила.СчётДт КАК СчётДт, Правила.СчётКт КАК СчётКт,
	|\tПравила.ИсточникСубконто КАК ИсточникСубконто
	|ИЗ Справочник.ПравилаТрансляции КАК Правила
	|ГДЕ Правила.ВидДокумента = &ВидДокумента И Правила.Активно";
	Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти
