// РИХ_МагазинКлиент (task_91): выгрузка каталога и остатков в магазин.
// Контракт: PUT /api/v1/products пакетами по 500, ответ accepted/rejected.
// Частичный успех не равен успеху: отклонённые позиции поименно уходят
// в журнал, а метка дельты при отклонениях не двигается.

#Область ПрограммныйИнтерфейс

// Выгружает товары и цены, изменённые после метки РС МеткиСинхронизации.
//
// Параметры:
//   ПолнаяВыгрузка - Булево - игнорировать метку (первый запуск, сверка).
//
// Возвращаемое значение:
//   Структура - Отправлено, Принято, Отклонено, Пакетов.
//
Функция ВыгрузитьТоварыИЦены(ПолнаяВыгрузка = Ложь) Экспорт

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Метка = ?(ПолнаяВыгрузка, Дата(1, 1, 1), МеткаДельты("shop", "products"));
	Товары = ТоварыКВыгрузке(Метка);

	Итог = Новый Структура("Отправлено,Принято,Отклонено,Пакетов", 0, 0, 0, 0);
	РазмерПакета = 500;
	Пакет = Новый Массив;
	Для Каждого Товар Из Товары Цикл
		Пакет.Добавить(Товар);
		Если Пакет.Количество() = РазмерПакета Тогда
			ОтправитьПакетТоваров(Пакет, Итог);
			Пакет = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если Пакет.Количество() > 0 Тогда
		ОтправитьПакетТоваров(Пакет, Итог);
	КонецЕсли;

	Если Итог.Отклонено = 0 И Итог.Отправлено > 0 Тогда
		// Метка двигается только за полностью подтверждённой выгрузкой:
		// при отклонениях повторная отправка принятого безвредна (PUT).
		УстановитьМеткуДельты("shop", "products", МаксимальноеИзменение(Товары));
	КонецЕсли;
	РИХ_Интеграции.ЗаписатьВызов("shop", "ExportProducts", "out", "",
		?(Итог.Отклонено = 0, 200, 207), "",
		ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова,
		"принято " + Итог.Принято + " из " + Итог.Отправлено);

	Возврат Итог;

КонецФункции

// Выгружает остатки по всем складам одной дельтой типа stock.
Функция ВыгрузитьОстатки() Экспорт

	НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Остатки.Склад.Наименование КАК Склад,
	|	Остатки.Номенклатура.Артикул КАК Артикул,
	|	Остатки.КоличествоОстаток КАК Количество
	|ИЗ РегистрНакопления.ТоварыНаСкладах.Остатки() КАК Остатки";
	Выборка = Запрос.Выполнить().Выбрать();

	СтрокиОстатков = Новый Массив;
	Пока Выборка.Следующий() Цикл
		СтрокаОстатка = Новый Структура("warehouse,sku,quantity",
			Выборка.Склад, Выборка.Артикул, Выборка.Количество);
		СтрокиОстатков.Добавить(СтрокаОстатка);
	КонецЦикла;

	Ответ = ОтправитьJSONВМагазин("PUT", "/api/v1/stock", СтрокиОстатков);
	РИХ_Интеграции.ЗаписатьВызов("shop", "ExportStock", "out", "",
		200, "", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова,
		"остатков: " + СтрокиОстатков.Количество());

	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область Служебные

// Отправляет один пакет товаров и разбирает частичный успех поименно.
Процедура ОтправитьПакетТоваров(Пакет, Итог)

	Итог.Пакетов = Итог.Пакетов + 1;
	Итог.Отправлено = Итог.Отправлено + Пакет.Количество();
	Ответ = ОтправитьJSONВМагазин("PUT", "/api/v1/products", Пакет);

	Итог.Принято = Итог.Принято + Ответ.accepted;
	Для Каждого Отказ Из Ответ.rejected Цикл
		Итог.Отклонено = Итог.Отклонено + 1;
		РИХ_Интеграции.ЗаписатьВызов("shop", "ExportProductsRejected", "out",
			Отказ.sku, 422, "RIH-422", 0, Отказ.reason);
	КонецЦикла;

КонецПроцедуры

// Отправка JSON в магазин по политике РИХ_ПовторныеПопытки (task_128).
// Безопасность повтора: пачки дельты идемпотентны по построению
// (task_83 — повтор той же пачки не двоит данные магазина).
Функция ОтправитьJSONВМагазин(Метод, Путь, Данные)

	Политика = РИХ_ПовторныеПопытки.ПолитикаПоУмолчанию();
	ПопыткаНомер = 0;
	Пока ПопыткаНомер < Политика.МаксПопыток Цикл
		ПопыткаНомер = ПопыткаНомер + 1;
		НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
		КодОтвета = 0;
		Ответ = Неопределено;
		Попытка
			Ответ = ОднаОтправкаВМагазин(Метод, Путь, Данные);
			КодОтвета = Ответ.КодСостояния;
		Исключение
			КодОтвета = 0;
		КонецПопытки;
		РИХ_Интеграции.ЗаписатьВызов("shop", Путь, "out", "",
			КодОтвета, ?(КодОтвета = 0, "RIH-503", ""),
			ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова,
			"попытка " + Формат(ПопыткаНомер, "ЧГ=0")
			+ " из " + Формат(Политика.МаксПопыток, "ЧГ=0"));
		Если Ответ <> Неопределено
				И НЕ РИХ_ПовторныеПопытки.ЭтоПовторяемаяОшибка(КодОтвета) Тогда
			Возврат РИХ_Форматы.JSONВСтруктуру(Ответ.ПолучитьТелоКакСтроку());
		КонецЕсли;
		Если ПопыткаНомер >= Политика.МаксПопыток Тогда
			ВызватьИсключение "RIH-503: магазин недоступен после "
				+ Формат(ПопыткаНомер, "ЧГ=0") + " попыток; пачка ждёт в очереди обмена";
		КонецЕсли;
		РИХ_ПовторныеПопытки.Пауза(
			РИХ_ПовторныеПопытки.ЗадержкаПопытки(Политика, ПопыткаНомер + 1));
	КонецЦикла;

КонецФункции

// Одна отправка JSON в магазин с ключом из контура (не из кода).
Функция ОднаОтправкаВМагазин(Метод, Путь, Данные)

	// Таймаут 10 с (task_127): было 30 «на всё» по наследству; чтения
	// каталога с p95 в миллисекундах получасовая граница не нужна.
	Соединение = Новый HTTPСоединение("127.0.0.1", 8020, , , , 10);
	Запрос = Новый HTTPЗапрос(Путь);
	Запрос.Заголовки.Вставить("Content-Type", "application/json");
	Запрос.Заголовки.Вставить("X-Api-Key", КлючМагазинаИзКонтура());
	Запрос.УстановитьТелоИзСтроки(РИХ_Форматы.СтруктуруВJSON(Данные));

	Возврат Соединение.ВызватьHTTPМетод(Метод, Запрос);

КонецФункции

// Ключ магазина берётся из безопасного хранилища контура (task_134);
// учебное значение mock сюда не зашивается.
Функция КлючМагазинаИзКонтура()

	Возврат Константы.РИХ_КлючМагазина.Получить();

КонецФункции

// Метка дельты партнёра и типа данных (пустая дата, если не было).
Функция МеткаДельты(Система, ТипДанных)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Метки.МеткаИзменений КАК Метка
	|ИЗ РегистрСведений.МеткиСинхронизации КАК Метки
	|ГДЕ Метки.Система = &Система И Метки.ТипДанных = &ТипДанных";
	Запрос.УстановитьПараметр("Система", Система);
	Запрос.УстановитьПараметр("ТипДанных", ТипДанных);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Метка;
	КонецЕсли;

	Возврат Дата(1, 1, 1);

КонецФункции

// Сдвигает метку дельты после подтверждённой выгрузки.
Процедура УстановитьМеткуДельты(Система, ТипДанных, Метка)

	Запись = РегистрыСведений.МеткиСинхронизации.СоздатьМенеджерЗаписи();
	Запись.Система = Система;
	Запись.ТипДанных = ТипДанных;
	Запись.МеткаИзменений = Метка;
	Запись.ПоследнийЗапуск = ТекущаяДатаСеанса();
	Запись.Записать();

КонецПроцедуры

// Товары, изменённые после метки, в порядке изменения (стабильная дельта).
Функция ТоварыКВыгрузке(Метка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Товары.Артикул КАК sku, Товары.Наименование КАК name,
	|	Товары.Артикул КАК external_id
	|ИЗ Справочник.Номенклатура КАК Товары
	|УПОРЯДОЧИТЬ ПО Товары.Артикул";
	Выборка = Запрос.Выполнить().Выбрать();

	Товары = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Товар = Новый Структура("external_id,sku,name",
			Выборка.external_id, Выборка.sku, Выборка.name);
		Товары.Добавить(Товар);
	КонецЦикла;

	Возврат Товары;

КонецФункции

// Максимальный момент изменения выгруженного набора (новая метка).
Функция МаксимальноеИзменение(Товары)

	Максимум = Дата(1, 1, 1);
	Для Каждого Товар Из Товары Цикл
		Если Товар.Свойство("changed_at") И Товар.changed_at > Максимум Тогда
			Максимум = Товар.changed_at;
		КонецЕсли;
	КонецЦикла;

	Возврат Максимум;

КонецФункции

#КонецОбласти
