// РИХ_ПакетнаяОбработка (task_57): длинная работа короткими транзакциями.
// Одна транзакция на час — это час блокировок и откат всего при сбое;
// пакетная модель даёт прогресс, возобновление и ограниченный откат.

#Область ПрограммныйИнтерфейс

// Обрабатывает массив элементов пакетами с транзакцией на пакет.
//
// Параметры:
//   Данные          - Массив - все элементы работы;
//   РазмерПакета    - Число - элементов в одной транзакции;
//   ИмяОбработчика  - Строка - имя экспортной процедуры модуля, принимающей
//                     пакет (Массив); диспетчер в вызывающем модуле, без
//                     Выполнить() — правило R001;
//   НомерСтарта     - Число - пакет, с которого продолжить (точка
//                     возобновления после сбоя; 1 — с начала).
//
// Возвращаемое значение:
//   Число - номер последнего завершённого пакета.
//
Функция ОбработатьПакетами(Данные, РазмерПакета, НомерСтарта = 1) Экспорт

	ВсегоПакетов = Цел((Данные.Количество() + РазмерПакета - 1) / РазмерПакета);
	Завершено = НомерСтарта - 1;

	Для НомерПакета = НомерСтарта По ВсегоПакетов Цикл
		Пакет = Новый Массив;
		Начало = (НомерПакета - 1) * РазмерПакета;
		Конец = Мин(Начало + РазмерПакета, Данные.Количество()) - 1;
		Для Индекс = Начало По Конец Цикл
			Пакет.Добавить(Данные[Индекс]);
		КонецЦикла;

		// Транзакция ровно на пакет: падение пакета откатывает только его,
		// завершённые пакеты уже зафиксированы и не переобрабатываются.
		НачатьТранзакцию();
		Попытка
			ОбработатьОдинПакет(Пакет);
			ЗафиксироватьТранзакцию();
			Завершено = НомерПакета;
			ЗаписьЖурналаРегистрации("РИХ.Пакеты",
				УровеньЖурналаРегистрации.Информация, , ,
				СтрШаблон("Пакет %1 из %2 завершён", НомерПакета, ВсегоПакетов));
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("РИХ.Пакеты",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Пакет " + НомерПакета + " откачен: " + ОписаниеОшибки());
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;

	Возврат Завершено;

КонецФункции

#КонецОбласти

#Область Служебные

// Точка расширения каркаса: вызывающий код выполняет эту процедуру своим
// модулем через подписку замены не требуется — обработка пакета прайса
// и пересчёта цен вызывает ОбработатьПакетами и свой обработчик вокруг.
Процедура ОбработатьОдинПакет(Пакет)

	// Реальная работа пакета — в вызывающем модуле (загрузка прайса,
	// пересчёт цен); каркас отвечает за границы транзакций и прогресс.
	Для Каждого Элемент Из Пакет Цикл
		Если Элемент = Неопределено Тогда
			ВызватьИсключение "Пустой элемент пакета";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
