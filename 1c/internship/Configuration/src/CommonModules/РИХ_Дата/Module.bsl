#Область ПрограммныйИнтерфейс

// ЗАДАНИЕ task_15 (выполнено): функции ниже; проверки оформлены зеркалом
// (src/scripts/checks_dates.py), в sprint_9 (task_52) перенесу их в тестовый
// каркас. Покрытие проверок: 31 декабря, 29 февраля, переход года, пустая
// дата Дата(1,1,1), смена летнего времени.
//
// Единый закон времени проекта: в интеграционных контрактах даты передаются
// в UTC строкой ISO 8601 (2026-01-31T21:00:00Z, task_17); локальное время
// восстанавливает принимающая сторона. «Плюс три часа руками» запрещено:
// смещение меняется при переходе на летнее время, а пояс сервера может
// отличаться от пояса пользователя.

// Переводит локальную дату сеанса в универсальное время (UTC).
// Штатное преобразование платформы учитывает часовой пояс сеанса
// и переходы на летнее время.
//
// Параметры:
//   Дата - Дата - локальная дата сеанса.
//
// Возвращаемое значение:
//   Дата - то же мгновение в UTC.
//
Функция ВУниверсальную(Дата) Экспорт

	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Возврат Дата;
	КонецЕсли;

	Возврат УниверсальноеВремя(Дата, ЧасовойПоясСеанса());

КонецФункции

// Переводит универсальное время (UTC) в локальное время сеанса.
//
// Параметры:
//   Дата - Дата - мгновение в UTC.
//
// Возвращаемое значение:
//   Дата - локальная дата сеанса.
//
Функция ИзУниверсальной(Дата) Экспорт

	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Возврат Дата;
	КонецЕсли;

	Возврат МестноеВремя(Дата, ЧасовойПоясСеанса());

КонецФункции

// Возвращает начало и конец периода, в который попадает дата.
// Конец периода берётся штатными функциями платформы (КонецМесяца знает
// про 29 февраля, КонецДня — про 23:59:59), а не «дата плюс 30 дней».
// Пустая дата Дата(1,1,1) возвращается как есть обеими границами:
// она не Null и честно участвует в сравнениях, поэтому вызывающий код
// обязан исключать её явно, если пустая дата не нужна.
//
// Параметры:
//   Дата       - Дата - любая дата внутри периода;
//   ТипПериода - Строка - "День", "Неделя", "Месяц", "Квартал", "Год".
//
// Возвращаемое значение:
//   Структура - Ключи: Начало (Дата), Конец (Дата).
//
Функция ГраницыПериода(Дата, ТипПериода) Экспорт

	Результат = Новый Структура;
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Результат.Вставить("Начало", Дата);
		Результат.Вставить("Конец", Дата);
		Возврат Результат;
	КонецЕсли;

	Если ТипПериода = "День" Тогда
		Начало = НачалоДня(Дата);
		Конец = КонецДня(Дата);
	ИначеЕсли ТипПериода = "Неделя" Тогда
		Начало = НачалоНедели(Дата);
		Конец = КонецНедели(Дата);
	ИначеЕсли ТипПериода = "Месяц" Тогда
		Начало = НачалоМесяца(Дата);
		Конец = КонецМесяца(Дата);
	ИначеЕсли ТипПериода = "Квартал" Тогда
		Начало = НачалоКвартала(Дата);
		Конец = КонецКвартала(Дата);
	ИначеЕсли ТипПериода = "Год" Тогда
		Начало = НачалоГода(Дата);
		Конец = КонецГода(Дата);
	Иначе
		ВызватьИсключение СтрШаблон("Неизвестный тип периода: %1", ТипПериода);
	КонецЕсли;

	Результат.Вставить("Начало", Начало);
	Результат.Вставить("Конец", Конец);
	Возврат Результат;

КонецФункции

// Ниже — эталонная реализация границ дня как пример стиля кода проекта.

// Возвращает начало и конец указанных суток.
//
// Параметры:
//   Дата - Дата - любая дата внутри требуемых суток.
//
// Возвращаемое значение:
//   Структура - Ключи: Начало (Дата), Конец (Дата)
//
Функция ГраницыДня(Дата) Экспорт

	НачалоДня = НачалоДня(Дата);

	Результат = Новый Структура;
	Результат.Вставить("Начало", НачалоДня);
	Результат.Вставить("Конец", КонецДня(НачалоДня));

	Возврат Результат;

КонецФункции

