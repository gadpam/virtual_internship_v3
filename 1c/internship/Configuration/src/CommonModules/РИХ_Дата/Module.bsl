//   ВУниверсальную(Дата) / ИзУниверсальной(Дата)
//   ГраницыПериода(Дата, ТипПериода) — ТипПериода: "День","Неделя","Месяц","Квартал","Год"
// Тесты должны покрывать: 31 декабря, 29 февраля, переход года, пустую дату Дата(1,1,1).
//
// Ниже — эталонная реализация границ дня как пример стиля кода проекта.

// Возвращает начало и конец указанных суток.
//
// Параметры:
//   Дата - Дата - любая дата внутри требуемых суток.
//
// Возвращаемое значение:
//   Структура - Ключи: Начало (Дата), Конец (Дата)
//
Функция ГраницыДня(Дата) Экспорт

	НачалоДня = НачалоДня(Дата);

	Результат = Новый Структура;
	Результат.Вставить("Начало", НачалоДня);
	Результат.Вставить("Конец", КонецДня(НачалоДня));

	Возврат Результат;

КонецФункции

