// РИХ_Витрины (task_122): витрина продаж по дням из чеков и «Продаж».
// Идемпотентность — полная перезапись периода: день удаляется и пишется
// заново из источника, поэтому правки задним числом не плодят дублей.
// Сверка при наполнении обязательна: несошедшийся день не публикуется.

#Область ПрограммныйИнтерфейс

// Пересчитывает витрину за период полной перезаписью каждого дня.
// Несошедшийся день не публикуется, но и не останавливает остальные:
// иначе один битый день оставит всю витрину вчерашней. Проблемные дни
// собираются и возвращаются одним исключением со списком.
// Возвращает количество записанных строк витрины.
Функция ПересчитатьПродажиПоДням(ПериодС, ПериодПо) Экспорт

	ЗаписаноСтрок = 0;
	ПроблемныеДни = "";
	День = НачалоДня(ПериодС);
	Пока День <= НачалоДня(ПериодПо) Цикл
		Попытка
			ЗаписаноСтрок = ЗаписаноСтрок + ПересчитатьДень(День);
		Исключение
			ПроблемныеДни = ПроблемныеДни + ?(ПроблемныеДни = "", "", ", ")
				+ Формат(День, "ДФ=yyyy-MM-dd");
		КонецПопытки;
		День = День + 86400;
	КонецЦикла;
	Если ПроблемныеДни <> "" Тогда
		ВызватьИсключение "RIH-DQ-122: дни не опубликованы (сверка дня): "
			+ ПроблемныеДни + "; остальные дни периода пересчитаны";
	КонецЕсли;

	Возврат ЗаписаноСтрок;

КонецФункции

// Точка входа регламентного задания: закрытый вчерашний день к утру.
Процедура ОбновитьВитринуПродажЗаВчера() Экспорт

	Вчера = НачалоДня(ТекущаяДатаСеанса()) - 86400;
	ПересчитатьПродажиПоДням(Вчера, Вчера);

КонецПроцедуры

// Контрольная сумма источника за день: выручка нетто по «Продажам».
// С ней сравнивается записанная витрина до публикации дня.
Функция КонтрольнаяСуммаПродажЗаДень(День) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ЕСТЬNULL(СУММА(ПродажиОбороты.СуммаОборот), 0) КАК Сумма
	|ИЗ РегистрНакопления.Продажи.Обороты(&Начало, &Конец) КАК ПродажиОбороты";
	Запрос.УстановитьПараметр("Начало", День);
	Запрос.УстановитьПараметр("Конец", КонецДня(День));
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Сумма, 0);

КонецФункции

#КонецОбласти

#Область CDC

// Обработчик подписки на запись чека: бизнес-день чека в очередь
// пересчёта той же транзакцией, что и сам чек.
Процедура ЗафиксироватьИзменениеЧека(Источник, Отказ) Экспорт

	ЗафиксироватьДеньЧека(Источник, "запись");

КонецПроцедуры

// Обработчик подписки «перед удалением»: tombstone дня чека успевает
// записаться до физического удаления, иначе удаление невидимо дельте.
Процедура ЗафиксироватьУдалениеЧека(Источник, Отказ) Экспорт

	ЗафиксироватьДеньЧека(Источник, "удаление");

КонецПроцедуры

// Пересчитывает все дни из очереди CDC и очищает обработанные записи.
// Удаляются только записи, существовавшие на момент старта: запись,
// пришедшая от подписки во время обработки, обязана дожить до
// следующего запуска, а не стереться непересчитанной.
// Возвращает количество пересчитанных пар «день × магазин» витрины.
Функция ОбработатьОчередьПересчётаВитрины() Экспорт

	МоментСтарта = ТекущаяДатаСеанса();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ Очередь.День КАК День
	|ИЗ РегистрСведений.ОчередьПересчётаВитрины КАК Очередь
	|ГДЕ Очередь.МоментИзменения <= &МоментСтарта
	|УПОРЯДОЧИТЬ ПО Очередь.День";
	Запрос.УстановитьПараметр("МоментСтарта", МоментСтарта);
	Выборка = Запрос.Выполнить().Выбрать();
	ПересчитаноДней = 0;
	Пока Выборка.Следующий() Цикл
		ПересчитатьДень(Выборка.День);
		ПересчитаноДней = ПересчитаноДней + 1;
	КонецЦикла;

	Набор = РегистрыСведений.ОчередьПересчётаВитрины.СоздатьНаборЗаписей();
	Набор.Прочитать();
	Индекс = Набор.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Набор[Индекс].МоментИзменения <= МоментСтарта Тогда
			Набор.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Набор.Записать();

	Возврат ПересчитаноДней;

КонецФункции

// Дельта витрины для HTTP-выгрузки: строки изменённых дней с момента
// и сами дни, чтобы потребитель удалил агрегаты полностью исчезнувших.
Функция ДельтаПродажиПоДням(СМомента) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ Очередь.День КАК День
	|ИЗ РегистрСведений.ОчередьПересчётаВитрины КАК Очередь
	|ГДЕ Очередь.МоментИзменения >= &СМомента
	|УПОРЯДОЧИТЬ ПО Очередь.День";
	Запрос.УстановитьПараметр("СМомента", СМомента);
	Дни = Запрос.Выполнить().ВыгрузитьКолонку("День");

	ЗапросСтрок = Новый Запрос;
	ЗапросСтрок.Текст =
	"ВЫБРАТЬ Витрина.Период КАК День, Витрина.Магазин КАК Магазин,
	|	Витрина.Номенклатура КАК Номенклатура, Витрина.Количество КАК Количество,
	|	Витрина.Сумма КАК Сумма, Витрина.Маржа КАК Маржа
	|ИЗ РегистрСведений.ПродажиПоДням КАК Витрина
	|ГДЕ Витрина.Период В (&Дни)
	|УПОРЯДОЧИТЬ ПО Витрина.Период, Витрина.Магазин, Витрина.Номенклатура";
	ЗапросСтрок.УстановитьПараметр("Дни", Дни);

	Возврат Новый Структура("changedDays,rows", Дни,
		ЗапросСтрок.Выполнить().Выгрузить());

КонецФункции

#КонецОбласти

#Область Выгрузка

// Выгружает строки витрины за период в CSV и манифест к нему: версия
// формата, строк, контрольная сумма SHA-256. Получатель проверяет
// манифест до чтения данных: обрезанный файл отклоняется, а не
// «читается как получится»; неизвестная версия формата — тоже отказ.
Функция ВыгрузитьВитринуCSV(ПериодС, ПериодПо, ПутьФайла) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Витрина.Период КАК День, Витрина.Магазин КАК Магазин,
	|	Витрина.Номенклатура КАК Номенклатура, Витрина.Количество КАК Количество,
	|	Витрина.Сумма КАК Сумма, Витрина.Себестоимость КАК Себестоимость,
	|	Витрина.Маржа КАК Маржа
	|ИЗ РегистрСведений.ПродажиПоДням КАК Витрина
	|ГДЕ Витрина.Период МЕЖДУ &ПериодС И &ПериодПо
	|УПОРЯДОЧИТЬ ПО Витрина.Период, Витрина.Магазин, Витрина.Номенклатура";
	Запрос.УстановитьПараметр("ПериодС", ПериодС);
	Запрос.УстановитьПараметр("ПериодПо", ПериодПо);
	Выборка = Запрос.Выполнить().Выбрать();

	Запись = Новый ЗаписьТекста(ПутьФайла, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку("date;shop;sku;quantity;amount;cost;margin");
	Строк = 0;
	СуммаКонтроля = 0;
	Пока Выборка.Следующий() Цикл
		Запись.ЗаписатьСтроку(
			Формат(Выборка.День, "ДФ=yyyy-MM-dd") + ";"
			+ СокрЛП(Выборка.Магазин.Код) + ";"
			+ Выборка.Номенклатура.Артикул + ";"
			+ Формат(Выборка.Количество, "ЧДЦ=3; ЧРД=.; ЧГ=0") + ";"
			+ Формат(Выборка.Сумма, "ЧДЦ=2; ЧРД=.; ЧГ=0") + ";"
			+ Формат(Выборка.Себестоимость, "ЧДЦ=2; ЧРД=.; ЧГ=0") + ";"
			+ Формат(Выборка.Маржа, "ЧДЦ=2; ЧРД=.; ЧГ=0"));
		Строк = Строк + 1;
		СуммаКонтроля = СуммаКонтроля + Выборка.Сумма;
	КонецЦикла;
	Запись.Закрыть();

	ЧтениеФайла = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8);
	ТекстФайла = ЧтениеФайла.Прочитать();
	ЧтениеФайла.Закрыть();
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ТекстФайла);

	Возврат Новый Структура("Файл,ВерсияФормата,Строк,Сумма,Хеш",
		ПутьФайла, "sales-export/1", Строк, СуммаКонтроля,
		ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

// Одна страница витрины от курсора (день): потоковая выдача больших
// объёмов без «миллиона одним ответом». Следующая страница начинается
// строго после курсора, поэтому обрыв не означает «сначала».
// Потолок страницы — 1000 строк контракта: запрос потребителя больше
// потолка молча не «урезается», а нормализуется здесь, в одном месте.
Функция СтраницаВитрины(КурсорДень, РазмерСтраницы) Экспорт

	РазмерСтраницы = Мин(Макс(РазмерСтраницы, 1), 1000);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1000 Витрина.Период КАК День, Витрина.Магазин КАК Магазин,
	|	Витрина.Номенклатура КАК Номенклатура, Витрина.Количество КАК Количество,
	|	Витрина.Сумма КАК Сумма
	|ИЗ РегистрСведений.ПродажиПоДням КАК Витрина
	|ГДЕ Витрина.Период > &Курсор
	|УПОРЯДОЧИТЬ ПО Витрина.Период, Витрина.Магазин, Витрина.Номенклатура";
	Запрос.УстановитьПараметр("Курсор", КурсорДень);
	Строки = Запрос.Выполнить().Выгрузить();
	Пока Строки.Количество() > РазмерСтраницы Цикл
		Строки.Удалить(Строки.Количество() - 1);
	КонецЦикла;

	СледующийКурсор = КурсорДень;
	Если Строки.Количество() > 0 Тогда
		СледующийКурсор = Строки[Строки.Количество() - 1].День;
	КонецЕсли;

	Возврат Новый Структура("rows,nextCursor", Строки, СледующийКурсор);

КонецФункции

#КонецОбласти

#Область Сверка

// Порог уведомления о расхождении, проценты. Ноль годами не держится:
// шум без порога убьёт внимание владельца метрики за неделю.
Функция ПорогРасхожденияПроцентов() Экспорт

	Возврат 0.5;

КонецФункции

// Сверяет витрину с оперативным источником (чеки) за период по дням
// и магазинам и классифицирует каждое расхождение: свежесть (очередь
// CDC ещё не обработана), задним числом (закрытый период правили),
// правила (остальное: формулы разошлись, смотреть словарь метрик).
// Возвращает таблицу: День, Магазин, Источник, Витрина, Разница,
// Процент, Класс.
Функция РасхожденияВитрины(ПериодС, ПериодПо) Экспорт

	Расхождения = НоваяТаблицаРасхождений();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Источник.День КАК День, Источник.Магазин КАК Магазин,
	|	Источник.Сумма КАК СуммаИсточника, Витрина.Сумма КАК СуммаВитрины
	|ИЗ (ВЫБРАТЬ НАЧАЛОПЕРИОДА(Чеки.Дата, ДЕНЬ) КАК День, Чеки.Магазин КАК Магазин,
	|			СУММА(ВЫБОР КОГДА Чеки.ВидЧека = &Возврат
	|				ТОГДА -Товары.Сумма ИНАЧЕ Товары.Сумма КОНЕЦ) КАК Сумма
	|		ИЗ Документ.Чек КАК Чеки
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Чек.Товары КАК Товары
	|			ПО Товары.Ссылка = Чеки.Ссылка
	|		ГДЕ Чеки.Проведен И Чеки.Дата МЕЖДУ &ПериодС И &ПериодПо
	|		СГРУППИРОВАТЬ ПО НАЧАЛОПЕРИОДА(Чеки.Дата, ДЕНЬ), Чеки.Магазин) КАК Источник
	|	ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ Витрина.Период КАК День,
	|			Витрина.Магазин КАК Магазин, СУММА(Витрина.Сумма) КАК Сумма
	|		ИЗ РегистрСведений.ПродажиПоДням КАК Витрина
	|		ГДЕ Витрина.Период МЕЖДУ &ПериодС И &ПериодПо
	|		СГРУППИРОВАТЬ ПО Витрина.Период, Витрина.Магазин) КАК Витрина
	|	ПО Источник.День = Витрина.День И Источник.Магазин = Витрина.Магазин
	|ГДЕ ЕСТЬNULL(Источник.Сумма, 0) <> ЕСТЬNULL(Витрина.Сумма, 0)";
	Запрос.УстановитьПараметр("Возврат", "Возврат");
	Запрос.УстановитьПараметр("ПериодС", ПериодС);
	Запрос.УстановитьПараметр("ПериодПо", ПериодПо);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СуммаИсточника = ?(Выборка.СуммаИсточника = NULL, 0, Выборка.СуммаИсточника);
		СуммаВитрины = ?(Выборка.СуммаВитрины = NULL, 0, Выборка.СуммаВитрины);
		СтрокаРасхождения = Расхождения.Добавить();
		СтрокаРасхождения.День = Выборка.День;
		СтрокаРасхождения.Магазин = Выборка.Магазин;
		СтрокаРасхождения.Источник = СуммаИсточника;
		СтрокаРасхождения.Витрина = СуммаВитрины;
		СтрокаРасхождения.Разница = СуммаИсточника - СуммаВитрины;
		СтрокаРасхождения.Процент = ?(СуммаИсточника = 0, 100,
			Окр(100 * (СуммаИсточника - СуммаВитрины) / СуммаИсточника, 2));
		СтрокаРасхождения.Класс = КлассРасхождения(Выборка.День, Выборка.Магазин);
	КонецЦикла;

	Возврат Расхождения;

КонецФункции

// Сумма источника за весь период: знаменатель процента расхождения.
// Процент от суммы только расходящихся строк врал бы порогу: копейка
// в маленьком дне огромного периода выглядела бы катастрофой.
Функция СуммаИсточникаЗаПериод(ПериодС, ПериодПо)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ЕСТЬNULL(СУММА(ВЫБОР КОГДА Чеки.ВидЧека = &Возврат
	|		ТОГДА -Товары.Сумма ИНАЧЕ Товары.Сумма КОНЕЦ), 0) КАК Сумма
	|ИЗ Документ.Чек КАК Чеки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Чек.Товары КАК Товары
	|	ПО Товары.Ссылка = Чеки.Ссылка
	|ГДЕ Чеки.Проведен И Чеки.Дата МЕЖДУ &ПериодС И &ПериодПо";
	Запрос.УстановитьПараметр("Возврат", "Возврат");
	Запрос.УстановитьПараметр("ПериодС", ПериодС);
	Запрос.УстановитьПараметр("ПериодПо", ПериодПо);
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Сумма, 0);

КонецФункции

// Регламентная сверка: расхождения выше порога уходят уведомлением
// владельцу метрики «Выручка» (финансы) в журнал, а не «в журнал
// ради журнала». Возвращает итоги сверки для отчёта.
Функция СверкаВитрины(ПериодС, ПериодПо) Экспорт

	Расхождения = РасхожденияВитрины(ПериодС, ПериодПо);
	СуммаИсточника = СуммаИсточникаЗаПериод(ПериодС, ПериодПо);
	СуммаРазниц = 0;
	Для Каждого СтрокаРасхождения Из Расхождения Цикл
		СуммаРазниц = СуммаРазниц + СтрокаРасхождения.Разница;
	КонецЦикла;
	ПроцентПериода = ?(СуммаИсточника = 0, 0,
		Окр(100 * СуммаРазниц / СуммаИсточника, 2));
	УведомлениеОтправлено = Ложь;
	Если Расхождения.Количество() > 0
			И (ПроцентПериода > ПорогРасхожденияПроцентов()
				ИЛИ ПроцентПериода < -ПорогРасхожденияПроцентов()) Тогда
		РИХ_Интеграции.ЗаписатьВызов("mart", "СверкаВитрины", "in", "",
			200, "RIH-DQ-125", 0,
			"расхождение " + Формат(ПроцентПериода, "ЧДЦ=2; ЧГ=0")
			+ "% за период, строк: " + Формат(Расхождения.Количество(), "ЧГ=0")
			+ "; уведомление владельцу метрики M-001 (финансы)");
		УведомлениеОтправлено = Истина;
	КонецЕсли;

	Возврат Новый Структура("Расхождений,ПроцентПериода,УведомлениеОтправлено",
		Расхождения.Количество(), ПроцентПериода, УведомлениеОтправлено);

КонецФункции

// Точка входа регламентного задания сверки (после ночного обновления).
Процедура СверитьВитринуЗаВчера() Экспорт

	Вчера = НачалоДня(ТекущаяДатаСеанса()) - 86400;
	СверкаВитрины(НачалоМесяца(Вчера), Вчера);

КонецПроцедуры

#КонецОбласти

#Область Служебные

// Пустая таблица результата сверки витрины.
Функция НоваяТаблицаРасхождений()

	Расхождения = Новый ТаблицаЗначений;
	Расхождения.Колонки.Добавить("День");
	Расхождения.Колонки.Добавить("Магазин");
	Расхождения.Колонки.Добавить("Источник");
	Расхождения.Колонки.Добавить("Витрина");
	Расхождения.Колонки.Добавить("Разница");
	Расхождения.Колонки.Добавить("Процент");
	Расхождения.Колонки.Добавить("Класс");
