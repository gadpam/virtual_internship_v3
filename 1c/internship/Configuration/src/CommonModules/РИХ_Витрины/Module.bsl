// РИХ_Витрины (task_122): витрина продаж по дням из чеков и «Продаж».
// Идемпотентность — полная перезапись периода: день удаляется и пишется
// заново из источника, поэтому правки задним числом не плодят дублей.
// Сверка при наполнении обязательна: несошедшийся день не публикуется.

#Область ПрограммныйИнтерфейс

// Пересчитывает витрину за период полной перезаписью каждого дня.
// Возвращает количество записанных строк витрины.
Функция ПересчитатьПродажиПоДням(ПериодС, ПериодПо) Экспорт

	ЗаписаноСтрок = 0;
	День = НачалоДня(ПериодС);
	Пока День <= НачалоДня(ПериодПо) Цикл
		ЗаписаноСтрок = ЗаписаноСтрок + ПересчитатьДень(День);
		День = День + 86400;
	КонецЦикла;

	Возврат ЗаписаноСтрок;

КонецФункции

// Точка входа регламентного задания: закрытый вчерашний день к утру.
Процедура ОбновитьВитринуПродажЗаВчера() Экспорт

	Вчера = НачалоДня(ТекущаяДатаСеанса()) - 86400;
	ПересчитатьПродажиПоДням(Вчера, Вчера);

КонецПроцедуры

// Контрольная сумма источника за день: выручка нетто по «Продажам».
// С ней сравнивается записанная витрина до публикации дня.
Функция КонтрольнаяСуммаПродажЗаДень(День) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ЕСТЬNULL(СУММА(ПродажиОбороты.СуммаОборот), 0) КАК Сумма
	|ИЗ РегистрНакопления.Продажи.Обороты(&Начало, &Конец) КАК ПродажиОбороты";
	Запрос.УстановитьПараметр("Начало", День);
	Запрос.УстановитьПараметр("Конец", КонецДня(День));
	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Сумма, 0);

КонецФункции

#КонецОбласти

#Область Служебные

// Перезаписывает один день витрины агрегатом проведённых чеков.
Функция ПересчитатьДень(День)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Чеки.Магазин КАК Магазин,
	|	Товары.Номенклатура КАК Номенклатура,
	|	СУММА(ВЫБОР КОГДА Чеки.ВидЧека = &Возврат
	|			ТОГДА -Товары.Количество ИНАЧЕ Товары.Количество КОНЕЦ) КАК Количество,
	|	СУММА(ВЫБОР КОГДА Чеки.ВидЧека = &Возврат
	|			ТОГДА -Товары.Сумма ИНАЧЕ Товары.Сумма КОНЕЦ) КАК Сумма
	|ИЗ Документ.Чек КАК Чеки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Чек.Товары КАК Товары
	|	ПО Товары.Ссылка = Чеки.Ссылка
	|ГДЕ Чеки.Проведен И Чеки.Дата МЕЖДУ &НачалоДня И &КонецДня
	|СГРУППИРОВАТЬ ПО Чеки.Магазин, Товары.Номенклатура";
	Запрос.УстановитьПараметр("Возврат", "Возврат");
	Запрос.УстановитьПараметр("НачалоДня", День);
	Запрос.УстановитьПараметр("КонецДня", КонецДня(День));
	Агрегат = Запрос.Выполнить().Выгрузить();

	Набор = РегистрыСведений.ПродажиПоДням.СоздатьНаборЗаписей();
	Набор.Отбор.Период.Установить(День);
	Набор.Очистить();
	СуммаВитрины = 0;
	Для Каждого СтрокаАгрегата Из Агрегат Цикл
		Запись = Набор.Добавить();
		Запись.Период = День;
		Запись.Магазин = СтрокаАгрегата.Магазин;
		Запись.Номенклатура = СтрокаАгрегата.Номенклатура;
		Запись.Количество = СтрокаАгрегата.Количество;
		Запись.Сумма = СтрокаАгрегата.Сумма;
		// Себестоимости в оперативном учёте пока нет (партии — Q3):
		// честный 0 источника, а не выдуманная маржа.
		Запись.Себестоимость = 0;
		Запись.Маржа = СтрокаАгрегата.Сумма;
		СуммаВитрины = СуммаВитрины + СтрокаАгрегата.Сумма;
	КонецЦикла;

	Контроль = КонтрольнаяСуммаПродажЗаДень(День);
	Если Окр(СуммаВитрины, 2) <> Окр(Контроль, 2) Тогда
		ВызватьИсключение "RIH-DQ-122: витрина за " + Формат(День, "ДФ=yyyy-MM-dd")
			+ " не сошлась с регистром «Продажи»: " + Формат(СуммаВитрины, "ЧДЦ=2; ЧГ=0")
			+ " против " + Формат(Контроль, "ЧДЦ=2; ЧГ=0") + " — день не публикуется";
	КонецЕсли;
	Набор.Записать(Истина);

	Возврат Агрегат.Количество();

КонецФункции

#КонецОбласти
