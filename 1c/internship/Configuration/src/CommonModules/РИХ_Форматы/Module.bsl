// РИХ_Форматы (task_75): JSON и XML штатными средствами платформы.
// Никакого ручного склеивания строк JSON: ЗаписьJSON/ЧтениеJSON сами
// экранируют спецсимволы; ручная склейка — источник битых payload.

#Область ПрограммныйИнтерфейс

// Сериализует структуру (с вложенными структурами, массивами, датами
// и Неопределено) в строку JSON. Даты приводятся к ISO 8601 до записи.
//
// Параметры:
//   Данные - Структура, Массив, Дата, Строка, Число, Булево, Неопределено.
//
// Возвращаемое значение:
//   Строка - JSON.
//
Функция СтруктураВJSON(Данные) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьЗначениеJSON(Запись, Данные);

	Возврат Запись.Закрыть();

КонецФункции

// Читает строку JSON обратно в структуру/массив. Даты в ISO 8601
// остаются строками: вызывающий приводит типы осознанно (контракт
// важнее угадывания), кроме веток, где дата разбирается РИХ_ОбщегоНазначения.
//
// Параметры:
//   СтрокаJSON - Строка.
//
// Возвращаемое значение:
//   Структура, Массив, Строка, Число, Булево, Неопределено.
//
Функция JSONВСтруктуру(СтрокаJSON) Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Результат = ПрочитатьЗначениеJSONИзЧтения(Чтение);
	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

// Сериализует структуру в XML: элементы — по ключам, массивы —
// повторяющимся элементом Item, скаляры — текстом элемента.
//
// Параметры:
//   Данные - Структура - корень документа;
//   Корень - Строка - имя корневого элемента.
//
// Возвращаемое значение:
//   Строка - XML.
//
Функция СтруктураВXML(Данные, Корень = "Документ") Экспорт

	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьОбъявлениеXML();
	ЗаписатьЭлементXML(Запись, Корень, Данные);

	Возврат Запись.Закрыть();

КонецФункции

// Читает XML обратно в структуру: дочерние элементы — ключи,
// повторяющиеся Item — массив, текст элемента — строка.
//
// Параметры:
//   СтрокаXML - Строка.
//
// Возвращаемое значение:
//   Структура - содержимое корневого элемента.
//
Функция XMLВСтруктуру(СтрокаXML) Экспорт

	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(СтрокаXML);
	Чтение.ПерейтиКСодержимому();
	Результат = ПрочитатьЭлементXML(Чтение);
	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Служебные

// Рекурсивная запись значения JSON с приведением дат к ISO 8601.
Процедура ЗаписатьЗначениеJSON(Запись, Данные)

	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Запись.ЗаписатьНачалоОбъекта();
		Для Каждого Пара Из Данные Цикл
			Запись.ЗаписатьИмяСвойства(Пара.Ключ);
			ЗаписатьЗначениеJSON(Запись, Пара.Значение);
		КонецЦикла;
		Запись.ЗаписатьКонецОбъекта();
	ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
		Запись.ЗаписатьНачалоМассива();
		Для Каждого Элемент Из Данные Цикл
			ЗаписатьЗначениеJSON(Запись, Элемент);
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
	ИначеЕсли ТипЗнч(Данные) = Тип("Дата") Тогда
		Запись.ЗаписатьЗначение(РИХ_ОбщегоНазначения.СформироватьIso8601(Данные));
	ИначеЕсли Данные = Неопределено Тогда
		Запись.ЗаписатьNull();
	Иначе
		Запись.ЗаписатьЗначение(Данные);
	КонецЕсли;

КонецПроцедуры

// Рекурсивное чтение значения JSON из открытого чтения.
Функция ПрочитатьЗначениеJSONИзЧтения(Чтение)

	Если НЕ Чтение.Прочитать() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Чтение.ТипТекущегоЗначения = ТипЗначенияJSON.НачалоОбъекта Тогда
		Результат = Новый Структура;
		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипТекущегоЗначения = ТипЗначенияJSON.КонецОбъекта Тогда
				Прервать;
			КонецЕсли;
			Ключ = Чтение.ТекущееЗначение;
			Результат.Вставить(Ключ, ПрочитатьЗначениеJSONИзЧтения(Чтение));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Чтение.ТипТекущегоЗначения = ТипЗначенияJSON.НачалоМассива Тогда
		Результат = Новый Массив;
		Пока Истина Цикл
			Элемент = ПрочитатьЗначениеJSONИзЧтения(Чтение);
			Если Чтение.ТипТекущегоЗначения = ТипЗначенияJSON.КонецМассива Тогда
				Прервать;
			КонецЕсли;
			Результат.Добавить(Элемент);
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Чтение.ТипТекущегоЗначения = ТипЗначенияJSON.Null Тогда
		Возврат Неопределено;
	Иначе
		Возврат Чтение.ТекущееЗначение;
	КонецЕсли;

КонецФункции

// Рекурсивная запись элемента XML из структуры/массива/скаляра.
Процедура ЗаписатьЭлементXML(Запись, Имя, Данные)

	Запись.ЗаписатьНачалоЭлемента(Имя);
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Для Каждого Пара Из Данные Цикл
			ЗаписатьЭлементXML(Запись, Пара.Ключ, Пара.Значение);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
		Для Каждого Элемент Из Данные Цикл
			ЗаписатьЭлементXML(Запись, "Item", Элемент);
		КонецЦикла;
	ИначеЕсли ТипЗнч(Данные) = Тип("Дата") Тогда
		Запись.ЗаписатьТекст(РИХ_ОбщегоНазначения.СформироватьIso8601(Данные));
	ИначеЕсли Данные <> Неопределено Тогда
		Запись.ЗаписатьТекст(Строка(Данные));
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента();

КонецПроцедуры

// Рекурсивное чтение элемента XML в структуру/строку.
Функция ПрочитатьЭлементXML(Чтение)

	ИмяЭлемента = Чтение.Имя;
	Результат = Новый Структура;
	Текст = "";
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Дочерний = ПрочитатьЭлементXML(Чтение);
			Если Результат.Свойство(Чтение.Имя) Тогда
				// Повторяющийся элемент (Item массива) собираем списком
				Текущий = Результат[Чтение.Имя];
				Если ТипЗнч(Текущий) <> Тип("Массив") Тогда
					Список = Новый Массив;
					Список.Добавить(Текущий);
					Результат[Чтение.Имя] = Список;
					Текущий = Список;
				КонецЕсли;
				Текущий.Добавить(Дочерний);
			Иначе
				Результат.Вставить(Чтение.Имя, Дочерний);
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
			Текст = Текст + Чтение.Значение;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
