// РИХ_ЛояльностьКлиент (task_92): операции с баллами через mock_loyalty_api.
// Баллы — деньги клиента, поэтому: operationId рождается у нас до вызова,
// повтор безопасен по построению, а каждый исход виден в аудите.

#Область ПрограммныйИнтерфейс

// Баланс карты и последние операции партнёра.
Функция БалансКарты(Карта) Экспорт

	Возврат ВызватьЛояльность("GET", "/api/v1/cards/" + Карта + "/balance",
		Неопределено, "");

КонецФункции

// Начисление баллов за покупку (operationId — наш ключ идемпотентности).
Функция Начислить(ИдОперации, Карта, Баллы, Основание) Экспорт

	Тело = Новый Структура("operation_id,card,points,reason",
		ИдОперации, Карта, Баллы, Основание);
	Ответ = ОперацияСБаллами("accrue", ИдОперации, Карта, Баллы, Тело);

	Возврат Ответ;

КонецФункции

// Списание баллов в оплату; баллов меньше нужного — 422 партнёра,
// клиент не уходит в минус и не повторяет вслепую.
Функция Списать(ИдОперации, Карта, Баллы, Основание) Экспорт

	Тело = Новый Структура("operation_id,card,points,reason",
		ИдОперации, Карта, Баллы, Основание);
	Ответ = ОперацияСБаллами("redeem", ИдОперации, Карта, Баллы, Тело);

	Возврат Ответ;

КонецФункции

// Сторно операции возврата чека: ровно один раз, второе — 409 партнёра.
Функция ОтменитьОперацию(ИдОперации) Экспорт

	Ответ = ВызватьЛояльность("POST",
		"/api/v1/reverse?operation_id=" + ИдОперации, Неопределено, ИдОперации);
	ЗаписатьАудит(ИдОперации, "", "reverse", 0,
		?(Ответ.Свойство("status"), Ответ.status, "ошибка"),
		?(Ответ.Свойство("balance"), Ответ.balance, 0));

	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область Служебные

// Общая механика денежных операций: вызов + аудит любого исхода.
Функция ОперацияСБаллами(Тип, ИдОперации, Карта, Баллы, Тело)

	Попытка
		Ответ = ВызватьЛояльность("POST", "/api/v1/" + Тип, Тело, ИдОперации);
		Статус = ?(Ответ.Свойство("duplicate") И Ответ.duplicate,
			"дубликат", "подтверждена");
		ЗаписатьАудит(ИдОперации, Карта, Тип, Баллы, Статус,
			?(Ответ.Свойство("balance"), Ответ.balance, 0));
		Возврат Ответ;
	Исключение
		// Сеть: операция не подтверждена и не отклонена — аудит честно
		// фиксирует «недоступна», дальше её ведёт очередь task_95.
		ЗаписатьАудит(ИдОперации, Карта, Тип, Баллы, "недоступна", 0);
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Вызов партнёра по политике РИХ_ПовторныеПопытки (task_128):
// повторяемые исходы (сеть, 429, 5xx) повторяются с экспонентой и
// джиттером, неповторяемые (400/401/404/409/422) возвращаются сразу.
// Каждая попытка пишется в журнал со своим номером: серия повторов
// видна в мониторинге до звонка партнёра. Безопасность повтора даёт
// operationId: партнёр узнаёт наш ключ и не двоит баллы.
Функция ВызватьЛояльность(Метод, Путь, Тело, ИдОперации)

	// Предохранитель снаружи ретраев (task_129): открытый контур
	// отказывает мгновенно, не занимая поток ожиданием мертвеца.
	Если НЕ РИХ_Предохранители.РазрешитьВызов("loyalty") Тогда
		РИХ_Интеграции.ЗаписатьВызов("loyalty", Путь, "out", ИдОперации,
			503, "RIH-BREAKER-OPEN", 0,
			"вызов отклонён предохранителем без сети");
		ВызватьИсключение РИХ_Предохранители.ТекстОткрытогоПредохранителя("loyalty");
	КонецЕсли;
	Политика = РИХ_ПовторныеПопытки.ПолитикаПоУмолчанию();
	НачалоБюджета = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПопыткаНомер = 0;
	Пока ПопыткаНомер < Политика.МаксПопыток Цикл
		ПопыткаНомер = ПопыткаНомер + 1;
		НачалоВызова = ТекущаяУниверсальнаяДатаВМиллисекундах();
		КодОтвета = 0;
		Ответ = Неопределено;
		Попытка
			Ответ = ОднаПопыткаЛояльности(Метод, Путь, Тело);
			КодОтвета = Ответ.КодСостояния;
		Исключение
			КодОтвета = 0;
		КонецПопытки;
		РИХ_Интеграции.ЗаписатьВызов("loyalty", Путь, "out", ИдОперации,
			КодОтвета, ?(КодОтвета = 0, "RIH-503", ""),
			ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВызова,
			"попытка " + Формат(ПопыткаНомер, "ЧГ=0")
			+ " из " + Формат(Политика.МаксПопыток, "ЧГ=0"));
		Если Ответ <> Неопределено
				И НЕ РИХ_ПовторныеПопытки.ЭтоПовторяемаяОшибка(КодОтвета) Тогда
			РИХ_Предохранители.ЗафиксироватьУспех("loyalty");
			Возврат РИХ_Форматы.JSONВСтруктуру(Ответ.ПолучитьТелоКакСтроку());
		КонецЕсли;
		Если ПопыткаНомер >= Политика.МаксПопыток
				ИЛИ ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоБюджета
					>= Политика.БюджетСекунд * 1000 Тогда
			// Ошибка фиксируется финальная, после всех попыток:
			// иначе breaker считал бы каждую попытку отдельной смертью.
			РИХ_Предохранители.ЗафиксироватьОшибку("loyalty");
			ВызватьИсключение "RIH-503: лояльность недоступна после "
				+ Формат(ПопыткаНомер, "ЧГ=0") + " попыток";
		КонецЕсли;
		РИХ_ПовторныеПопытки.Пауза(
			РИХ_ПовторныеПопытки.ЗадержкаПопытки(Политика, ПопыткаНомер + 1));
	КонецЦикла;

КонецФункции

// Одна попытка HTTP-вызова партнёра (таймаут 5 с — task_127).
Функция ОднаПопыткаЛояльности(Метод, Путь, Тело)

	Соединение = Новый HTTPСоединение("127.0.0.1", 8021, , , , 5);
	Запрос = Новый HTTPЗапрос(Путь);
	Запрос.Заголовки.Вставить("X-Api-Key", КлючЛояльностиИзКонтура());
	Если Тело <> Неопределено Тогда
		Запрос.Заголовки.Вставить("Content-Type", "application/json");
		Запрос.УстановитьТелоИзСтроки(РИХ_Форматы.СтруктуруВJSON(Тело));
	КонецЕсли;

	Возврат Соединение.ВызватьHTTPМетод(Метод, Запрос);

КонецФункции

// Ключ лояльности — свой ключ контура (task_134), не магазина и не кода.
Функция КлючЛояльностиИзКонтура()

	Возврат Константы.РИХ_КлючЛояльности.Получить();

КонецФункции

// Запись аудита: баллы сверяются по этому регистру, а не по логам.
Процедура ЗаписатьАудит(ИдОперации, Карта, Тип, Баллы, Статус, БалансПосле)

	Запись = РегистрыСведений.АудитОперацийЛояльности.СоздатьМенеджерЗаписи();
	Запись.ИдОперации = ИдОперации;
	Запись.Карта = Карта;
	Запись.ТипОперации = Тип;
	Запись.Баллы = Баллы;
	Запись.Статус = Статус;
	Запись.БалансПосле = БалансПосле;
	Запись.МоментОперации = ТекущаяДатаСеанса();
	Запись.Записать();

КонецПроцедуры

#КонецОбласти
