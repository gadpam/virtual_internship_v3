// РИХ_МетрикиИнтеграций (task_114): метрики контура и алерт-правила.
// Источник — РС ЖурналИнтеграций (Сервис, Операция, Статус,
// ДлительностьМС, Период) и размер ОчередиОбмена. Метрика без порога —
// цифра для красоты; у каждой есть правило, превращающее её в действие.

#Область ПрограммныйИнтерфейс

// Собирает снимок метрик по сервисам журнала за последний час
// и пишет его в РС МетрикиИнтеграций одним моментом снимка.
Функция СобратьСнимокМетрик() Экспорт

	МоментСнимка = ТекущаяДатаСеанса();
	НачалоПериода = МоментСнимка - 3600;
	Для Каждого Сервис Из СервисыЖурнала(НачалоПериода) Цикл
		Статистика = СтатистикаСервиса(Сервис, НачалоПериода);
		ЗаписатьМетрику(Сервис, "requests_total", Статистика.Всего, МоментСнимка);
		ЗаписатьМетрику(Сервис, "error_share",
			?(Статистика.Всего = 0, 0, Статистика.Ошибок / Статистика.Всего * 100),
			МоментСнимка);
		ЗаписатьМетрику(Сервис, "latency_avg_ms", Статистика.СредняяЗадержка, МоментСнимка);
		ЗаписатьМетрику(Сервис, "latency_p95_ms", Статистика.Перцентиль95, МоментСнимка);
	КонецЦикла;
	ЗаписатьМетрику("queue", "queue_size", РазмерОчереди(), МоментСнимка);
	ЗаписатьМетрику("queue", "last_success_age_min",
		МинутСПоследнегоУспеха(), МоментСнимка);

	Возврат МоментСнимка;

КонецФункции

// Алерт-правила контура: очередь > 1000, доля ошибок > 5% за час
// (при хотя бы 20 вызовах), нет успешных обменов больше часа.
// Каждое срабатывание — запись журнала событий уровнем Ошибка.
Функция ПроверитьАлерты() Экспорт

	Сработавшие = Новый Массив;
	Если РазмерОчереди() > 1000 Тогда
		Сработавшие.Добавить("очередь > 1000 сообщений: разобрать мёртвую почту и партнёров");
	КонецЕсли;
	НачалоПериода = ТекущаяДатаСеанса() - 3600;
	Для Каждого Сервис Из СервисыЖурнала(НачалоПериода) Цикл
		Статистика = СтатистикаСервиса(Сервис, НачалоПериода);
		Если Статистика.Всего >= 20
			И Статистика.Ошибок / Статистика.Всего > 0.05 Тогда
			Сработавшие.Добавить("доля ошибок " + Сервис + " > 5% за час");
		КонецЕсли;
	КонецЦикла;
	Если МинутСПоследнегоУспеха() > 60 Тогда
		Сработавшие.Добавить("нет успешных обменов больше часа");
	КонецЕсли;

	Для Каждого Алерт Из Сработавшие Цикл
		ЗаписьЖурналаРегистрации("РИХ.Метрики.Алерт",
			УровеньЖурналаРегистрации.Ошибка, , , Алерт);
	КонецЦикла;

	Возврат Сработавшие;

КонецФункции

// JSON снимка для экспортёра Prometheus: integrationRequests
// (сервис/операция/статус/количество) и durations (выборки задержек).
Функция СнимокМетрикJSON() Экспорт

	НачалоПериода = ТекущаяДатаСеанса() - 3600;
	Снимок = Новый Структура;
	Снимок.Вставить("integrationRequests", ЗапросыДляЭкспортёра(НачалоПериода));
	Снимок.Вставить("durations", ЗадержкиДляЭкспортёра(НачалоПериода));
	Снимок.Вставить("queueSize", РазмерОчереди());

	Возврат РИХ_Форматы.СтруктуруВJSON(Снимок);

КонецФункции

#КонецОбласти

#Область Служебные

// Сервисы, встречающиеся в журнале за период.
Функция СервисыЖурнала(НачалоПериода)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ Журнал.Сервис КАК Сервис
	|ИЗ РегистрСведений.ЖурналИнтеграций КАК Журнал
	|ГДЕ Журнал.Период >= &Начало";
	Запрос.УстановитьПараметр("Начало", НачалоПериода);

	Возврат Запрос.Выполнить().ВыгрузитьКолонку("Сервис");

КонецФункции

// Агрегаты сервиса за период: всего, ошибок, средняя и p95 задержки.
Функция СтатистикаСервиса(Сервис, НачалоПериода)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Журнал.ДлительностьМС КАК Длительность, Журнал.Статус КАК Статус
	|ИЗ РегистрСведений.ЖурналИнтеграций КАК Журнал
	|ГДЕ Журнал.Сервис = &Сервис И Журнал.Период >= &Начало
	|УПОРЯДОЧИТЬ ПО Журнал.ДлительностьМС";
	Запрос.УстановитьПараметр("Сервис", Сервис);
	Запрос.УстановитьПараметр("Начало", НачалоПериода);
	Таблица = Запрос.Выполнить().Выгрузить();

	Статистика = Новый Структура("Всего,Ошибок,СредняяЗадержка,Перцентиль95", 0, 0, 0, 0);
	Сумма = 0;
	Для Каждого СтрокаЖурнала Из Таблица Цикл
		Статистика.Всего = Статистика.Всего + 1;
		Если СтрокаЖурнала.Статус >= 400 Тогда
			Статистика.Ошибок = Статистика.Ошибок + 1;
		КонецЕсли;
		Сумма = Сумма + СтрокаЖурнала.Длительность;
	КонецЦикла;
	Если Статистика.Всего > 0 Тогда
		Статистика.СредняяЗадержка = Сумма / Статистика.Всего;
		Индекс95 = Макс(Цел(Статистика.Всего * 0.95) - 1, 0);
		Статистика.Перцентиль95 = Таблица[Индекс95].Длительность;
	КонецЕсли;

	Возврат Статистика;

КонецФункции

// Сообщений, ждущих отправки прямо сейчас.
Функция РазмерОчереди()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ РегистрСведений.ОчередьОбмена КАК Очередь
	|ГДЕ Очередь.Статус В (&Активные)";
	Запрос.УстановитьПараметр("Активные", АктивныеСтатусыОчереди());
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество;

КонецФункции

// Статусы, в которых сообщение ещё не доставлено.
Функция АктивныеСтатусыОчереди()

	Статусы = Новый Массив;
	Статусы.Добавить("Новая");
	Статусы.Добавить("Отправляется");
	Статусы.Добавить("Отложена");
	Возврат Статусы;

КонецФункции

// Минут с последнего успешного (2xx) вызова в журнале.
Функция МинутСПоследнегоУспеха()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Журнал.Период КАК Период
	|ИЗ РегистрСведений.ЖурналИнтеграций КАК Журнал
	|ГДЕ Журнал.Статус >= 200 И Журнал.Статус < 300
	|УПОРЯДОЧИТЬ ПО Журнал.Период УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат 9999;
	КонецЕсли;

	Возврат (ТекущаяДатаСеанса() - Выборка.Период) / 60;

КонецФункции

// Группировка вызовов для экспортёра: сервис, операция, статус, количество.
Функция ЗапросыДляЭкспортёра(НачалоПериода)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Журнал.Сервис КАК system, Журнал.Операция КАК operation,
	|	Журнал.Статус КАК status, КОЛИЧЕСТВО(*) КАК count
	|ИЗ РегистрСведений.ЖурналИнтеграций КАК Журнал
	|ГДЕ Журнал.Период >= &Начало
	|СГРУППИРОВАТЬ ПО Журнал.Сервис, Журнал.Операция, Журнал.Статус";
	Запрос.УстановитьПараметр("Начало", НачалоПериода);
	Таблица = Запрос.Выполнить().Выгрузить();

	Результат = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Результат.Добавить(Новый Структура("system,operation,status,count",
			СтрокаТаблицы.system, СтрокаТаблицы.operation,
			Формат(СтрокаТаблицы.status, "ЧГ=0"), СтрокаТаблицы.count));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Выборки задержек для гистограммы экспортёра по сервисам и операциям.
Функция ЗадержкиДляЭкспортёра(НачалоПериода)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Журнал.Сервис КАК system, Журнал.Операция КАК operation,
	|	Журнал.ДлительностьМС КАК sample
	|ИЗ РегистрСведений.ЖурналИнтеграций КАК Журнал
	|ГДЕ Журнал.Период >= &Начало";
	Запрос.УстановитьПараметр("Начало", НачалоПериода);
	Таблица = Запрос.Выполнить().Выгрузить();

	ПоГруппам = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Ключ = СтрокаТаблицы.system + "/" + СтрокаТаблицы.operation;
		ВыборкаЗадержек = ПоГруппам.Получить(Ключ);
		Если ВыборкаЗадержек = Неопределено Тогда
			ВыборкаЗадержек = Новый Массив;
			ПоГруппам.Вставить(Ключ, ВыборкаЗадержек);
		КонецЕсли;
		ВыборкаЗадержек.Добавить(СтрокаТаблицы.sample);
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого Пара Из ПоГруппам Цикл
		Части = СтрРазделить(Пара.Ключ, "/");
		Результат.Добавить(Новый Структура("system,operation,samples",
			Части[0], Части[1], Пара.Значение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Одна строка снимка метрик.
Процедура ЗаписатьМетрику(Сервис, Метрика, Значение, МоментСнимка)

	Запись = РегистрыСведений.МетрикиИнтеграций.СоздатьМенеджерЗаписи();
	Запись.Система = Сервис;
	Запись.Метрика = Метрика;
	Запись.Значение = Значение;
	Запись.МоментСнимка = МоментСнимка;
	Запись.Записать();

КонецПроцедуры

#КонецОбласти
