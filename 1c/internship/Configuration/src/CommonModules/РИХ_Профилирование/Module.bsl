// РИХ_Профилирование (task_56): точечные замеры операций.
// Пара Начать/Завершить оборачивает ровно измеряемый участок: подготовка
// данных вне пары не попадает в число — главная ошибка бытовых замеров.

#Область ПрограммныйИнтерфейс

// Начинает замер: возвращает метку времени начала (секунды с долями
// даёт ТекущаяУниверсальнаяДатаВМиллисекундах).
//
// Возвращаемое значение:
//   Число - миллисекунды начала.
//
Функция НачатьЗамер() Экспорт

	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах();

КонецФункции

// Завершает замер и пишет результат в РС ЗамерыПроизводительности.
//
// Параметры:
//   НачалоМС - Число - результат НачатьЗамер;
//   Операция - Строка - имя операции, стабильное между прогонами;
//   Контекст - Строка - объём и условия ("1 млн движений, пачка 1000").
//
// Возвращаемое значение:
//   Число - длительность в миллисекундах.
//
Функция ЗавершитьЗамер(НачалоМС, Операция, Контекст) Экспорт

	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМС;

	Запись = РегистрыСведений.ЗамерыПроизводительности.СоздатьМенеджерЗаписи();
	Запись.Момент = ТекущаяДатаСеанса();
	Запись.Операция = Операция;
	Запись.ДлительностьМС = Длительность;
	Запись.Контекст = Контекст;
	Запись.Записать();

	Возврат Длительность;

КонецФункции

#КонецОбласти
