#Область ПрограммныйИнтерфейс

// Строит XDTO-заказ из документа поступления: тот же документ, что
// отдаётся и в JSON (РИХ_Форматы), — форматы сравниваются на одних данных.
//
// Параметры:
//   Документ - ДокументСсылка.ПоступлениеТоваров.
//
// Возвращаемое значение:
//   ОбъектXDTO - типа {http://rih.example/xdto/1}Заказ.
//
Функция ПоступлениеВЗаказXDTO(Документ) Экспорт

	Пакет = ФабрикаXDTO.Пакеты.Получить("http://rih.example/xdto/1");
	ТипЗаказа = Пакет.Получить("Заказ");
	ТипПозиции = Пакет.Получить("ПозицияЗаказа");

	Заказ = ФабрикаXDTO.Создать(ТипЗаказа);
	Заказ.ВнешнийИдентификатор = Строка(Документ.УникальныйИдентификатор());

	ЗапросСтрок = Новый Запрос;
	ЗапросСтрок.Текст =
	"ВЫБРАТЬ Товары.Номенклатура.Артикул КАК Артикул,
	|	Товары.Количество КАК Количество, Товары.Цена КАК Цена
	|ИЗ Документ.ПоступлениеТоваров.Товары КАК Товары
	|ГДЕ Товары.Ссылка = &Ссылка";
	ЗапросСтрок.УстановитьПараметр("Ссылка", Документ);
	Выборка = ЗапросСтрок.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Позиция = ФабрикаXDTO.Создать(ТипПозиции);
		Позиция.Артикул = Выборка.Артикул;
		Позиция.Количество = Выборка.Количество;
		Позиция.Цена = Выборка.Цена;
		Заказ.Позиции.Добавить(Позиция);
	КонецЦикла;

	Возврат Заказ;

КонецФункции

// Формирует сообщение в духе EnterpriseData (task_102): заголовок
// с отправителем/получателем и каталог товаров типами пакета.
// КД 3 сгенерировала бы это сообщение правилами; здесь оно собрано
// кодом, чтобы структура была видна и проверялась схемой пакета.
//
// Параметры:
//   Получатель - Строка - код узла-получателя (BP, BRANCH...).
//
// Возвращаемое значение:
//   Строка - XML сообщения обмена.
//
Функция СообщениеКаталогаEnterpriseData(Получатель) Экспорт

	Пакет = ФабрикаXDTO.Пакеты.Получить("http://rih.example/xdto/1");
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("Message");
	Запись.ЗаписатьАтрибут("xmlns", "http://rih.example/xdto/1");
	Запись.ЗаписатьНачалоЭлемента("Header");
	Запись.ЗаписатьАтрибут("Sender", "RIH");
	Запись.ЗаписатьАтрибут("Recipient", Получатель);
	Запись.ЗаписатьАтрибут("Format", "EnterpriseData-RIH/1.0");
	Запись.ЗаписатьКонецЭлемента();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Товары.Артикул КАК Артикул, Товары.Наименование КАК Наименование
	|ИЗ Справочник.Номенклатура КАК Товары";
	Выборка = Запрос.Выполнить().Выбрать();
	Запись.ЗаписатьНачалоЭлемента("Body");
	Пока Выборка.Следующий() Цикл
		Товар = ФабрикаXDTO.Создать(Пакет.Получить("Продукт"));
		Товар.Артикул = Выборка.Артикул;
		Товар.Цена = 0;
		Запись.ЗаписатьНачалоЭлемента("CatalogObject");
		Запись.ЗаписатьАтрибут("Type", "Продукт");
		Запись.ЗаписатьАтрибут("Артикул", Выборка.Артикул);
		Запись.ЗаписатьАтрибут("Наименование", Выборка.Наименование);
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();

	Возврат Запись.Закрыть();

КонецФункции

// Читает входящий JSON заказа фабрикой XDTO: несоответствие схеме —
// исключение на границе, бизнес-логика битый заказ не видит.
//
// Параметры:
//   СтрокаJSON - Строка - тело запроса партнёра.
//
// Возвращаемое значение:
//   ОбъектXDTO - типа Заказ из пакета РИХ_Обмен_1.
//
Функция ЗаказИзJSON(СтрокаJSON) Экспорт

	Пакет = ФабрикаXDTO.Пакеты.Получить("http://rih.example/xdto/1");
	ТипЗаказа = Пакет.Получить("Заказ");

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Заказ = ФабрикаXDTO.ПрочитатьJSON(Чтение, ТипЗаказа);
	Чтение.Закрыть();

	Возврат Заказ;

КонецФункции

#КонецОбласти
