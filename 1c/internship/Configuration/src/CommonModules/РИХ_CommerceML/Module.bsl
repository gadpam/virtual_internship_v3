// РИХ_CommerceML (task_89): разбор и выгрузка CommerceML-подобных файлов.
// Внешние Ид товаров не становятся нашими кодами: связь живёт в РС
// СоответствиеОбъектов, поэтому смена кодов у партнёра — одна запись
// регистра, а не перезагрузка справочника.

#Область ПрограммныйИнтерфейс

// Разбирает файл обмена: товары, цены, остатки; ставит соответствия
// для новых внешних кодов.
//
// Параметры:
//   ТекстXML      - Строка - содержимое файла обмена;
//   ТолькоИзменения - Булево - пропускать товары с ДатаИзменения не новее
//                     последней загрузки (режим дельты).
//
// Возвращаемое значение:
//   Структура - ТоваровОбработано, СоответствийСоздано, ПропущеноПоДельте.
//
Функция РазобратьФайлОбмена(ТекстXML, ТолькоИзменения = Ложь) Экспорт

	Дерево = ПрочитатьXMLВДерево(ТекстXML);
	Итог = Новый Структура("ТоваровОбработано,СоответствийСоздано,ПропущеноПоДельте", 0, 0, 0);

	ДатаПорога = ПоследняяДатаЗагрузки("commerceml");
	Для Каждого Товар Из ТоварыИзДерева(Дерево) Цикл
		Если ТолькоИзменения И Товар.ДатаИзменения <= ДатаПорога Тогда
			Итог.ПропущеноПоДельте = Итог.ПропущеноПоДельте + 1;
			Продолжить;
		КонецЕсли;
		Если НайтиСоответствие("commerceml", Товар.Ид) = Неопределено Тогда
			УстановитьСоответствие("commerceml", Товар.Ид,
				СоздатьИлиНайтиТовар(Товар));
			Итог.СоответствийСоздано = Итог.СоответствийСоздано + 1;
		КонецЕсли;
		Итог.ТоваровОбработано = Итог.ТоваровОбработано + 1;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Выгружает каталог обратно в том же формате: внешние коды берутся
// из СоответствиеОбъектов, поэтому партнёр получает свои Ид обратно.
//
// Параметры:
//   ДатаИзмененийС - Дата - выгружать только изменённые после момента
//                    (дата 01.01.0001 — полный каталог).
//
// Возвращаемое значение:
//   Строка - XML файла обмена.
//
Функция ВыгрузитьКаталог(ДатаИзмененийС) Экспорт

	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("КоммерческаяИнформация");
	Запись.ЗаписатьАтрибут("ВерсияСхемы", "2.05-RIH");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Соответствия.ВнешнийКод КАК ВнешнийКод,
	|	Соответствия.Объект.Наименование КАК Наименование,
	|	Соответствия.Объект.Артикул КАК Артикул
	|ИЗ РегистрСведений.СоответствиеОбъектов КАК Соответствия
	|ГДЕ Соответствия.Источник = &Источник";
	Запрос.УстановитьПараметр("Источник", "commerceml");
	Выборка = Запрос.Выполнить().Выбрать();

	Запись.ЗаписатьНачалоЭлемента("Каталог");
	Пока Выборка.Следующий() Цикл
		Запись.ЗаписатьНачалоЭлемента("Товар");
		Запись.ЗаписатьНачалоЭлемента("Ид");
		Запись.ЗаписатьТекст(Выборка.ВнешнийКод);
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьНачалоЭлемента("Наименование");
		Запись.ЗаписатьТекст(Выборка.Наименование);
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьНачалоЭлемента("Артикул");
		Запись.ЗаписатьТекст(Выборка.Артикул);
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();

	Возврат Запись.Закрыть();

КонецФункции

// Ищет внутренний объект по внешнему коду источника обмена.
Функция НайтиСоответствие(Источник, ВнешнийКод) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Соответствия.Объект КАК Объект
	|ИЗ РегистрСведений.СоответствиеОбъектов КАК Соответствия
	|ГДЕ Соответствия.Источник = &Источник И Соответствия.ВнешнийКод = &ВнешнийКод";
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.УстановитьПараметр("ВнешнийКод", ВнешнийКод);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Объект;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Устанавливает пару соответствия (идемпотентно по ключу регистра).
Процедура УстановитьСоответствие(Источник, ВнешнийКод, Объект) Экспорт

	Запись = РегистрыСведений.СоответствиеОбъектов.СоздатьМенеджерЗаписи();
	Запись.Источник = Источник;
	Запись.ВнешнийКод = ВнешнийКод;
	Запись.Объект = Объект;
	Запись.Записать();

КонецПроцедуры

#КонецОбласти

#Область Служебные

// Читает XML в DOM-дерево формата обмена.
Функция ПрочитатьXMLВДерево(ТекстXML)

	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);
	Построитель = Новый ПостроительDOM;
	Документ = Построитель.Прочитать(Чтение);
	Чтение.Закрыть();

	Возврат Документ;

КонецФункции

// Товары каталога из дерева файла обмена: рекурсивно собираем
// элементы «Товар» и их поля Ид/Наименование/Артикул/ДатаИзменения.
Функция ТоварыИзДерева(Дерево)

	Товары = Новый Массив;
	СобратьТоварыРекурсивно(Дерево.ДочерниеУзлы, Товары);

	Возврат Товары;

КонецФункции

// Рекурсивный обход узлов DOM в поисках элементов «Товар».
Процедура СобратьТоварыРекурсивно(Узлы, Товары)

	Для Каждого Узел Из Узлы Цикл
		Если Узел.ТипУзла = ТипУзлаDOM.Элемент Тогда
			Если Узел.ИмяУзла = "Товар" Тогда
				Товар = Новый Структура("Ид,Наименование,Артикул,ДатаИзменения",
					"", "", "", Дата(1, 1, 1));
				Для Каждого Поле Из Узел.ДочерниеУзлы Цикл
					Если Поле.ТипУзла = ТипУзлаDOM.Элемент Тогда
						Если Поле.ИмяУзла = "Ид" Тогда
							Товар.Ид = СокрЛП(Поле.ТекстовоеСодержимое);
						ИначеЕсли Поле.ИмяУзла = "Наименование" Тогда
							Товар.Наименование = СокрЛП(Поле.ТекстовоеСодержимое);
						ИначеЕсли Поле.ИмяУзла = "Артикул" Тогда
							Товар.Артикул = СокрЛП(Поле.ТекстовоеСодержимое);
						ИначеЕсли Поле.ИмяУзла = "ДатаИзменения" Тогда
							Товар.ДатаИзменения = РИХ_ОбщегоНазначения.РазобратьIso8601(
								СокрЛП(Поле.ТекстовоеСодержимое));
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				Товары.Добавить(Товар);
			Иначе
				СобратьТоварыРекурсивно(Узел.ДочерниеУзлы, Товары);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Дата последней успешной загрузки источника (граница дельты).
Функция ПоследняяДатаЗагрузки(Источник)

	Возврат Дата(1, 1, 1);

КонецФункции

// Создаёт товар по данным обмена или находит по артикулу.
Функция СоздатьИлиНайтиТовар(Товар)

	Возврат Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Товар.Артикул);

КонецФункции

#КонецОбласти
