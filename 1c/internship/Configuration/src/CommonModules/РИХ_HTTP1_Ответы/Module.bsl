///////////////////////////////////////////////////////////////////////////////////////////////////////
// РИХ_HTTP1_Ответы
//
// Формирование ответов HTTP-сервиса RIH (/hs/rih/v1): успешные ответы и ошибки
// единого формата (internship/docs/api/error_format.md). Модуль серверный:
// методы вызываются из модуля HTTP-сервиса, интерфейса здесь нет.
//
// История заданий:
//   task_74 — изучение модуля и первые дополнения (коды состояния, заголовки);
//   task_79 — ответы первого HTTP-сервиса RIH строятся этими функциями;
//   task_82 — единый формат ошибок: структура ошибки переедет в
//             РИХ_ОбщегоНазначения.СтруктураОшибки(), здесь останется только
//             обёртка в HTTPСервисОтвет.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Формирует ответ HTTP-сервиса с телом JSON.
//
// Параметры:
//   Данные       - Структура, Соответствие - данные ответа (ключи - camelCase, task_82).
//   КодСостояния - Число - HTTP-код ответа, по умолчанию 200.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - ответ с заголовком Content-Type: application/json.
//
Функция ОтветJSON(Данные, КодСостояния = 200) Экспорт

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстJSON(Данные), КодировкаТекста.UTF8);
	Возврат Ответ;

КонецФункции

// Формирует ответ об ошибке единого формата RIH (error_format.md):
// code, message, incidentId, timestamp - клиент парсит кодом, а не человеком.
//
// Параметры:
//   КодСостояния - Число  - HTTP-код (400, 404, 409, 422, 500...).
//   Код          - Строка - машиночитаемый код из справочника error_format.md.
//   Сообщение    - Строка - короткое описание для человека, без стека и секретов.
//   Инцидент     - Строка - идентификатор инцидента; пусто - сгенерировать новый.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - ответ с телом ошибки единого формата.
//
Функция ОтветОбОшибке(КодСостояния, Код, Сообщение, Инцидент = "") Экспорт

	Ошибка = Новый Структура;
	Ошибка.Вставить("code", Код);
	Ошибка.Вставить("message", Сообщение);
	Ошибка.Вставить("incidentId", ?(ЗначениеЗаполнено(Инцидент), Инцидент,
		Строка(Новый УникальныйИдентификатор())));
	Ошибка.Вставить("timestamp", Формат(ТекущаяУниверсальнаяДата(),
		"ДФ=yyyy-MM-ddTHH:mm:ssZ"));

	Возврат ОтветJSON(Ошибка, КодСостояния);

КонецФункции

// Превращает исключение маршрута в ответ 500 единого формата (task_82):
// клиент получает короткий текст и incidentId, полный текст уходит
// в журнал интеграций и журнал регистрации — стек наружу не отдаётся.
//
// Параметры:
//   Сервис   - Строка - имя внешнего контура (shop, loyalty, ...);
//   Операция - Строка - маршрут, например "POST /orders";
//   Описание - Строка - ОписаниеОшибки() перехваченного исключения.
//
// Возвращаемое значение:
//   HTTPСервисОтвет - 500 с телом {code: RIH-500, message, incidentId, timestamp}.
//
Функция ОтветПоИсключению(Сервис, Операция, Описание) Экспорт

	Инцидент = Строка(Новый УникальныйИдентификатор());
	РИХ_Интеграции.ЗаписатьВызов(Сервис, Операция, "in", "", 500,
		"RIH-500", 0, "инцидент " + Инцидент);
	ЗаписьЖурналаРегистрации("РИХ.HTTP",
		УровеньЖурналаРегистрации.Ошибка, , ,
		"Инцидент " + Инцидент + ": " + Операция + " — " + Описание);

	Возврат ОтветОбОшибке(500, "RIH-500",
		"Операция не выполнена. Обратитесь в поддержку, инцидент " + Инцидент,
		Инцидент);

КонецФункции

// Сериализует данные в строку JSON (UTF-8 при отправке ставит ОтветJSON).
// Ручная конкатенация строк вместо этой функции запрещена: кавычки
// в наименованиях товаров ломают JSON (см. теорию task_74).
//
// Параметры:
//   Данные - Структура, Соответствие, Массив - сериализуемые данные.
//
// Возвращаемое значение:
//   Строка - текст JSON.
//
Функция ТекстJSON(Данные) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти
