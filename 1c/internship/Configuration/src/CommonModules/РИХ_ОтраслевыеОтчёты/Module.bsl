// РИХ_ОтраслевыеОтчёты (task_119): форма ПРОД-25 отраслевому оператору.
// Отчёт собирается из учёта (чеки и регистр «Продажи»), проверяется
// контрольными соотношениями отдельным модулем до отправки и уходит
// файлом; отправленная версия неизменяема, исправление — новая версия.

#Область ПрограммныйИнтерфейс

// Собирает форму ПРОД-25 за период из проведённых чеков: раздел А
// по магазинам и раздел Б итогами. Возвращает структуру формы.
Функция СформироватьФормуПродаж(ПериодС, ПериодПо) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Чеки.Магазин КАК Магазин,
	|	СУММА(ВЫБОР КОГДА Чеки.ВидЧека = &Возврат ТОГДА 0 ИНАЧЕ Чеки.СуммаЧека КОНЕЦ) КАК Продажи,
	|	СУММА(ВЫБОР КОГДА Чеки.ВидЧека = &Возврат ТОГДА Чеки.СуммаЧека ИНАЧЕ 0 КОНЕЦ) КАК Возвраты,
	|	СУММА(ВЫБОР КОГДА Чеки.ВидЧека = &Возврат ТОГДА 0 ИНАЧЕ 1 КОНЕЦ) КАК ЧековПродаж,
	|	СУММА(ВЫБОР КОГДА Чеки.ВидЧека = &Возврат ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК ЧековВозвратов
	|ИЗ Документ.Чек КАК Чеки
	|ГДЕ Чеки.Проведен И Чеки.Дата МЕЖДУ &ПериодС И &ПериодПо
	|СГРУППИРОВАТЬ ПО Чеки.Магазин
	|УПОРЯДОЧИТЬ ПО Чеки.Магазин";
	Запрос.УстановитьПараметр("Возврат", "Возврат");
	Запрос.УстановитьПараметр("ПериодС", ПериодС);
	Запрос.УстановитьПараметр("ПериодПо", ПериодПо);

	СтрокиМагазинов = Новый Массив;
	Итоги = Новый Структура("sales,returns,net,receipts,returnReceipts", 0, 0, 0, 0, 0);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаФормы = Новый Структура(
			"shop,sales,returns,net,receipts,returnReceipts",
			СокрЛП(Выборка.Магазин.Код), Выборка.Продажи, Выборка.Возвраты,
			Выборка.Продажи - Выборка.Возвраты,
			Выборка.ЧековПродаж, Выборка.ЧековВозвратов);
		СтрокиМагазинов.Добавить(СтрокаФормы);
		Итоги.sales = Итоги.sales + Выборка.Продажи;
		Итоги.returns = Итоги.returns + Выборка.Возвраты;
		Итоги.net = Итоги.net + СтрокаФормы.net;
		Итоги.receipts = Итоги.receipts + Выборка.ЧековПродаж;
		Итоги.returnReceipts = Итоги.returnReceipts + Выборка.ЧековВозвратов;
	КонецЦикла;

	Возврат Новый Структура(
		"form,periodFrom,periodTo,recipients,stores,totals",
		"ПРОД-25", ПериодС, ПериодПо, СтрокиМагазинов.Количество(),
		СтрокиМагазинов, Итоги);

КонецФункции

// Все контрольные соотношения формы одним списком ошибок (код + текст).
// Пустой список — форма готова к выгрузке; оператор применит те же КС.
Функция ПроверитьФорму(Форма) Экспорт

	Ошибки = Новый Массив;
	ПроверитьПолнотуМагазинов(Форма, Ошибки);
	ПроверитьАрифметикуСтрок(Форма, Ошибки);
	ПроверитьИтогиРазделов(Форма, Ошибки);
	ПроверитьПолучателей(Форма, Ошибки);
	ПроверитьНеотрицательность(Форма, Ошибки);
	ПроверитьВозвратыНеВышеПродаж(Форма, Ошибки);
	Возврат Ошибки;

КонецФункции

// КС-04 отдельно: период шапки против периода выгрузки файла.
Функция ПроверитьПериодВыгрузки(Форма, ПериодС, ПериодПо) Экспорт

	Если Форма.periodFrom <> ПериодС ИЛИ Форма.periodTo <> ПериодПо Тогда
		Возврат "КС-04: период формы не совпадает с периодом выгрузки";
	КонецЕсли;

	Возврат "";

КонецФункции

// Выгружает форму в файл JSON и возвращает его текст и SHA-256:
// файл и квитанция хранятся парой, хеш связывает их без доверия именам.
Функция ВыгрузитьФайл(Форма) Экспорт

	ТекстФайла = РИХ_Форматы.СтруктураВJSON(Форма);
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ТекстФайла);

	Возврат Новый Структура("Текст,Хеш", ТекстФайла,
		ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

// Создаёт документ версии отчёта в статусе «Черновик».
Функция СоздатьОтчёт(Форма) Экспорт

	Документ = Документы.ОтраслевойОтчёт.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.КодФормы = Форма.form;
	Документ.ПериодНачало = Форма.periodFrom;
	Документ.ПериодКонец = Форма.periodTo;
	Документ.НомерВерсии = 1;
	Документ.Статус = "Черновик";
	Документ.ДанныеФормы = РИХ_Форматы.СтруктураВJSON(Форма);
	Документ.Записать();

	Возврат Документ.Ссылка;

КонецФункции

// Отправляет версию оператору (имитация шлюза): проверки до отправки,
// снимок и хеш фиксируются, квитанция пишется в регистр квитанций.
// Отклонение переводит отчёт в «ТребуетсяКорректировка» в тот же день.
Функция ОтправитьОтчёт(ОтчётСсылка) Экспорт

	Объект = ОтчётСсылка.ПолучитьОбъект();
	Если Объект.Статус <> "Черновик" Тогда
		ВызватьИсключение "RIH-409: отправить можно только черновик, статус: "
			+ Объект.Статус;
	КонецЕсли;
	Форма = РИХ_Форматы.JSONВСтруктуру(Объект.ДанныеФормы);
	Ошибки = ПроверитьФорму(Форма);
	ОшибкаПериода = ПроверитьПериодВыгрузки(Форма,
		Объект.ПериодНачало, Объект.ПериодКонец);
	Если ЗначениеЗаполнено(ОшибкаПериода) Тогда
		Ошибки.Добавить(ОшибкаПериода);
	КонецЕсли;
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "RIH-422: форма не прошла проверки: "
			+ СтрСоединить(Ошибки, "; ");
	КонецЕсли;

	Файл = ВыгрузитьФайл(Форма);
	Объект.ХешФайла = Файл.Хеш;
	Объект.Статус = "Отправлен";
	ОтветОператора = ИмитацияОтветаОператора(Форма, Файл.Хеш);
	Объект.НомерКвитанции = ОтветОператора.НомерКвитанции;
	Объект.Статус = ОтветОператора.СтатусОтчёта;
	Объект.Записать();
	ЗаписатьКвитанцию(Объект, ОтветОператора);

	Возврат ОтветОператора;

КонецФункции

// Рождает корректирующую версию: новый документ, ссылка на предыдущий,
// причина обязательна. Отправленная версия при этом не изменяется.
Функция СоздатьКорректировку(ОтчётСсылка, Причина, ИсправленнаяФорма) Экспорт

	Если НЕ ЗначениеЗаполнено(СокрЛП(Причина)) Тогда
		ВызватьИсключение "RIH-422: у корректировки обязательна причина";
	КонецЕсли;
	Предыдущий = ОтчётСсылка.ПолучитьОбъект();
	Если Предыдущий.Статус <> "Отклонён"
			И Предыдущий.Статус <> "ТребуетсяКорректировка" Тогда
		ВызватьИсключение "RIH-409: корректировка возможна только после отклонения";
	КонецЕсли;

	Документ = Документы.ОтраслевойОтчёт.СоздатьДокумент();
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.КодФормы = Предыдущий.КодФормы;
	Документ.ПериодНачало = Предыдущий.ПериодНачало;
	Документ.ПериодКонец = Предыдущий.ПериодКонец;
	Документ.НомерВерсии = Предыдущий.НомерВерсии + 1;
	Документ.ПредыдущаяВерсия = ОтчётСсылка;
	Документ.ПричинаКорректировки = Причина;
	Документ.Статус = "Черновик";
	Документ.ДанныеФормы = РИХ_Форматы.СтруктураВJSON(ИсправленнаяФорма);
	Документ.Записать();

	Возврат Документ.Ссылка;

КонецФункции

// История версий от первой к текущей по цепочке предыдущих.
Функция ИсторияВерсий(ОтчётСсылка) Экспорт

	Цепочка = Новый Массив;
	Текущая = ОтчётСсылка;
	Пока ЗначениеЗаполнено(Текущая) Цикл
		Цепочка.Вставить(0, Текущая);
		Текущая = Текущая.ПредыдущаяВерсия;
	КонецЦикла;

	Возврат Цепочка;

КонецФункции

#КонецОбласти

#Область КонтрольныеСоотношения

// КС-01: каждая строка раздела А — существующий магазин справочника.
Процедура ПроверитьПолнотуМагазинов(Форма, Ошибки)

	Для Каждого СтрокаФормы Из Форма.stores Цикл
		Если НЕ ЗначениеЗаполнено(Справочники.Склады.НайтиПоКоду(
				СтрокаФормы.shop)) Тогда
			Ошибки.Добавить("КС-01: магазин не найден в справочнике: "
				+ СтрокаФормы.shop);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// КС-02: чистая выручка строки равна продажи минус возвраты.
Процедура ПроверитьАрифметикуСтрок(Форма, Ошибки)

	Для Каждого СтрокаФормы Из Форма.stores Цикл
		Если Окр(СтрокаФормы.net, 2)
				<> Окр(СтрокаФормы.sales - СтрокаФормы.returns, 2) Тогда
			Ошибки.Добавить("КС-02: чистая выручка не сходится у магазина "
				+ СтрокаФормы.shop);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// КС-03: раздел Б равен суммам раздела А по всем показателям.
Процедура ПроверитьИтогиРазделов(Форма, Ошибки)

	СуммаПродаж = 0;
	СуммаВозвратов = 0;
	СуммаЧеков = 0;
	Для Каждого СтрокаФормы Из Форма.stores Цикл
		СуммаПродаж = СуммаПродаж + СтрокаФормы.sales;
		СуммаВозвратов = СуммаВозвратов + СтрокаФормы.returns;
		СуммаЧеков = СуммаЧеков + СтрокаФормы.receipts;
	КонецЦикла;
	Если Окр(СуммаПродаж, 2) <> Окр(Форма.totals.sales, 2)
			ИЛИ Окр(СуммаВозвратов, 2) <> Окр(Форма.totals.returns, 2)
			ИЛИ СуммаЧеков <> Форма.totals.receipts Тогда
		Ошибки.Добавить("КС-03: итоги раздела Б не равны суммам раздела А");
	КонецЕсли;

КонецПроцедуры

// КС-05: количество получателей заполнено и равно строкам раздела А.
Процедура ПроверитьПолучателей(Форма, Ошибки)

	Если Форма.recipients <= 0
			ИЛИ Форма.recipients <> Форма.stores.Количество() Тогда
		Ошибки.Добавить("КС-05: количество получателей не равно числу магазинов");
	КонецЕсли;

КонецПроцедуры

// КС-06: отрицательных продаж, возвратов и чеков в форме не бывает.
Процедура ПроверитьНеотрицательность(Форма, Ошибки)

	Для Каждого СтрокаФормы Из Форма.stores Цикл
		Если СтрокаФормы.sales < 0 ИЛИ СтрокаФормы.returns < 0
				ИЛИ СтрокаФормы.receipts < 0 ИЛИ СтрокаФормы.returnReceipts < 0 Тогда
			Ошибки.Добавить("КС-06: отрицательный показатель у магазина "
				+ СтрокаФормы.shop);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// КС-07: возвраты магазина не превышают его продажи за период.
Процедура ПроверитьВозвратыНеВышеПродаж(Форма, Ошибки)

	Для Каждого СтрокаФормы Из Форма.stores Цикл
		Если Окр(СтрокаФормы.returns, 2) > Окр(СтрокаФормы.sales, 2) Тогда
			Ошибки.Добавить("КС-07: возвраты выше продаж у магазина "
				+ СтрокаФормы.shop);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Служебные

// Пишет квитанцию оператора в регистр квитанций рядом с отчётом.
Процедура ЗаписатьКвитанцию(ОбъектОтчёта, ОтветОператора)

	Запись = РегистрыСведений.КвитанцииОператора.СоздатьМенеджерЗаписи();
	Запись.НомерКвитанции = ОтветОператора.НомерКвитанции;
	Запись.Отчёт = ОбъектОтчёта.Ссылка;
	Запись.СтатусПриёма = ОтветОператора.СтатусПриёма;
	Запись.ДатаПолучения = ТекущаяДатаСеанса();
	Запись.ХешФайла = ОбъектОтчёта.ХешФайла;
	Запись.ТекстПротокола = ОтветОператора.Протокол;
	Запись.Записать();

КонецПроцедуры

// Имитация шлюза оператора (в боевом контуре — HTTP вызов оператора):
// магазин без внешнего кода оператора отклоняется протоколом КС-01,
// остальные формы принимаются с номером квитанции.
Функция ИмитацияОтветаОператора(Форма, ХешФайла)

	Для Каждого СтрокаФормы Из Форма.stores Цикл
		Если СтрНайти(СтрокаФормы.shop, "SHOP-") <> 1 Тогда
			Возврат Новый Структура(
				"НомерКвитанции,СтатусПриёма,СтатусОтчёта,Протокол",
				"ПР-" + Прав(Строка(Новый УникальныйИдентификатор), 8),
				"Отклонён", "ТребуетсяКорректировка",
				"КС-01 оператора: магазин не сопоставлен реестру оператора: "
				+ СтрокаФормы.shop);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура(
		"НомерКвитанции,СтатусПриёма,СтатусОтчёта,Протокол",
		"КВ-" + Прав(Строка(Новый УникальныйИдентификатор), 8),
		"Принят", "Принят", "контрольные соотношения пройдены");

КонецФункции

#КонецОбласти
