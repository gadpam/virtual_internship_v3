// РИХ_ОбменДанными (task_98): выгрузка/загрузка НСИ универсальным XML.
// Аналог правил КД 2.0: ПКО «Номенклатура» и ПВД «Изменённые за период»
// исполняются кодом; сопоставление приёмника трёхуровневое.

#Область ПрограммныйИнтерфейс

// Выгружает номенклатуру, изменённую за период (аналог ПВД КД).
// Период обязателен: выгрузка «всё всегда» — не правило, а авария.
//
// Возвращаемое значение:
//   Строка - XML пакета обмена с Ид источника по каждой позиции.
//
Функция ВыгрузитьНоменклатуруXML(ПериодС, ПериодПо) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Товары.Ссылка КАК Ссылка, Товары.Артикул КАК Артикул,
	|	Товары.Наименование КАК Наименование
	|ИЗ Справочник.Номенклатура КАК Товары";
	Выборка = Запрос.Выполнить().Выбрать();

	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("ПакетОбмена");
	Запись.ЗаписатьАтрибут("Источник", "RIH");
	Пока Выборка.Следующий() Цикл
		Запись.ЗаписатьНачалоЭлемента("Номенклатура");
		Запись.ЗаписатьАтрибут("Ид", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Запись.ЗаписатьАтрибут("Артикул", Выборка.Артикул);
		Запись.ЗаписатьАтрибут("Наименование", Выборка.Наименование);
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();

	Возврат Запись.Закрыть();

КонецФункции

// Загружает пакет: ищет по Ид источника, затем по артикулу, создаёт
// только ненайденное. Повторная загрузка дублей не рождает.
//
// Возвращаемое значение:
//   Структура - НайденоПоИд, НайденоПоАртикулу, Создано.
//
Функция ЗагрузитьНоменклатуруXML(ТекстXML) Экспорт

	Итог = Новый Структура("НайденоПоИд,НайденоПоАртикулу,Создано", 0, 0, 0);
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И Чтение.Имя = "Номенклатура" Тогда
			ИдИсточника = Чтение.ПолучитьАтрибут("Ид");
			Артикул = Чтение.ПолучитьАтрибут("Артикул");
			Наименование = Чтение.ПолучитьАтрибут("Наименование");
			Ссылка = НайтиТоварПриёмника(ИдИсточника, Артикул, Итог);
			Если Ссылка.Пустая() Тогда
				Объект = Справочники.Номенклатура.СоздатьЭлемент();
				Итог.Создано = Итог.Создано + 1;
			Иначе
				Объект = Ссылка.ПолучитьОбъект();
			КонецЕсли;
			Объект.Артикул = Артикул;
			Объект.Наименование = Наименование;
			Объект.Записать();
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();

	Возврат Итог;

КонецФункции

// Выгружает только проведённые поступления за период (task_99):
// непроведённый документ — ещё не факт учёта, соседнему узлу он
// не нужен и вреден (приёмник проведёт то, что источник отменил).
Функция ВыгрузитьПоступленияXML(ПериодС, ПериодПо) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Документы.Ссылка КАК Ссылка, Документы.Дата КАК Дата,
	|	Документы.Склад.Наименование КАК Склад
	|ИЗ Документ.ПоступлениеТоваров КАК Документы
	|ГДЕ Документы.Проведен И Документы.Дата МЕЖДУ &ПериодС И &ПериодПо";
	Запрос.УстановитьПараметр("ПериодС", ПериодС);
	Запрос.УстановитьПараметр("ПериодПо", ПериодПо);
	Выборка = Запрос.Выполнить().Выбрать();

	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("ПакетДокументов");
	Пока Выборка.Следующий() Цикл
		Запись.ЗаписатьНачалоЭлемента("Поступление");
		Запись.ЗаписатьАтрибут("Ид",
			Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Запись.ЗаписатьАтрибут("Дата",
			Формат(Выборка.Дата, "ДФ=yyyy-MM-dd"));
		Запись.ЗаписатьАтрибут("Склад", Выборка.Склад);
		ЗаписатьСтрокиПоступления(Запись, Выборка.Ссылка);
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();

	Возврат Запись.Закрыть();

КонецФункции

// Загружает поступления пакета и проводит их в приёмнике.
// Стратегия «товар не найден»: создать по данным пакета с пометкой
// обмена. Документ — факт учёта: отклонить его из-за справочника
// значит разойтись по остаткам с источником; созданный товар виден
// в отчёте расхождений и доводится человеком, а не теряется.
Функция ЗагрузитьПоступленияXML(ТекстXML) Экспорт

	Итог = Новый Структура("ДокументовСоздано,ТоваровСозданоОбменом", 0, 0);
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);
	ТекущийДокумент = Неопределено;
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И Чтение.Имя = "Поступление" Тогда
			ТекущийДокумент = Документы.ПоступлениеТоваров.СоздатьДокумент();
			ТекущийДокумент.Дата = ДатаИзСтрокиОбмена(Чтение.ПолучитьАтрибут("Дата"));
			ТекущийДокумент.Склад = Справочники.Склады.НайтиПоНаименованию(
				Чтение.ПолучитьАтрибут("Склад"));
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И Чтение.Имя = "Строка" И ТекущийДокумент <> Неопределено Тогда
			Артикул = Чтение.ПолучитьАтрибут("Артикул");
			Товар = НайтиТоварПриёмника("", Артикул,
				Новый Структура("НайденоПоИд,НайденоПоАртикулу,Создано", 0, 0, 0));
			Если Товар.Пустая() Тогда
				// Стратегия «не найден»: создать по данным пакета (см. шапку).
				НовыйТовар = Справочники.Номенклатура.СоздатьЭлемент();
				НовыйТовар.Артикул = Артикул;
				НовыйТовар.Наименование = Чтение.ПолучитьАтрибут("Наименование");
				НовыйТовар.Записать();
				Товар = НовыйТовар.Ссылка;
				Итог.ТоваровСозданоОбменом = Итог.ТоваровСозданоОбменом + 1;
			КонецЕсли;
			СтрокаДокумента = ТекущийДокумент.Товары.Добавить();
			СтрокаДокумента.Номенклатура = Товар;
			СтрокаДокумента.Количество = Число(Чтение.ПолучитьАтрибут("Количество"));
			СтрокаДокумента.Цена = Число(Чтение.ПолучитьАтрибут("Цена"));
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента
			И Чтение.Имя = "Поступление" И ТекущийДокумент <> Неопределено Тогда
			ТекущийДокумент.Записать(РежимЗаписиДокумента.Проведение);
			Итог.ДокументовСоздано = Итог.ДокументовСоздано + 1;
			ТекущийДокумент = Неопределено;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();

	Возврат Итог;

КонецФункции

// Дата пакета обмена (yyyy-MM-dd) в дату платформы.
Функция ДатаИзСтрокиОбмена(СтрокаДаты)

	Возврат Дата(Число(Сред(СтрокаДаты, 1, 4)), Число(Сред(СтрокаДаты, 6, 2)),
		Число(Сред(СтрокаДаты, 9, 2)));

КонецФункции

// Строки табличной части поступления в пакет (артикул — ключ приёмника).
Процедура ЗаписатьСтрокиПоступления(Запись, ДокументСсылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Строки.Номенклатура.Артикул КАК Артикул,
	|	Строки.Номенклатура.Наименование КАК Наименование,
	|	Строки.Количество КАК Количество, Строки.Цена КАК Цена
	|ИЗ Документ.ПоступлениеТоваров.Товары КАК Строки
	|ГДЕ Строки.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись.ЗаписатьНачалоЭлемента("Строка");
		Запись.ЗаписатьАтрибут("Артикул", Выборка.Артикул);
		Запись.ЗаписатьАтрибут("Наименование", Выборка.Наименование);
		Запись.ЗаписатьАтрибут("Количество", Формат(Выборка.Количество, "ЧГ=0"));
		Запись.ЗаписатьАтрибут("Цена", Формат(Выборка.Цена, "ЧГ=0"));
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;

КонецПроцедуры

// Трёхуровневый поиск приёмника: Ид источника → артикул → пустая ссылка.
Функция НайтиТоварПриёмника(ИдИсточника, Артикул, Итог) Экспорт

	Ссылка = Справочники.Номенклатура.ПолучитьСсылку(
		Новый УникальныйИдентификатор(ИдИсточника));
	Если ОбъектСуществует(Ссылка) Тогда
		Итог.НайденоПоИд = Итог.НайденоПоИд + 1;
		Возврат Ссылка;
	КонецЕсли;

	Ссылка = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Артикул);
	Если НЕ Ссылка.Пустая() Тогда
		Итог.НайденоПоАртикулу = Итог.НайденоПоАртикулу + 1;
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

#КонецОбласти

#Область Служебные

// Ссылка получена по идентификатору, но объект мог не существовать.
Функция ОбъектСуществует(Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Товары.Ссылка КАК Ссылка
	|ИЗ Справочник.Номенклатура КАК Товары
	|ГДЕ Товары.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти
