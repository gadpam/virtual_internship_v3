// РИХ_Валидация — проверки входных данных (task_38).
// Серверный общий модуль: правила одинаковы для формы, обменов и HTTP —
// валидация, живущая только в форме, обходится первым же обменом.
// Функции возвращают Ложь/Истину или заполняют массив ошибок целиком:
// пользователь видит все ошибки сразу, а не по одной за проведение.

#Область ПрограммныйИнтерфейс

// Проверяет, что количество положительно. Ноль в поступлении — не «пустая
// строка», а ошибка ввода: движение с нулём не несёт смысла.
//
// Параметры:
//   Количество - Число - проверяемое количество.
//
// Возвращаемое значение:
//   Булево - Истина, если количество > 0.
//
Функция КоличествоПоложительно(Количество) Экспорт

	Возврат Количество > 0;

КонецФункции

// Проверяет, что дата документа не в будущем. Завтрашнее поступление —
// почти всегда опечатка годом или днём, а не товар из будущего (task_15).
//
// Параметры:
//   Дата - Дата - дата документа.
//
// Возвращаемое значение:
//   Булево - Истина, если дата не позже конца текущего дня.
//
Функция ДатаНеВБудущем(Дата) Экспорт

	Возврат Дата <= КонецДня(ТекущаяДатаСеанса());

КонецФункции

// Проверяет, что склад можно использовать: заполнен и не помечен
// на удаление. Помеченный склад не виден в выборе, но ссылка на него
// могла прийти обменом — поэтому проверка серверная, а не форменная.
//
// Параметры:
//   Склад - СправочникСсылка.Склады - проверяемый склад.
//
// Возвращаемое значение:
//   Булево - Истина, если склад пригоден для движений.
//
Функция СкладПригоден(Склад) Экспорт

	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НЕ Склад.ПометкаУдаления;

КонецФункции

// Проверяет, что номенклатура — товар, а не услуга: услуге нельзя делать
// складское движение (остатков у неё нет, task_21).
//
// Параметры:
//   Номенклатура - СправочникСсылка.Номенклатура - проверяемый товар.
//
// Возвращаемое значение:
//   Булево - Истина, если это не услуга.
//
Функция НоменклатураНеУслуга(Номенклатура) Экспорт

	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НЕ Номенклатура.ЭтоУслуга;

КонецФункции

// Собирает все ошибки документа поступления одним списком (сводка ошибок).
// Каждая ошибка — структура с полем формы: вызывающий код показывает
// сообщения с привязкой к полям, курсор переходит к первому ошибочному.
//
// Параметры:
//   Документ - ДокументОбъект.ПоступлениеТоваров - проверяемый документ.
//
// Возвращаемое значение:
//   Массив - элементы: Структура (Поле, Текст). Пустой = ошибок нет.
//
Функция ОшибкиПоступления(Документ) Экспорт

	Ошибки = Новый Массив;

	Если НЕ СкладПригоден(Документ.Склад) Тогда
		Ошибки.Добавить(НоваяОшибка("Склад", "Склад не выбран или помечен на удаление"));
	КонецЕсли;
	Если НЕ ДатаНеВБудущем(Документ.Дата) Тогда
		Ошибки.Добавить(НоваяОшибка("Дата", "Дата документа в будущем"));
	КонецЕсли;

	Для Каждого СтрокаТоваров Из Документ.Товары Цикл
		ПрефиксПоля = "Товары[" + Формат(Документ.Товары.Индекс(СтрокаТоваров), "ЧГ=0") + "].";
		Если НЕ НоменклатураНеУслуга(СтрокаТоваров.Номенклатура) Тогда
			Ошибки.Добавить(НоваяОшибка(ПрефиксПоля + "Номенклатура",
				"Услугу нельзя оприходовать на склад"));
		КонецЕсли;
		Если НЕ КоличествоПоложительно(СтрокаТоваров.Количество) Тогда
			Ошибки.Добавить(НоваяОшибка(ПрефиксПоля + "Количество",
				"Количество должно быть больше нуля"));
		КонецЕсли;
	КонецЦикла;

	Возврат Ошибки;

КонецФункции

#КонецОбласти

#Область Служебные

Функция НоваяОшибка(Поле, Текст)

	Возврат Новый Структура("Поле,Текст", Поле, Текст);

КонецФункции

#КонецОбласти
