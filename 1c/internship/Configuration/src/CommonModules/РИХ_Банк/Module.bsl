// РИХ_Банк (task_118): выписка банка становится учётом, а не перебором.
// Загрузка — одна транзакция на пакет: сначала сверка итогов файла
// с секцией счёта, потом разметка платежей; половинная выписка в учёте
// не живёт. Нераспознанное не теряется, а уходит в ручной разбор.

#Область ПрограммныйИнтерфейс

// Разбирает текст выписки 1CClientBankExchange в структуру:
// шапка и итоги счёта плюс массив платежей с направлением и контрагентом.
Функция РазобратьВыписку(ТекстФайла) Экспорт

	Результат = Новый Структура(
		"РасчСчет,НачальныйОстаток,ВсегоПоступило,ВсегоСписано,КонечныйОстаток,Платежи",
		"", 0, 0, 0, 0, Новый Массив);
	ТекущийПлатёж = Неопределено;
	ТекущиеИтоги = Ложь;
	Для Каждого СтрокаФайла Из СтрРазделить(ТекстФайла, Символы.ПС) Цикл
		СтрокаОчищенная = СокрЛП(СтрокаФайла);
		Если СтрокаОчищенная = "КонецДокумента" И ТекущийПлатёж <> Неопределено Тогда
			ДополнитьПлатёж(ТекущийПлатёж, Результат.РасчСчет);
			Результат.Платежи.Добавить(ТекущийПлатёж);
			ТекущийПлатёж = Неопределено;
			Продолжить;
		КонецЕсли;
		Если СтрокаОчищенная = "СекцияРасчСчет" Тогда
			ТекущиеИтоги = Истина;
			Продолжить;
		КонецЕсли;
		Если СтрокаОчищенная = "КонецРасчСчет" Тогда
			ТекущиеИтоги = Ложь;
			Продолжить;
		КонецЕсли;
		ПозицияРавно = СтрНайти(СтрокаФайла, "=");
		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = СокрЛП(Лев(СтрокаФайла, ПозицияРавно - 1));
		Значение = СокрЛП(Сред(СтрокаФайла, ПозицияРавно + 1));
		Если Ключ = "СекцияДокумент" Тогда
			ТекущийПлатёж = Новый Структура(
				"ВидДокумента,Номер,Дата,Сумма,Плательщик,ПлательщикСчет,ПлательщикИНН,"
				+ "Получатель,ПолучательСчет,ПолучательИНН,Назначение",
				Значение, "", Дата(1, 1, 1), 0, "", "", "", "", "", "", "");
		ИначеЕсли Ключ = "КонецДокумента" И ТекущийПлатёж <> Неопределено Тогда
			ДополнитьПлатёж(ТекущийПлатёж, Результат.РасчСчет);
			Результат.Платежи.Добавить(ТекущийПлатёж);
			ТекущийПлатёж = Неопределено;
		ИначеЕсли Ключ = "СекцияРасчСчет" Тогда
			ТекущиеИтоги = Истина;
		ИначеЕсли Ключ = "КонецРасчСчет" Тогда
			ТекущиеИтоги = Ложь;
		ИначеЕсли ТекущийПлатёж <> Неопределено Тогда
			ЗаполнитьПолеПлатежа(ТекущийПлатёж, Ключ, Значение);
		ИначеЕсли ТекущиеИтоги Тогда
			ЗаполнитьПолеИтогов(Результат, Ключ, Значение);
		ИначеЕсли Ключ = "РасчСчет" Тогда
			Результат.РасчСчет = Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Загружает выписку целиком: итоги сверены до разметки, каждый платёж
// применён не более одного раза, ответ — цифры загрузки для отчёта.
Функция ЗагрузитьВыписку(ТекстФайла, ХешФайла) Экспорт

	Данные = РазобратьВыписку(ТекстФайла);
	НачатьТранзакцию();
	Попытка
		ПроверитьИтогиВыписки(Данные);
		Новых = 0;
		Дублей = 0;
		Авто = 0;
		Вручную = 0;
		ВиденныеВФайле = Новый Соответствие;
		Для Каждого Платёж Из Данные.Платежи Цикл
			Ключ = КлючПлатежа(Платёж);
			Если ВиденныеВФайле.Получить(Ключ) <> Неопределено
					ИЛИ ПлатёжУжеЗагружен(Ключ) Тогда
				Дублей = Дублей + 1;
				Продолжить;
			КонецЕсли;
			ВиденныеВФайле.Вставить(Ключ, Истина);
			Сопоставление = СопоставитьПлатёж(Платёж);
			ЗаписатьПлатёж(Ключ, Платёж, Сопоставление, ХешФайла);
			Новых = Новых + 1;
			Если Сопоставление.Статус = "автоматически" Тогда
				Авто = Авто + 1;
			Иначе
				Вручную = Вручную + 1;
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Новый Структура("Всего,Новых,Дублей,Авто,Вручную",
		Данные.Платежи.Количество(), Новых, Дублей, Авто, Вручную);

КонецФункции

// Разбирает назначение платежа активными шаблонами регистра
// ШаблоныНазначенийПлатежей (или встроенными, пока регистр пуст):
// маркер находит тип основания, первое «числовое» слово после него — номер.
Функция СопоставитьПлатёж(Платёж) Экспорт

	НазначениеНРег = НРег(Платёж.Назначение);
	Для Каждого Шаблон Из АктивныеШаблоны() Цикл
		ПозицияМаркера = СтрНайти(НазначениеНРег, НРег(Шаблон.Маркер));
		Если ПозицияМаркера = 0 Тогда
			Продолжить;
		КонецЕсли;
		Номер = НомерОснованияПосле(Платёж.Назначение,
			ПозицияМаркера + СтрДлина(Шаблон.Маркер));
		Если ЗначениеЗаполнено(Номер) Тогда
			Возврат Новый Структура("ТипОснования,НомерОснования,Статус",
				Шаблон.ТипОснования, Номер, "автоматически");
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("ТипОснования,НомерОснования,Статус",
		"", "", "ручной разбор");

КонецФункции

// Выгружает созданное поручение в шлюз и фиксирует его PaymentId.
// Повторная выгрузка того же поручения шлюзом узнаётся по ExternalId
// и второй платёж не создаёт (контракт банка, task_86).
Функция ОтправитьПоручение(ПоручениеСсылка) Экспорт

	Объект = ПоручениеСсылка.ПолучитьОбъект();
	СменитьСтатусПоручения(Объект, "Отправлено");
	Ответ = РИХ_ВнешниеСервисы.ОтправитьПоручениеВБанк(
		Строка(ПоручениеСсылка.УникальныйИдентификатор()),
		СокрЛП(Объект.Номер), Объект.Дата,
		"ООО «Ритейл Групп»", Объект.ПолучательНаименование,
		Объект.Сумма, Объект.Назначение);
	Объект.ИдШлюза = Ответ.ИдШлюза;
	СменитьСтатусПоручения(Объект, "Принято");
	Объект.Записать();
	РИХ_Интеграции.ЗаписатьВызов("bank", "SendPaymentOrder", "out",
		Ответ.ИдШлюза, 200, "", 0,
		?(Ответ.Дубль, "шлюз узнал повтор поручения", "поручение принято шлюзом"));

	Возврат Ответ.ИдШлюза;

КонецФункции

// Опрашивает статус поручения в шлюзе и двигает конечный автомат.
// Отклонение не висит «в пути»: причина пишется в поручение и журнал,
// ответственный получает его обратно в тот же день.
Функция ОпроситьСтатусПоручения(ПоручениеСсылка) Экспорт

	Объект = ПоручениеСсылка.ПолучитьОбъект();
	Если НЕ ЗначениеЗаполнено(Объект.ИдШлюза) Тогда
		ВызватьИсключение "RIH-422: поручение ещё не отправлено в шлюз";
	КонецЕсли;
	Ответ = РИХ_ВнешниеСервисы.СтатусПорученияВБанке(Объект.ИдШлюза);
	НовыйСтатус = СтатусИзОтветаШлюза(Ответ.Статус);
	Если НовыйСтатус = Объект.Статус Тогда
		Возврат Объект.Статус;
	КонецЕсли;
	СменитьСтатусПоручения(Объект, НовыйСтатус);
	Если НовыйСтатус = "Отклонено" Тогда
		Объект.ПричинаОтклонения = "банк отклонил поручение, статус шлюза: "
			+ Ответ.Статус;
		РИХ_Интеграции.ЗаписатьВызов("bank", "GetPaymentStatus", "out",
			Объект.ИдШлюза, 200, "RIH-BANK-REJECTED", 0,
			"возврат ответственному: " + Объект.Ответственный);
	КонецЕсли;
	Объект.Записать();

	Возврат Объект.Статус;

КонецФункции

// Итоги применённых платежей для отчёта «Взаиморасчёты после загрузки»:
// направления, автоматика против ручного разбора и доля автоматики.
Функция ИтогиЗагрузки() Экспорт

	Итоги = Новый Структура("Поступило,Списано,Авто,Вручную,Всего,ДоляАвтоПроцентов",
		0, 0, 0, 0, 0, 0);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Платежи.Направление КАК Направление, Платежи.Сумма КАК Сумма,
	|	Платежи.СтатусСопоставления КАК СтатусСопоставления
	|ИЗ РегистрСведений.ПлатежиВыписки КАК Платежи";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Итоги.Всего = Итоги.Всего + 1;
		Если Выборка.Направление = "Поступление" Тогда
			Итоги.Поступило = Итоги.Поступило + Выборка.Сумма;
		Иначе
			Итоги.Списано = Итоги.Списано + Выборка.Сумма;
		КонецЕсли;
		Если Выборка.СтатусСопоставления = "автоматически" Тогда
			Итоги.Авто = Итоги.Авто + 1;
		Иначе
			Итоги.Вручную = Итоги.Вручную + 1;
		КонецЕсли;
	КонецЦикла;
	Если Итоги.Всего > 0 Тогда
		Итоги.ДоляАвтоПроцентов = Окр(100 * Итоги.Авто / Итоги.Всего, 1);
	КонецЕсли;

	Возврат Итоги;

КонецФункции

#КонецОбласти

#Область Служебные

// Заполняет одно поле платежа по ключу строки файла выписки.
Процедура ЗаполнитьПолеПлатежа(Платёж, Ключ, Значение)

	Если Ключ = "Номер" Тогда
		Платёж.Номер = Значение;
	ИначеЕсли Ключ = "ДатаПоступило" Тогда
		Платёж.Дата = ДатаФайла(Значение);
	ИначеЕсли Ключ = "Сумма" Тогда
		Платёж.Сумма = Число(Значение);
	ИначеЕсли Ключ = "Плательщик" Тогда
		Платёж.Плательщик = Значение;
	ИначеЕсли Ключ = "ПлательщикСчет" Тогда
		Платёж.ПлательщикСчет = Значение;
	ИначеЕсли Ключ = "Плательщик1" Тогда
		Платёж.ПлательщикИНН = ИННИзРеквизита(Значение);
	ИначеЕсли Ключ = "Получатель" Тогда
		Платёж.Получатель = Значение;
	ИначеЕсли Ключ = "ПолучательСчет" Тогда
		Платёж.ПолучательСчет = Значение;
	ИначеЕсли Ключ = "Получатель1" Тогда
		Платёж.ПолучательИНН = ИННИзРеквизита(Значение);
	ИначеЕсли Ключ = "НазначениеПлатежа" Тогда
		Платёж.Назначение = Значение;
	КонецЕсли;

КонецПроцедуры

// Заполняет итоги секции расчётного счёта разобранной выписки.
Процедура ЗаполнитьПолеИтогов(Результат, Ключ, Значение)

	Если Ключ = "НачальныйОстаток" Тогда
		Результат.НачальныйОстаток = Число(Значение);
	ИначеЕсли Ключ = "ВсегоПоступило" Тогда
		Результат.ВсегоПоступило = Число(Значение);
	ИначеЕсли Ключ = "ВсегоСписано" Тогда
		Результат.ВсегоСписано = Число(Значение);
	ИначеЕсли Ключ = "КонечныйОстаток" Тогда
		Результат.КонечныйОстаток = Число(Значение);
	КонецЕсли;

КонецПроцедуры

// Дополняет платёж направлением и контрагентом относительно нашего счёта.
Процедура ДополнитьПлатёж(Платёж, НашСчёт)

	Если Платёж.ПолучательСчет = НашСчёт Тогда
		Платёж.Вставить("Направление", "Поступление");
		Платёж.Вставить("Контрагент", Платёж.Плательщик);
		Платёж.Вставить("ИННКонтрагента", Платёж.ПлательщикИНН);
	Иначе
		Платёж.Вставить("Направление", "Списание");
		Платёж.Вставить("Контрагент", Платёж.Получатель);
		Платёж.Вставить("ИННКонтрагента", Платёж.ПолучательИНН);
	КонецЕсли;

КонецПроцедуры

// Дата формата ДД.ММ.ГГГГ из файла выписки.
Функция ДатаФайла(Значение)

	Части = СтрРазделить(Значение, ".");
	Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));

КонецФункции

// ИНН из реквизита вида «УНП 100000001»: только цифры.
Функция ИННИзРеквизита(Значение)

	ИНН = "";
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			ИНН = ИНН + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат ИНН;

КонецФункции

// Ключ идемпотентности платежа из его банковских реквизитов.
Функция КлючПлатежа(Платёж)

	Возврат Платёж.ВидДокумента + "|" + Платёж.Номер + "|"
		+ Формат(Платёж.Дата, "ДФ=yyyy-MM-dd") + "|"
		+ Формат(Платёж.Сумма, "ЧДЦ=2; ЧРД=.; ЧГ=0") + "|"
		+ Платёж.ПлательщикСчет;

КонецФункции

// Истина, если платёж с таким ключом уже применён раньше.
Функция ПлатёжУжеЗагружен(Ключ)

	Набор = РегистрыСведений.ПлатежиВыписки.СоздатьНаборЗаписей();
	Набор.Отбор.КлючПлатежа.Установить(Ключ);
	Набор.Прочитать();
	Возврат Набор.Количество() > 0;

КонецФункции

// Сверяет обороты и остаток файла с секцией счёта до разметки платежей.
// Дубли внутри файла в обороты не входят: банк в итогах их не считает.
Процедура ПроверитьИтогиВыписки(Данные)

	Поступило = 0;
	Списано = 0;
	Виденные = Новый Соответствие;
	Для Каждого Платёж Из Данные.Платежи Цикл
		Ключ = КлючПлатежа(Платёж);
		Если Виденные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Виденные.Вставить(Ключ, Истина);
		Если Платёж.Направление = "Поступление" Тогда
			Поступило = Поступило + Платёж.Сумма;
		Иначе
			Списано = Списано + Платёж.Сумма;
		КонецЕсли;
	КонецЦикла;
	Если Окр(Поступило, 2) <> Окр(Данные.ВсегоПоступило, 2)
			ИЛИ Окр(Списано, 2) <> Окр(Данные.ВсегоСписано, 2) Тогда
		ВызватьИсключение "RIH-422: обороты файла не сходятся с секцией счёта: "
			+ "поступило " + Формат(Поступило, "ЧДЦ=2; ЧГ=0") + " против "
			+ Формат(Данные.ВсегоПоступило, "ЧДЦ=2; ЧГ=0");
	КонецЕсли;
	Конечный = Данные.НачальныйОстаток + Поступило - Списано;
	Если Окр(Конечный, 2) <> Окр(Данные.КонечныйОстаток, 2) Тогда
		ВызватьИсключение "RIH-422: конечный остаток файла не сходится: "
			+ Формат(Конечный, "ЧДЦ=2; ЧГ=0") + " против "
			+ Формат(Данные.КонечныйОстаток, "ЧДЦ=2; ЧГ=0");
	КонецЕсли;

КонецПроцедуры

// Пишет применённый платёж в регистр выписки.
Процедура ЗаписатьПлатёж(Ключ, Платёж, Сопоставление, ХешФайла)

	Запись = РегистрыСведений.ПлатежиВыписки.СоздатьМенеджерЗаписи();
	Запись.КлючПлатежа = Ключ;
	Запись.Направление = Платёж.Направление;
	Запись.НомерДокумента = Платёж.Номер;
	Запись.ДатаПлатежа = Платёж.Дата;
	Запись.Сумма = Платёж.Сумма;
	Запись.Контрагент = Платёж.Контрагент;
	Запись.ИННКонтрагента = Платёж.ИННКонтрагента;
	Запись.Назначение = Платёж.Назначение;
	Запись.ТипОснования = Сопоставление.ТипОснования;
	Запись.НомерОснования = Сопоставление.НомерОснования;
	Запись.СтатусСопоставления = Сопоставление.Статус;
	Запись.ХешФайла = ХешФайла;
	Запись.Записать();

КонецПроцедуры

// Активные шаблоны назначений по приоритету; пока регистр пуст,
// работают встроенные — те же пять правил первым заполнением регистра.
Функция АктивныеШаблоны()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Шаблоны.ТипОснования КАК ТипОснования, Шаблоны.Маркер КАК Маркер
	|ИЗ РегистрСведений.ШаблоныНазначенийПлатежей КАК Шаблоны
	|ГДЕ Шаблоны.Активен
	|УПОРЯДОЧИТЬ ПО Шаблоны.Приоритет";
	Выборка = Запрос.Выполнить().Выбрать();
	Шаблоны = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Шаблоны.Добавить(Новый Структура("ТипОснования,Маркер",
			Выборка.ТипОснования, Выборка.Маркер));
	КонецЦикла;
	Если Шаблоны.Количество() = 0 Тогда
		Шаблоны = ВстроенныеШаблоны();
	КонецЕсли;

	Возврат Шаблоны;

КонецФункции

// Правила разбора по умолчанию: заказ раньше счёта (пример задания).
Функция ВстроенныеШаблоны()

	Шаблоны = Новый Массив;
	Шаблоны.Добавить(Новый Структура("ТипОснования,Маркер", "Заказ", "заказ"));
	Шаблоны.Добавить(Новый Структура("ТипОснования,Маркер", "Счёт", "счету"));
	Шаблоны.Добавить(Новый Структура("ТипОснования,Маркер", "Счёт", "счёту"));
	Шаблоны.Добавить(Новый Структура("ТипОснования,Маркер", "Счёт", "счета"));
	Шаблоны.Добавить(Новый Структура("ТипОснования,Маркер", "Договор", "договор"));
	Шаблоны.Добавить(Новый Структура("ТипОснования,Маркер", "Акт", "акту"));
	Возврат Шаблоны;

КонецФункции

// Первое слово с цифрой после маркера: номер основания.
Функция НомерОснованияПосле(Назначение, НачалоПоиска)

	Остаток = СокрЛП(Сред(Назначение, НачалоПоиска));
	Для Каждого Слово Из СтрРазделить(Остаток, " ") Цикл
		Очищенное = УбратьОбрамление(Слово);
		Если ЗначениеЗаполнено(Очищенное) И СодержитЦифру(Очищенное) Тогда
			Возврат Очищенное;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Слово без обрамляющей пунктуации и символа номера.
Функция УбратьОбрамление(Слово)

	Обрамление = ".,;:()«»""№";
	Результат = СокрЛП(Слово);
	Пока СтрДлина(Результат) > 0
			И СтрНайти(Обрамление, Лев(Результат, 1)) > 0 Цикл
		Результат = Сред(Результат, 2);
	КонецЦикла;
	Пока СтрДлина(Результат) > 0
			И СтрНайти(Обрамление, Прав(Результат, 1)) > 0 Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Истина, если в строке есть хотя бы одна цифра.
Функция СодержитЦифру(СтрокаПроверки)

	Для Позиция = 1 По СтрДлина(СтрокаПроверки) Цикл
		Если СтрНайти("0123456789", Сред(СтрокаПроверки, Позиция, 1)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Двигает статус поручения по конечному автомату без пропусков.
Процедура СменитьСтатусПоручения(Объект, НовыйСтатус)

	Если НЕ РазрешёнПереходПоручения(Объект.Статус, НовыйСтатус) Тогда
		ВызватьИсключение "RIH-409: запрещён переход поручения из «"
			+ Объект.Статус + "» в «" + НовыйСтатус + "»";
	КонецЕсли;
	Объект.Статус = НовыйСтатус;

КонецПроцедуры

// Разрешённые переходы статусов поручения — одна таблица правил.
Функция РазрешёнПереходПоручения(Текущий, НовыйСтатус)

	Если Текущий = "Создано" Тогда
		Возврат НовыйСтатус = "Отправлено";
	ИначеЕсли Текущий = "Отправлено" Тогда
		Возврат НовыйСтатус = "Принято" ИЛИ НовыйСтатус = "Отклонено";
	ИначеЕсли Текущий = "Принято" Тогда
		Возврат НовыйСтатус = "Исполнено" ИЛИ НовыйСтатус = "Отклонено";
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Статус шлюза словами учёта поручений. Неизвестный статус — ошибка
// контракта шлюза, а не «принято»: тихая подмена статуса деньгам вредна.
Функция СтатусИзОтветаШлюза(СтатусШлюза)

	Если СтатусШлюза = "paid" Тогда
		Возврат "Исполнено";
	ИначеЕсли СтатусШлюза = "rejected" Тогда
		Возврат "Отклонено";
	ИначеЕсли СтатусШлюза = "processing" ИЛИ СтатусШлюза = "accepted" Тогда
		Возврат "Принято";
	КонецЕсли;

	ВызватьИсключение "RIH-502: неизвестный статус шлюза: " + СтатусШлюза;

КонецФункции

#КонецОбласти
