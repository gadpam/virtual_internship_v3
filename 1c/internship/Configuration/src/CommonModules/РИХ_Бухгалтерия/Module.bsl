// РИХ_Бухгалтерия (task_152): учётное ядро RIH поверх регистра
// бухгалтерии РИХ_Учёт. Остатки и обороты дают виртуальные
// таблицы на границы периода; считать сальдо циклами по записям
// запрещено идеей механизма — виртуальная таблица не ошибается
// на оборотах «внутри» периода.

#Область ПрограммныйИнтерфейс

// Записывает проводку модели task_151: пара счетов, сумма,
// субконто обеих сторон. Инвариант «каждая запись — пара»
// держится конструкцией: одиночной записи без корреспондента
// у функции нет.
Процедура ЗаписатьПроводку(Период, Организация, СчётДт, СчётКт, Сумма,
		СубконтоДт = Неопределено, СубконтоКт = Неопределено,
		Содержание = "") Экспорт

	Запись = РегистрыБухгалтерии.РИХ_Учёт.СоздатьМенеджерЗаписи();
	Запись.Период = Период;
	Запись.Организация = Организация;
	Запись.СчетДт = СчётПоКоду(СчётДт);
	Запись.СчетКт = СчётПоКоду(СчётКт);
	Запись.Сумма = Сумма;
	Если СубконтоДт <> Неопределено Тогда
		Запись.СубконтоДт1 = СубконтоДт;
	КонецЕсли;
	Если СубконтоКт <> Неопределено Тогда
		Запись.СубконтоКт1 = СубконтоКт;
	КонецЕсли;
	Запись.Содержание = Содержание;
	Запись.Записать();

КонецПроцедуры

// Остатки по счёту на дату: виртуальная таблица Остатки даёт
// сальдо на границу корректно, включая внутрипериодные обороты.
Функция ОстаткиПоСчёту(КодСчёта, Период, Организация = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Учёт.Субконто1 КАК Субконто,
	|\tУчёт.СуммаОстатокДт КАК ОстатокДт,
	|\tУчёт.СуммаОстатокКт КАК ОстатокКт,
	|\tУчёт.КоличествоОстатокДт КАК КоличествоДт
	|ИЗ РегистрБухгалтерии.РИХ_Учёт.Остатки(&Период,
	|\tСчет = &Счет) КАК Учёт";
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Счет", СчётПоКоду(КодСчёта));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Обороты счёта за период: дебет и кредит одной цифрой каждый —
// пара к проверке инварианта по всем счетам (model.md).
Функция ОборотыЗаПериод(КодСчёта, Начало, Конец) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Учёт.СуммаОборотДт КАК ОборотДт,
	|\tУчёт.СуммаОборотКт КАК ОборотКт
	|ИЗ РегистрБухгалтерии.РИХ_Учёт.Обороты(&Начало, &Конец,
	|\t, Счет = &Счет) КАК Учёт";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Счет", СчётПоКоду(КодСчёта));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Обороты в разрезе субконто: «по кому и по чему», а не «сколько
// всего» — вопрос, ради которого субконто существуют (task_151).
Функция ОборотыПоСубконто(КодСчёта, Начало, Конец) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Учёт.Субконто1 КАК Субконто,
	|\tУчёт.СуммаОборотДт КАК ОборотДт,
	|\tУчёт.СуммаОборотКт КАК ОборотКт,
	|\tУчёт.КоличествоОборотДт КАК КоличествоДт,
	|\tУчёт.КоличествоОборотКт КАК КоличествоКт
	|ИЗ РегистрБухгалтерии.РИХ_Учёт.Обороты(&Начало, &Конец,
	|\t, Счет = &Счет) КАК Учёт
	|СГРУППИРОВАТЬ ПО Учёт.Субконто1";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Счет", СчётПоКоду(КодСчёта));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СчётПоКоду(Код)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Счета.Ссылка КАК Ссылка
	|ИЗ ПланСчетов.РИХ_ПланСчетов КАК Счета
	|ГДЕ Счета.Код = &Код";
	Запрос.УстановитьПараметр("Код", Код);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Ссылка;

КонецФункции

#КонецОбласти
