// РИХ_ОчередьОбмена (task_95): исходящий outbox с ретраями и деградацией.
// Недоступность партнёра — режим накопления, а не авария: сообщения
// ждут в регистре, восстановление партнёра отправляет их пакетом.

#Область ПрограммныйИнтерфейс

// Ставит сообщение в очередь внутри транзакции вызывающего.
Функция ПоставитьВСочередь(Система, Операция, ТелоJSON, КлючИдемпотентности) Экспорт

	ИдСообщения = Строка(Новый УникальныйИдентификатор);
	Запись = РегистрыСведений.ОчередьОбмена.СоздатьМенеджерЗаписи();
	Запись.ИдСообщения = ИдСообщения;
	Запись.Система = Система;
	Запись.Операция = Операция;
	Запись.ТелоСообщения = ТелоJSON;
	Запись.КлючИдемпотентности = КлючИдемпотентности;
	Запись.Статус = "Новая";
	Запись.Попыток = 0;
	Запись.СледующаяПопытка = ТекущаяДатаСеанса();
	Запись.Записать();

	Возврат ИдСообщения;

КонецФункции

// Один проход отправки: берёт готовые к отправке сообщения порциями,
// успех — «Отправлена», сеть — «Отложена» с экспоненциальной паузой,
// исчерпание 5 попыток — «Ошибка» человеку.
Функция ОбработатьОчередь(РазмерПорции = 100) Экспорт

	Итог = Новый Структура("Отправлено,Отложено,Ошибок", 0, 0, 0);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ &Порция Очередь.*
	|ИЗ РегистрСведений.ОчередьОбмена КАК Очередь
	|ГДЕ Очередь.Статус В (&Готовые) И Очередь.СледующаяПопытка <= &Сейчас
	|УПОРЯДОЧИТЬ ПО Очередь.СледующаяПопытка";
	Запрос.УстановитьПараметр("Порция", РазмерПорции);
	Запрос.УстановитьПараметр("Готовые", СтатусыКОтправке());
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Попытка
			ОтправитьСообщениеПартнёру(Выборка);
			УстановитьСтатус(Выборка.ИдСообщения, "Отправлена", Выборка.Попыток, "");
			Итог.Отправлено = Итог.Отправлено + 1;
		Исключение
			НомерПопытки = Выборка.Попыток + 1;
			Если НомерПопытки >= 5 Тогда
				УстановитьСтатус(Выборка.ИдСообщения, "Ошибка",
					НомерПопытки, ОписаниеОшибки());
				Итог.Ошибок = Итог.Ошибок + 1;
			Иначе
				ОтложитьДо = ТекущаяДатаСеанса()
					+ ПаузаПередПовторомСекунд(НомерПопытки) * 60;
				УстановитьСтатус(Выборка.ИдСообщения, "Отложена",
					НомерПопытки, ОписаниеОшибки(), ОтложитьДо);
				Итог.Отложено = Итог.Отложено + 1;
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Действия оператора над сообщением со статусом «Ошибка».
Процедура ПовторитьСообщение(ИдСообщения) Экспорт

	УстановитьСтатус(ИдСообщения, "Новая", 0, "", ТекущаяДатаСеанса());

КонецПроцедуры

// Отклонение оператором: сообщение не отправится никогда, причина — в журнал.
Процедура ОтклонитьСообщение(ИдСообщения, Причина) Экспорт

	УстановитьСтатус(ИдСообщения, "Отклонена", 0, Причина);
	ЗаписьЖурналаРегистрации("РИХ.ОчередьОбмена",
		УровеньЖурналаРегистрации.Информация, , ,
		"Сообщение " + ИдСообщения + " отклонено оператором: " + Причина);

КонецПроцедуры

// Исправление тела оператором с возвратом в очередь.
Процедура ИсправитьСообщение(ИдСообщения, НовоеТелоJSON) Экспорт

	Запись = РегистрыСведений.ОчередьОбмена.СоздатьМенеджерЗаписи();
	Запись.ИдСообщения = ИдСообщения;
	Запись.Прочитать();
	Запись.ТелоСообщения = НовоеТелоJSON;
	Запись.Статус = "Новая";
	Запись.Попыток = 0;
	Запись.СледующаяПопытка = ТекущаяДатаСеанса();
	Запись.Записать();

КонецПроцедуры

#КонецОбласти

#Область Служебные

// Статусы, из которых сообщение можно отправлять сейчас.
Функция СтатусыКОтправке()

	Статусы = Новый Массив;
	Статусы.Добавить("Новая");
	Статусы.Добавить("Отложена");
	Возврат Статусы;

КонецФункции

// Экспоненциальная пауза перед повтором в минутах: 1, 2, 4, 8, 16.
Функция ПаузаПередПовторомМинут(НомерПопытки)

	Возврат Pow(2, НомерПопытки - 1);

КонецФункции

// Отправка одного сообщения: тело разбирается обратно в структуру,
// поля берут клиенты партнёров. Новый партнёр — новая ветка здесь,
// а не новый механизм очереди.
Процедура ОтправитьСообщениеПартнёру(Сообщение)

	Тело = РИХ_Форматы.JSONВСтруктуру(Сообщение.ТелоСообщения);
	Если Сообщение.Система = "loyalty" И Сообщение.Операция = "accrue" Тогда
		РИХ_ЛояльностьКлиент.Начислить(Сообщение.КлючИдемпотентности,
			Тело.card, Тело.points, Тело.reason);
	ИначеЕсли Сообщение.Система = "loyalty" И Сообщение.Операция = "redeem" Тогда
		РИХ_ЛояльностьКлиент.Списать(Сообщение.КлючИдемпотентности,
			Тело.card, Тело.points, Тело.reason);
	Иначе
		ВызватьИсключение "RIH-422: очередь не знает получателя: "
			+ Сообщение.Система + "/" + Сообщение.Операция;
	КонецЕсли;

КонецПроцедуры

// Перезапись статуса и служебных полей одного сообщения.
Процедура УстановитьСтатус(ИдСообщения, Статус, Попыток, Ошибка, СледующаяПопытка = Неопределено)

	Запись = РегистрыСведений.ОчередьОбмена.СоздатьМенеджерЗаписи();
	Запись.ИдСообщения = ИдСообщения;
	Запись.Прочитать();
	Запись.Статус = Статус;
	Запись.Попыток = Попыток;
	Запись.ПоследняяОшибка = Ошибка;
	Если СледующаяПопытка <> Неопределено Тогда
		Запись.СледующаяПопытка = СледующаяПопытка;
	КонецЕсли;
	Запись.Записать();

КонецПроцедуры

#КонецОбласти
