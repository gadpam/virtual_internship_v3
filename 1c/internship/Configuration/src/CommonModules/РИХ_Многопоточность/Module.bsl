// РИХ_Многопоточность (task_59): параллельные фоновые задания шардами.
// Масштабирование упирается не в код, а в ресурсы: число рабочих процессов
// кластера (лицензии/настройки), CPU и диск СУБД, блокировки общих таблиц.
// Шарды независимы по данным, поэтому блокировок между потоками нет.

#Область ПрограммныйИнтерфейс

// Делит склады на N непересекающихся шардов (остаток — первым шардам).
//
// Параметры:
//   Склады      - Массив - все склады работы;
//   ЧислоШардов - Число - желаемое число потоков.
//
// Возвращаемое значение:
//   Массив - массив массивов складов, объединение равно исходному.
//
Функция РазделитьНаШарды(Склады, ЧислоШардов) Экспорт

	Шарды = Новый Массив;
	Для Номер = 1 По ЧислоШардов Цикл
		Шарды.Добавить(Новый Массив);
	КонецЦикла;
	Индекс = 0;
	Для Каждого Склад Из Склады Цикл
		Шарды[Индекс % ЧислоШардов].Добавить(Склад);
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Шарды;

КонецФункции

// Запускает пересчёт цен по шардам фоновыми заданиями и ждёт все потоки.
//
// Параметры:
//   Склады       - Массив - склады пересчёта;
//   ЧислоПотоков - Число - параллельных заданий;
//   ТаймаутСек   - Число - максимум ожидания всех потоков.
//
// Возвращаемое значение:
//   Структура - Завершено, Упало, ПревышенТаймаут: упавший поток не роняет
//   процесс, его шард виден в итоге и переобрабатывается отдельно.
//
Функция ПересчитатьЦеныПараллельно(Склады, ЧислоПотоков, ТаймаутСек = 600) Экспорт

	Шарды = РазделитьНаШарды(Склады, ЧислоПотоков);
	Задания = Новый Массив;
	Для Каждого Шард Из Шарды Цикл
		Если Шард.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Параметры = Новый Массив;
		Параметры.Добавить(Шард);
		Задания.Добавить(ФоновыеЗадания.Выполнить(
			"РИХ_Многопоточность.ПересчитатьШард", Параметры,
			Новый УникальныйИдентификатор, "Пересчёт цен шард"));
	КонецЦикла;

	Итог = Новый Структура("Завершено,Упало,ПревышенТаймаут", 0, 0, Ложь);
	Попытка
		ФоновыеЗадания.ОжидатьЗавершенияЗаданий(Задания, ТаймаутСек);
	Исключение
		Итог.ПревышенТаймаут = Истина;
	КонецПопытки;
	Для Каждого Задание Из Задания Цикл
		Если Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
			Итог.Завершено = Итог.Завершено + 1;
		ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
			Итог.Упало = Итог.Упало + 1;
			ЗаписьЖурналаРегистрации("РИХ.Потоки",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Шард упал: " + Задание.ИнформацияОбОшибке.КраткоеПредставлениеОшибки());
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Пересчитывает цены одного шарда: вызывается только фоновым заданием,
// чужие склады не трогает (staging по своим складам, слияние — после всех).
//
// Параметры:
//   СкладыШарда - Массив - склады этого потока.
//
Процедура ПересчитатьШард(СкладыШарда) Экспорт

	Для Каждого Склад Из СкладыШарда Цикл
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ Остатки.Номенклатура КАК Номенклатура
		|ИЗ РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &Склад) КАК Остатки";
		Запрос.УстановитьПараметр("Склад", Склад);
		Запрос.Выполнить();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
