// РИХ_Процессы (task_170): запуск и переходы подсистемы процессов.
// Логика живёт в переходах карты (условия, действия), а не в
// формах: завершение задачи с результатом двигает экземпляр;
// задача выполнена, а процесс стоит — находится по данным
// переходов и условию, которое не сработало.

#Область ПрограммныйИнтерфейс

// Запуск из журнала интеграций кнопкой «В работу»: экземпляр
// стартует сразу с контекстом сообщения обмена. Одна ошибка —
// один живой процесс: повторный запуск по тому же сообщению
// возвращает существующий экземпляр, а не второй разбор.
Функция ЗапуститьРазборОшибки(СообщениеОбмена, Критичность) Экспорт

	Существующий = НайтиЖивойПроцесс(СообщениеОбмена);
	Если Существующий <> Неопределено Тогда
		Возврат Существующий;
	КонецЕсли;

	Процесс = БизнесПроцессы.РИХ_РазборОшибкиИнтеграции.СоздатьБизнесПроцесс();
	Процесс.СообщениеОбмена = СообщениеОбмена;
	Процесс.Критичность = Критичность;
	Процесс.Записать();
	Процесс.Старт();

	Возврат Процесс.Ссылка;

КонецФункции

// Завершение задачи: без результата этап не закрывается, процесс
// не двигается молча. Критичность читается из экземпляра —
// ветвление карты данными, а не кодом формы.
Процедура ЗавершитьЗадачу(Задача, Результат) Экспорт

	Если СокрЛП(Результат) = "" Тогда
		ВызватьИсключение "RIH-PROC-001: задача без результата не закрывает этап процесса";
	КонецЕсли;

	ЗадачаОбъект = Задача.ПолучитьОбъект();
	ЗадачаОбъект.Результат = Результат;
	ЗадачаОбъект.Выполнена = Истина;
	ЗадачаОбъект.Записать();

КонецПроцедуры

// Этапы карты по критичности: критичная — короткий маршрут
// к эскалации, обычная — полный цикл разбора.
Функция ЭтапыМаршрута(Критичность) Экспорт

	Если Критичность = "критичная" Тогда
		Возврат "Диагностика(30 мин),Эскалация дежурному,Исправление,Проверка,Закрытие";
	КонецЕсли;

	Возврат "Диагностика,Исправление,Проверка,Закрытие";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиЖивойПроцесс(СообщениеОбмена)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Процессы.Ссылка КАК Ссылка
	|ИЗ БизнесПроцесс.РИХ_РазборОшибкиИнтеграции КАК Процессы
	|ГДЕ Процессы.СообщениеОбмена = &Сообщение И НЕ Процессы.Завершен";
	Запрос.УстановитьПараметр("Сообщение", СообщениеОбмена);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
