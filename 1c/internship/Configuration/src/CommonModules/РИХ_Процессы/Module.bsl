// РИХ_Процессы (task_170): запуск и переходы подсистемы процессов.
// Логика живёт в переходах карты (условия, действия), а не в
// формах: завершение задачи с результатом двигает экземпляр;
// задача выполнена, а процесс стоит — находится по данным
// переходов и условию, которое не сработало.

#Область ПрограммныйИнтерфейс

// Запуск из журнала интеграций кнопкой «В работу»: экземпляр
// стартует сразу с контекстом сообщения обмена. Одна ошибка —
// один живой процесс: повторный запуск по тому же сообщению
// возвращает существующий экземпляр, а не второй разбор.
Функция ЗапуститьРазборОшибки(СообщениеОбмена, Критичность) Экспорт

	Существующий = НайтиЖивойПроцесс(СообщениеОбмена);
	Если Существующий <> Неопределено Тогда
		Возврат Существующий;
	КонецЕсли;

	Процесс = БизнесПроцессы.РИХ_РазборОшибкиИнтеграции.СоздатьБизнесПроцесс();
	Процесс.СообщениеОбмена = СообщениеОбмена;
	Процесс.Критичность = Критичность;
	Процесс.Записать();
	Процесс.Старт();

	Возврат Процесс.Ссылка;

КонецФункции

// Завершение задачи: без результата этап не закрывается, процесс
// не двигается молча. Критичность читается из экземпляра —
// ветвление карты данными, а не кодом формы.
Процедура ЗавершитьЗадачу(Задача, Результат) Экспорт

	Если СокрЛП(Результат) = "" Тогда
		ВызватьИсключение "RIH-PROC-001: задача без результата не закрывает этап процесса";
	КонецЕсли;

	ЗадачаОбъект = Задача.ПолучитьОбъект();
	ЗадачаОбъект.Результат = Результат;
	ЗадачаОбъект.Выполнена = Истина;
	ЗадачаОбъект.Записать();

КонецПроцедуры

// Этапы карты по критичности: критичная — короткий маршрут
// к эскалации, обычная — полный цикл разбора.
Функция ЭтапыМаршрута(Критичность) Экспорт

	Если Критичность = "критичная" Тогда
		Возврат "Диагностика(30 мин),Эскалация дежурному,Исправление,Проверка,Закрытие";
	КонецЕсли;

	Возврат "Диагностика,Исправление,Проверка,Закрытие";

КонецФункции

// Плановая дата задачи: от старта этапа по правилу SLA в рабочих
// днях производственного календаря, а не «от создания документа»
// и не на глаз исполнителя. Правила — справочник: бизнес меняет
// сроки настройкой.
Функция ПлановаяДата(ВидПроцесса, Этап, ДатаСтартаЭтапа) Экспорт

	Правило = ПравилоSLA(ВидПроцесса, Этап);
	Осталось = Правило.СрокРабочихДней;
	Дата = ДатаСтартаЭтапа;
	Пока Осталось > 0 Цикл
		Дата = Дата + 86400;
		Если ДеньНедели(Дата) <= 5 Тогда
			Осталось = Осталось - 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Дата;

КонецФункции

// Эскалация просроченной задачи: руководителю этапа с влиянием
// («что встанет»), а не «просрочено». Предел цепочки — владелец
// процесса из правила: дальше эскалация не растёт.
Функция АдресатЭскалации(ВидПроцесса, Этап, Уровень) Экспорт

	Правило = ПравилоSLA(ВидПроцесса, Этап);
	Если Уровень >= 3 Тогда
		Возврат Правило.ПределЭскалации;
	КонецЕсли;

	Возврат "Руководитель этапа " + Этап;

КонецФункции

// Делегирование на период отсутствия: задачи роли уходят
// заместителю автоматически; срок задачи НЕ сбрасывается —
// делегирование не покупает процессу новое время.
Процедура ДелегироватьЗадачи(Роль, Заместитель, ДатаНачала, ДатаОкончания) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Задачи.Ссылка КАК Ссылка ИЗ Задача.РИХ_ЗадачаПроцесса КАК Задачи
	|ГДЕ Задачи.РольИсполнителя = &Роль И НЕ Задачи.Выполнена";
	Запрос.УстановитьПараметр("Роль", Роль);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗадачаОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЗадачаОбъект.ФактическийИсполнитель = Заместитель;
		ЗадачаОбъект.Записать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Правило SLA вида процесса и этапа из справочника: отсутствующее
// правило — ошибка настройки процесса, а не «срок бесконечный».
Функция ПравилоSLA(ВидПроцесса, Этап)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Правила.Ссылка КАК Ссылка,
	|\tПравила.СрокРабочихДней КАК СрокРабочихДней,
	|\tПравила.ПределЭскалации КАК ПределЭскалации
	|ИЗ Справочник.ПравилаSLA КАК Правила
	|ГДЕ Правила.ВидПроцесса = &ВидПроцесса И Правила.Этап = &Этап";
	Запрос.УстановитьПараметр("ВидПроцесса", ВидПроцесса);
	Запрос.УстановитьПараметр("Этап", Этап);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка;

КонецФункции

Функция НайтиЖивойПроцесс(СообщениеОбмена)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Процессы.Ссылка КАК Ссылка
	|ИЗ БизнесПроцесс.РИХ_РазборОшибкиИнтеграции КАК Процессы
	|ГДЕ Процессы.СообщениеОбмена = &Сообщение И НЕ Процессы.Завершен";
	Запрос.УстановитьПараметр("Сообщение", СообщениеОбмена);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
