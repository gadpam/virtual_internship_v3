// Расширение РИХ_КонтрольПоступлений (task_159): контроль проведения
// поступлений бухгалтерскими правилами поверх «типовой» базы.
// Основная конфигурация не изменяется, обновление поставщика
// расширению не мешает: сняли расширение — контроль исчез,
// документы и данные остались.

Процедура КонтрольПоступленияПередЗаписью(Источник, Отказ) Экспорт

	Если НЕ ЗначениеЗаполнено(Источник.Контрагент) Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			"Поступление без контрагента: счёт 60 останется без субконто, сверка task_156 не сойдётся",
			Источник, "Контрагент");
	КонецЕсли;

	Если Источник.СуммаДокумента > 0
		И НЕ ЗначениеЗаполнено(Источник.НомерСчётаФактуры) Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			"Нет номера счёта-фактуры: входящий НДС не попадёт в книгу покупок (task_154)",
			Источник, "НомерСчётаФактуры");
	КонецЕсли;

КонецПроцедуры
