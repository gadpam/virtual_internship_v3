	Если Источник.СкладОтправитель.ТипСклада = Источник.СкладПолучатель.ТипСклада
		И Источник.СкладОтправитель.ТипСклада <> Перечисления.ТипыСкладов.Транзитный Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			"Перемещение между складами одного типа запрещено политикой площадки (расширение)",
			Источник, "СкладПолучатель");
