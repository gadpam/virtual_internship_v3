// Расширение РИХ_КонтрольСтартаПроцесса (task_167): контроль старта
// процесса согласования оплаты поверх типового документооборота.
// Основная конфигурация не изменяется: сняли расширение — контроль
// исчез, процессы и данные остались как были.

Процедура КонтрольСтартаПроцессаПередЗаписью(Источник, Отказ) Экспорт

	Если Источник.СтатусСогласованияДоговора <> "Согласован" Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			"Договор ещё не согласован: процесс оплаты не стартует (интеграция task_166)",
			Источник, "Договор");
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Источник.СчётНаОплату) Тогда
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(
			"К заявке не приложен счёт: финансисту нечего согласовывать",
			Источник, "СчётНаОплату");
	КонецЕсли;

КонецПроцедуры
