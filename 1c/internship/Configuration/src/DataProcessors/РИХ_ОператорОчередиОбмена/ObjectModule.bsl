// РИХ_ОператорОчередиОбмена (task_95): действия оператора над очередью.
// Обработка — тонкая обёртка над РИХ_ОчередьОбмена: форма не содержит
// логики статусов, поэтому каждое действие проверяется и без интерфейса.

#Область ДействияОператора

// Повторить сообщение со статусом «Ошибка»: попытки сбрасываются.
Процедура Повторить(ИдСообщения) Экспорт

	РИХ_ОчередьОбмена.ПовторитьСообщение(ИдСообщения);

КонецПроцедуры

// Отклонить сообщение навсегда с обязательной причиной в журнале.
Процедура Отклонить(ИдСообщения, Причина) Экспорт

	Если НЕ ЗначениеЗаполнено(Причина) Тогда
		ВызватьИсключение "RIH-422: отклонение без причины запрещено";
	КонецЕсли;
	РИХ_ОчередьОбмена.ОтклонитьСообщение(ИдСообщения, Причина);

КонецПроцедуры

// Исправить тело сообщения и вернуть его в очередь.
Процедура ИсправитьИПовторить(ИдСообщения, НовоеТелоJSON) Экспорт

	РИХ_ОчередьОбмена.ИсправитьСообщение(ИдСообщения, НовоеТелоJSON);

КонецПроцедуры

// Сообщения, ждущие человека: статус «Ошибка» с последней ошибкой.
Функция СообщенияДляРазбора() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Очередь.ИдСообщения, Очередь.Система, Очередь.Операция,
	|	Очередь.ТелоСообщения, Очередь.Попыток, Очередь.ПоследняяОшибка
	|ИЗ РегистрСведений.ОчередьОбмена КАК Очередь
	|ГДЕ Очередь.Статус = &Ошибка";
	Запрос.УстановитьПараметр("Ошибка", "Ошибка");

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти
