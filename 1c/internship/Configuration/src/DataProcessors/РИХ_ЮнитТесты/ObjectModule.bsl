// Тест_СводкаПятьОшибок: Arrange-Act-Assert, данные только в памяти.
Процедура Тест_СводкаПятьОшибок() Экспорт

	// Arrange: документ в памяти (не записываем — изоляция от состояния ИБ)
	Документ = Документы.ПоступлениеТоваров.СоздатьДокумент();
	Документ.Дата = КонецДня(ТекущаяДатаСеанса()) + 86400;
	Строка1 = Документ.Товары.Добавить();
	Строка1.Количество = 0;
	Данные = Новый Структура("Склад,Дата,Товары",
		Справочники.Склады.ПустаяСсылка(), Документ.Дата, Документ.Товары);
	Ошибки = РИХ_Валидация.ОшибкиПоступления(Данные);
	Assert(Ошибки.Количество() >= 3, "сводка содержит ошибки склада, даты и количества");

КонецПроцедуры

// Тест_СводкаВалидныйДокумент: Arrange-Act-Assert, данные только в памяти.
Процедура Тест_СводкаВалидныйДокумент() Экспорт

	Данные = Новый Структура("Склад,Дата,Товары",
		Справочники.Склады.ПустаяСсылка(), ТекущаяДатаСеанса(), Новый ТаблицаЗначений);
	Ошибки = РИХ_Валидация.ОшибкиПоступления(Данные);
	// Склад пустой — ровно одна ошибка склада, даты и строк нет.
	AssertРавно(Ошибки.Количество(), 1, "у пустого склада одна ошибка");

КонецПроцедуры

