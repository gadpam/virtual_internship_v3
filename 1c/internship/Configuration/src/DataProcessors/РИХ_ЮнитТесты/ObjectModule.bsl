// Тест_ГруппировкаПоСвойству: Arrange-Act-Assert, данные только в памяти.
Процедура Тест_ГруппировкаПоСвойству() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Группа");
	Таблица.Колонки.Добавить("Кол");
	Строка1 = Таблица.Добавить(); Строка1.Группа = "А"; Строка1.Кол = 1;
	Строка2 = Таблица.Добавить(); Строка2.Группа = "Б"; Строка2.Кол = 2;
	Строка3 = Таблица.Добавить(); Строка3.Группа = "А"; Строка3.Кол = 3;
	Группы = РИХ_ОбщегоНазначения.СгруппироватьПоСвойству(Таблица, "Группа");
	AssertРавно(Группы.Получить("А").Количество(), 2, "в группе А две строки");

КонецПроцедуры

