// РИХ_ЮнитТесты — каркас юнит-тестов (task_52), структура Arrange-Act-Assert.
//
// Реестр тестов — список имён процедур этого модуля: новый тест = процедура
// Тест_<Имя> + строка в реестре. Упавший тест не останавливает прогон:
// отчёт показывает все падения сразу. Тесты не записывают данные в ИБ.

#Область Каркас

// Реестр имён тестовых процедур каркаса.
Функция РеестрТестов() Экспорт

	Имена = Новый Массив;
	// РИХ_Валидация (task_38) — первое настоящее покрытие, 11 кейсов
	Имена.Добавить("Тест_КоличествоНоль");
	Имена.Добавить("Тест_КоличествоОтрицательное");
	Имена.Добавить("Тест_КоличествоПоложительное");
	Имена.Добавить("Тест_ДатаЗавтра");
	Имена.Добавить("Тест_ДатаСегодня");
	Имена.Добавить("Тест_СводкаПятьОшибок");
	Имена.Добавить("Тест_СводкаВалидныйДокумент");
	// Деньги (task_16)
	Имена.Добавить("Тест_РаспределениеСтоНаТроих");
	Имена.Добавить("Тест_РаспределениеКопейкаНаДвоих");
	Имена.Добавить("Тест_РаспределениеСуммаСходится");
	Имена.Добавить("Тест_НДСВыделение");
	Имена.Добавить("Тест_НДСТудаОбратно");
	// Коллекции (task_14)
	Имена.Добавить("Тест_ДубликатыБазовые");
	Имена.Добавить("Тест_ДубликатыПустойМассив");
	Имена.Добавить("Тест_ГруппировкаПоСвойству");
	// Регрессия task_49: ISO с миллисекундами и смещением
	Имена.Добавить("Тест_IsoМиллисекундыСоСмещением");
	Имена.Добавить("Тест_IsoКруговойОбмен");

	Возврат Имена;

КонецФункции

// Проверка условия: падение — исключение с сообщением.
Процедура Assert(Условие, Сообщение) Экспорт

	Если НЕ Условие Тогда
		ВызватьИсключение "Assert: " + Сообщение;
	КонецЕсли;

КонецПроцедуры

// Проверка равенства с показом ожидания и факта.
Процедура AssertРавно(Факт, Ожидание, Сообщение) Экспорт

	Assert(Факт = Ожидание,
		Сообщение + " (ожидалось " + Строка(Ожидание) + ", получено " + Строка(Факт) + ")");

КонецПроцедуры

// Запускает все тесты реестра, возвращает отчёт одной строкой и пишет
// итог в журнал регистрации (РИХ_Логирование).
Функция ВыполнитьТесты() Экспорт

	Всего = 0;
	Упало = 0;
	Для Каждого ИмяТеста Из РеестрТестов() Цикл
		Всего = Всего + 1;
		Попытка
			ЗапуститьТестПоИмени(ИмяТеста);
		Исключение
			Упало = Упало + 1;
			ЗаписьЖурналаРегистрации("РИХ.Тесты",
				УровеньЖурналаРегистрации.Ошибка, , ,
				ИмяТеста + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Итог = СтрШаблон("Тестов всего: %1, упало: %2", Всего, Упало);
	ЗаписьЖурналаРегистрации("РИХ.Тесты",
		УровеньЖурналаРегистрации.Информация, , , Итог);

	Возврат Итог;

КонецФункции


// Диспетчер тестов без Выполнить(): стандарт (R001) запрещает скрытую
// логику, поэтому имя из реестра отображается в явный вызов. Новый тест
// добавляется процедурой, строкой реестра и веткой здесь.
Процедура ЗапуститьТестПоИмени(ИмяТеста)

	Если ИмяТеста = "Тест_КоличествоНоль" Тогда Тест_КоличествоНоль(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_КоличествоОтрицательное" Тогда Тест_КоличествоОтрицательное(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_КоличествоПоложительное" Тогда Тест_КоличествоПоложительное(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_ДатаЗавтра" Тогда Тест_ДатаЗавтра(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_ДатаСегодня" Тогда Тест_ДатаСегодня(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_СводкаПятьОшибок" Тогда Тест_СводкаПятьОшибок(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_СводкаВалидныйДокумент" Тогда Тест_СводкаВалидныйДокумент(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_РаспределениеСтоНаТроих" Тогда Тест_РаспределениеСтоНаТроих(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_РаспределениеКопейкаНаДвоих" Тогда Тест_РаспределениеКопейкаНаДвоих(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_РаспределениеСуммаСходится" Тогда Тест_РаспределениеСуммаСходится(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_НДСВыделение" Тогда Тест_НДСВыделение(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_НДСТудаОбратно" Тогда Тест_НДСТудаОбратно(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_ДубликатыБазовые" Тогда Тест_ДубликатыБазовые(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_ДубликатыПустойМассив" Тогда Тест_ДубликатыПустойМассив(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_ГруппировкаПоСвойству" Тогда Тест_ГруппировкаПоСвойству(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_IsoМиллисекундыСоСмещением" Тогда Тест_IsoМиллисекундыСоСмещением(); Возврат; КонецЕсли;
	Если ИмяТеста = "Тест_IsoКруговойОбмен" Тогда Тест_IsoКруговойОбмен(); Возврат; КонецЕсли;
	ВызватьИсключение "Тест не найден в диспетчере: " + ИмяТеста;

КонецПроцедуры

#КонецОбласти

#Область ТестыВалидации

