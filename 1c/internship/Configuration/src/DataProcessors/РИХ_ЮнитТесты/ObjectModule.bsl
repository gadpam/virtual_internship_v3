// Регрессия task_49: миллисекунды + смещение одновременно.
Процедура Тест_IsoМиллисекундыСоСмещением() Экспорт

	// Регрессия task_49: разбор падал на .500+03:00.
	Дата = РИХ_ОбщегоНазначения.РазобратьIso8601("2026-01-31T21:00:00.500+03:00");
	AssertРавно(РИХ_ОбщегоНазначения.СформироватьIso8601(Дата),
		"2026-01-31T18:00:00Z", "смещение применено, миллисекунды отброшены");

КонецПроцедуры

// Круговой обмен ISO: разбор и форматирование возвращают исходную строку.
Процедура Тест_IsoКруговойОбмен() Экспорт

	Исходная = "2026-01-31T21:00:00Z";
	Дата = РИХ_ОбщегоНазначения.РазобратьIso8601(Исходная);
	AssertРавно(РИХ_ОбщегоНазначения.СформироватьIso8601(Дата), Исходная, "туда-обратно");

КонецПроцедуры

