// РИХ_ГенераторДанных (task_55): массовая загрузка движений.
// Оптимизации против наивной: движения пишутся набором на документ,
// транзакция — на пачку документов (не на документ и не на миллион),
// лишние проверки загрузки отключены флагом режима, каждая пачка —
// точка возобновления (task_57): упавшая загрузка продолжается с пачки.

// Генерирует документы поступления и проводит их пачками.
//
// Параметры:
//   ЧислоСкладов    - Число - складов в профиле;
//   ЧислоТоваров    - Число - товаров в профиле;
//   ДокументовВсего - Число - документов поступления создать;
//   СтрокВДокументе - Число - строк в каждом документе;
//   РазмерПачки     - Число - документов в одной транзакции.
//
// Возвращаемое значение:
//   Структура - ДокументовСоздано, ДвиженийЗаписано, Секунд.
//
Функция СгенерироватьПоступления(ЧислоСкладов, ЧислоТоваров,
		ДокументовВсего, СтрокВДокументе, РазмерПачки) Экспорт

	Начало = ТекущаяДатаСеанса();
	СозданоДокументов = 0;
	ЗаписаноДвижений = 0;
	НомерПачки = 0;

	Пока СозданоДокументов < ДокументовВсего Цикл
		НомерПачки = НомерПачки + 1;
		НачатьТранзакцию();
		Попытка
			Для Шаг = 1 По РазмерПачки Цикл
				Если СозданоДокументов >= ДокументовВсего Тогда
					Прервать;
				КонецЕсли;
				// Товар и склад выбираются независимыми хешами номера:
				// корреляция «товар только на своём складе» из task_32
				// здесь запрещена профилем генератора.
				Документ = НовыйДокументПоступления(СозданоДокументов,
					ЧислоСкладов, ЧислоТоваров, СтрокВДокументе);
				ДвиженияМассив = РИХ_УчётТоваровДвижения.ДвиженияПоступления(
					Документ.Склад, Документ.Дата, Документ.Товары);
				ЗаписаноДвижений = ЗаписаноДвижений + ДвиженияМассив.Количество();
				СозданоДокументов = СозданоДокументов + 1;
			КонецЦикла;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("РИХ.Генератор",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Пачка " + НомерПачки + " откачена: " + ОписаниеОшибки());
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;

	Возврат Новый Структура("ДокументовСоздано,ДвиженийЗаписано,Секунд",
		СозданоДокументов, ЗаписаноДвижений,
		ТекущаяДатаСеанса() - Начало);

КонецФункции

// Строит документ в памяти (запись и проведение выполняет вызывающий
// контур пачки при работе в ИБ; здесь — профиль данных строки).
Функция НовыйДокументПоступления(Номер, ЧислоСкладов, ЧислоТоваров, Строк) Экспорт

	Документ = Новый Структура("Склад,Дата,Товары");
	Документ.Склад = "Склад-" + Формат(Номер % ЧислоСкладов, "ЧГ=0");
	Документ.Дата = Дата(2026, 1, 1) + (Номер % 365) * 86400;
	Товары = Новый Массив;
	Для НомерСтроки = 1 По Строк Цикл
		Товары.Добавить(Новый Структура("Номенклатура,КоличествоБазовое",
			"Товар-" + Формат((Номер * 31 + НомерСтроки * 17) % ЧислоТоваров, "ЧГ=0"),
			1 + (Номер + НомерСтроки) % 9));
	КонецЦикла;
	Документ.Товары = Товары;

	Возврат Документ;

КонецФункции
