// РИХ_МониторингОбменов (task_107): статусы, ошибки, повторная отправка.
// Обработка только читает регистры обмена и вызывает их методы:
// мониторинг не имеет собственного состояния, которое могло бы соврать.

#Область ПрограммныйИнтерфейс

// Сообщения обмена по статусам за период: что ушло, что ждёт, что в ошибке.
Функция СообщенияПоСтатусам() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Очередь.Статус КАК Статус, КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ РегистрСведений.ОчередьОбмена КАК Очередь
	|СГРУППИРОВАТЬ ПО Очередь.Статус";

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Сообщения в ошибке с последней ошибкой — входная точка расследования.
Функция СообщенияСОшибками() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Очередь.ИдСообщения, Очередь.Система, Очередь.Операция,
	|	Очередь.Попыток, Очередь.ПоследняяОшибка, Очередь.ТелоСообщения
	|ИЗ РегистрСведений.ОчередьОбмена КАК Очередь
	|ГДЕ Очередь.Статус = &Ошибка";
	Запрос.УстановитьПараметр("Ошибка", "Ошибка");

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Повторная отправка сообщения оператором из мониторинга.
Процедура ПовторноОтправить(ИдСообщения) Экспорт

	РИХ_ОчередьОбмена.ПовторитьСообщение(ИдСообщения);

КонецПроцедуры

// «Что не обменено»: сообщения системы, не достигшие статуса
// «Отправлена», с причиной из их же состояния очереди.
Функция ЧтоНеОбменено(Система) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Очередь.ИдСообщения КАК Объект,
	|	Очередь.Статус + ВЫБОР КОГДА Очередь.ПоследняяОшибка = """"
	|		ТОГДА """" ИНАЧЕ: "": "" + Очередь.ПоследняяОшибка КОНЕЦ КАК Причина
	|ИЗ РегистрСведений.ОчередьОбмена КАК Очередь
	|ГДЕ Очередь.Система = &Система И Очередь.Статус <> &Отправлена";
	Запрос.УстановитьПараметр("Система", Система);
	Запрос.УстановитьПараметр("Отправлена", "Отправлена");

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти
