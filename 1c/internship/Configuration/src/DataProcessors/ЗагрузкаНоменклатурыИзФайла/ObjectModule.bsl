// Загрузка номенклатуры из CSV (task_44): явная транзакция.
// Загрузка и запись протокола — одно атомарное действие: ошибка на любой
// строке откатывает всё, частично загруженного справочника не существует.

Функция ЗагрузитьИзТекста(ТекстCsv) Экспорт

	Строки = РИХ_ОбщегоНазначения.РазобратьCsv(ТекстCsv, ";");
	Загружено = 0;

	НачатьТранзакцию();
	Попытка
		Для Каждого СтрокаФайла Из Строки Цикл
			Если СтрокаФайла.Количество() < 2 Тогда
				ВызватьИсключение "Битые строка файла загрузки";
			КонецЕсли;
			Элемент = Справочники.Номенклатура.СоздатьЭлемент();
			Элемент.Артикул = СтрокаФайла[0];
			Элемент.Наименование = СтрокаФайла[1];
			Элемент.Записать();
			Загружено = Загружено + 1;
		КонецЦикла;
		ЗаписатьПротоколЗагрузки(Загружено);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации("РИХ.Загрузка",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Загрузка откачена целиком: " + ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;

	Возврат Загружено;

КонецФункции

Процедура ЗаписатьПротоколЗагрузки(Количество)

	ЗаписьЖурналаРегистрации("РИХ.Загрузка",
		УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("Загружено позиций: %1", Количество));

КонецПроцедуры
