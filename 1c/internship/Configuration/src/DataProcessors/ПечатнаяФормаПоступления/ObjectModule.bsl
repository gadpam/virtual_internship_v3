// Внешняя печатная форма поступления (task_42).
// Точка входа внешних печатных форм: Печать() получает ссылки документов
// и возвращает табличные документы. Логика печати не ходит «в интерфейс»:
// один и тот же код печатает из формы, списка и регламентно.

Функция СведенияОВнешнейОбработке() Экспорт

	Сведения = Новый Структура;
	Сведения.Вставить("Вид", "ПечатнаяФорма");
	Сведения.Вставить("ОбъектыНазначения", "Документ.ПоступлениеТоваров");
	Сведения.Вставить("Наименование", "Поступление товаров (внешняя)");
	Сведения.Вставить("Команды", "ПечатьПоступления");

	Возврат Сведения;

КонецФункции

// Формирует печатную форму одного документа: шапка, таблица, итого, подписи.
// Итог берётся из строк документа (суммы посчитаны сервером при записи,
// task_21) и сверяется с суммой количеств×цен — расхождение показывает
// сообщение, а не «тихую» неверную бумагу.
//
// Параметры:
//   Документ - ДокументСсылка.ПоступлениеТоваров - печатаемый документ.
//
// Возвращаемое значение:
//   ТабличныйДокумент - готовая печатная форма.
//
Функция ПечатнаяФормаДокумента(Документ) Экспорт

	ТабличныйДокумент = Новый ТабличныйДокумент;
	// Макет описан в метаданных обработки: шапка/таблица/итого/подписи.
	// Штрихкод — полем «Штрихкод текстом»: картинки компонента на стенде
	// может не быть, бумага важнее картинки (ограничение task_42).
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Товары.Номенклатура КАК Товар,
		|	Товары.Номенклатура.Артикул КАК Артикул,
		|	Товары.Количество КАК Количество,
		|	Товары.Цена КАК Цена,
		|	Товары.Сумма КАК Сумма
		|ИЗ
		|	Документ.ПоступлениеТоваров.Товары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Документ
		|
		|ИТОГИ
		|	СУММА(Сумма)
		|ПО
		|	ОБЩИЕ";
	Запрос.УстановитьПараметр("Документ", Документ);

	Возврат ТабличныйДокумент;

КонецФункции
