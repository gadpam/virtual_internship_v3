// Модуль обработки «Подбор номенклатуры по свойствам» (task_24).
// Подбор — запрос к регистру соответствия: товар подходит, если для него
// заданы ВСЕ выбранные значения свойств (группировка + подсчёт совпадений).

// Возвращает товары, у которых заданы все переданные значения свойств.
//
// Параметры:
//   ОтборСвойств - Соответствие - ключ: свойство (ПВХ), значение: значение свойства.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонка Номенклатура.
//
Функция ПодобратьПоСвойствам(ОтборСвойств) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Соответствие.Номенклатура КАК Номенклатура,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Соответствие.Свойство) КАК СовпалоСвойств
		|ИЗ
		|	РегистрСведений.СоответствиеСвойствНоменклатуры КАК Соответствие
		|ГДЕ
		|	(Соответствие.Свойство, Соответствие.Значение) В (&ПарыСвойств)
		|
		|СГРУППИРОВАТЬ ПО
		|	Соответствие.Номенклатура
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Соответствие.Свойство) = &ЧислоСвойств";

	ПарыСвойств = Новый Массив;
	Для Каждого Пара Из ОтборСвойств Цикл
		ПараСтрокой = Новый Структура("Свойство,Значение", Пара.Ключ, Пара.Значение);
		ПарыСвойств.Добавить(ПараСтрокой);
	КонецЦикла;
	Запрос.УстановитьПараметр("ПарыСвойств", ПарыСвойств);
	Запрос.УстановитьПараметр("ЧислоСвойств", ОтборСвойств.Количество());

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции
