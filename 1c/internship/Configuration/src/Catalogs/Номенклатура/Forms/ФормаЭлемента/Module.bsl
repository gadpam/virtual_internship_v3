///////////////////////////////////////////////////////////////////////////////////////////////////////
// Форма элемента справочника Номенклатура (task_8)
//
// Тонкий клиентский слой: форма не хранит логику версионирования, а только
// показывает то, что вернул серверный модуль РИХ_Версионирование строкой.
// Правила: Docs/CodingStandard.md (форма — интерфейс, данные — на сервере).
//
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиКомандФормы

// Команда «История изменений»: показывает версии текущего элемента.
// Для ещё не записанного элемента истории нет — это честное состояние,
// а не ошибка: сначала запись, потом версии (подписка ПриЗаписи).
//
&НаКлиенте
Процедура ПоказатьИсториюИзменений(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Элемент ещё не записан: история появится после первой записи.");
		Возврат;
	КонецЕсли;

	ТекстИстории = ИсторияИзмененийНаСервере();
	Если ПустаяСтрока(ТекстИстории) Тогда
		Сообщить("Версий пока нет: элемент не изменялся после создания механизма истории.");
	Иначе
		Сообщить(ТекстИстории);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Серверный вызов из формы: история собирается серверным общим модулем
// одним пакетом и возвращается строкой (клиент не ходит в регистр сам).
//
// Возвращаемое значение:
//   Строка - версии элемента, по одной на строку.
//
&НаСервере
Функция ИсторияИзмененийНаСервере()

	Возврат РИХ_Версионирование.ИсторияИзмененийСтрокой(Объект.Ссылка);

КонецФункции

#КонецОбласти
